{
    "family": "the1-prod-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::894726850744:role/ecsTaskExecutionRole",
    "containerDefinitions": [
      {
        "name": "app",
        "image": "894726850744.dkr.ecr.us-west-2.amazonaws.com/the1-repo:prod",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80,
            "protocol": "tcp",
            "name": "app-80-tcp"
          }
        ],
        "environment": [],
        "mountPoints": [],
        "volumesFrom": [],
        "secrets": [
          {
            "name": "DB_URI",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:894726850744:secret:the1/prod/DB_URI-dAPzrg"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/the1",
            "awslogs-region": "us-west-2",
            "awslogs-stream-prefix": "ecs"
          },
          "secretOptions": []
        },
        "healthCheck": {
          "command": [
            "CMD-SHELL",
            "curl -f http://localhost/health || exit 1"
          ],
          "interval": 30,
          "timeout": 5,
          "retries": 3,
          "startPeriod": 10
        },
        "systemControls": []
      }
    ],
    "volumes": []
  }
  