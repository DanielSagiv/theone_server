        function buildCreateLocationPayload() {
            const type = document.getElementById('cl_type').value;
            const payload = {
                name: document.getElementById('cl_name').value.trim(),
                type
            };
            
            // Only add description if not empty
            const description = document.getElementById('cl_desc')?.value?.trim();
            if (description) payload.description = description;
            
            // Build address object with only non-empty fields
            const address = {};
            const address_line1 = document.getElementById('cl_address_line1').value.trim();
            const address_line2 = document.getElementById('cl_address_line2').value.trim();
            const city = document.getElementById('cl_city').value.trim();
            const state = document.getElementById('cl_state').value.trim();
            const postalCode = document.getElementById('cl_postalCode').value.trim();
            const country = document.getElementById('cl_country').value.trim();
            if (address_line1) address.line1 = address_line1;
            if (address_line2) address.line2 = address_line2;
            if (city) address.city = city;
            if (state) address.state = state;
            if (postalCode) address.postalCode = postalCode;
            if (country) address.country = country;
            if (Object.keys(address).length > 0) payload.address = address;
            
            // General media - include all from form
            const gmRows = Array.from(document.querySelectorAll('.cl_media_row'));
            const generalMedia = gmRows.map(r => {
                const url = r.querySelector('.cl_media_url').value.trim();
                if (!url) return null;
                return {
                    type: r.querySelector('.cl_media_type').value,
                    url: url,
                    caption: r.querySelector('.cl_media_caption').value.trim() || undefined
                };
            }).filter(m => m !== null);
            // In edit mode, preserve existing media if form is empty, otherwise use form data
            if (cl_isEditMode && cl_originalLocationData) {
                // If form has media, use it (includes both old and new)
                // If form is empty but original had media, preserve original
                if (generalMedia.length > 0) {
                    payload.media = generalMedia;
                } else if (cl_originalLocationData.media && Array.isArray(cl_originalLocationData.media) && cl_originalLocationData.media.length > 0) {
                    payload.media = cl_originalLocationData.media;
                }
            } else if (generalMedia.length > 0) {
                payload.media = generalMedia;
            }
            
            if (type === 'night_club' || type === 'day_club') {
                const attributes = {};
                const bottleService = document.getElementById('cl_bottle').value;
                if (bottleService === 'true' || bottleService === 'false') {
                    attributes.bottleService = bottleService === 'true';
                }
                const dressCode = document.getElementById('cl_dress').value.trim();
                if (dressCode) attributes.dressCode = dressCode;
                const capacity = parseInt(document.getElementById('cl_capacity').value || '0', 10);
                if (capacity > 0) attributes.capacity = capacity;
                if (Object.keys(attributes).length > 0) payload.attributes = attributes;
                
                // Seats
                const rows = Array.from(document.querySelectorAll('#cl_seats_tbody tr'));
                const formSeats = rows.map(r => {
                    const code = r.querySelector('.cl_seat_code').value.trim();
                    if (!code) return null;
                    const seat = {
                        code: code,
                        category: r.querySelector('.cl_seat_cat').value,
                        capacity: parseInt(r.querySelector('.cl_seat_cap').value || '0', 10),
                        minSpendUSD: parseFloat(r.querySelector('.cl_seat_min').value || '0')
                    };
                    // Add media if any
                    const mediaRows = Array.from(r.querySelectorAll('.cl_seat_media_row'));
                    const media = mediaRows.map(mr => {
                        const url = mr.querySelector('.cl_seat_media_url').value.trim();
                        if (!url) return null;
                        return {
                            type: mr.querySelector('.cl_seat_media_type').value,
                            url: url,
                            caption: mr.querySelector('.cl_seat_media_caption').value.trim() || undefined
                        };
                    }).filter(m => m !== null);
                    if (media.length > 0) seat.media = media;
                    return seat;
                }).filter(s => s !== null);
                
                // In edit mode, merge form data with existing seat properties
                if (cl_isEditMode && cl_originalLocationData && cl_originalLocationData.seats) {
                    const originalSeats = cl_originalLocationData.seats;
                    const seatsMap = new Map();
                    
                    // First, add all original seats to map (preserves seats not in form)
                    originalSeats.forEach(originalSeat => {
                        // Create a clean copy - don't include _id as Mongoose will match by position/array index
                        const cleanSeat = {
                            code: originalSeat.code || '',
                            label: originalSeat.label || '',
                            category: originalSeat.category || '',
                            section: originalSeat.section || '',
                            capacity: originalSeat.capacity || 0,
                            minSpendUSD: originalSeat.minSpendUSD || 0,
                            priceTier: originalSeat.priceTier || 1,
                            mapAnchor: originalSeat.mapAnchor || undefined,
                            polygon: originalSeat.polygon || [],
                            media: originalSeat.media || [],
                            sentiment: originalSeat.sentiment || []
                        };
                        // Remove undefined values to avoid validation issues
                        Object.keys(cleanSeat).forEach(key => {
                            if (cleanSeat[key] === undefined || cleanSeat[key] === null) {
                                delete cleanSeat[key];
                            }
                        });
                        seatsMap.set(originalSeat.code, cleanSeat);
                    });
                    
                    // Then, merge form seats with original data
                    formSeats.forEach(formSeat => {
                        const existingSeat = seatsMap.get(formSeat.code);
                        if (existingSeat) {
                            // Merge: update editable fields from form, preserve all other fields
                            seatsMap.set(formSeat.code, {
                                ...existingSeat, // Preserve all original properties
                                code: formSeat.code, // Update from form
                                category: formSeat.category,
                                capacity: formSeat.capacity,
                                minSpendUSD: formSeat.minSpendUSD,
                                // Only update media if form has media entries, otherwise preserve original
                                media: formSeat.media && formSeat.media.length > 0 ? formSeat.media : (existingSeat.media || [])
                            });
                        } else {
                            // New seat not in original data
                            seatsMap.set(formSeat.code, formSeat);
                        }
                    });
                    
                    payload.seats = Array.from(seatsMap.values());
                } else if (formSeats.length > 0) {
                    payload.seats = formSeats;
                }
            }
            
            if (type === 'restaurant') {
                const attributes = {};
                const cuisine = document.getElementById('cl_cuisine').value.trim();
                if (cuisine) {
                    // Split by comma and trim each item
                    attributes.cuisine = cuisine.split(',').map(c => c.trim()).filter(c => c.length > 0);
                }
                const priceLevel = parseInt(document.getElementById('cl_priceLevel').value || '0', 10);
                if (priceLevel > 0) attributes.priceLevel = priceLevel;
                const michelinStars = parseInt(document.getElementById('cl_michelinStars').value || '0', 10);
                if (michelinStars > 0) attributes.michelinStars = michelinStars;
                const privateDiningRooms = parseInt(document.getElementById('cl_privateDiningRooms').value || '0', 10);
                if (privateDiningRooms > 0) attributes.privateDiningRooms = privateDiningRooms;
                if (Object.keys(attributes).length > 0) payload.attributes = attributes;
                
                // Restaurant Sections (using seats array)
                const sectionRows = Array.from(document.querySelectorAll('#cl_restaurant_sections_tbody tr'));
                const sections = sectionRows.map(r => {
                    const code = r.querySelector('.cl_section_code').value.trim();
                    if (!code) return null;
                    const section = {
                        code: code,
                        label: r.querySelector('.cl_section_name').value.trim() || undefined,
                        description: r.querySelector('.cl_section_description').value.trim() || undefined
                    };
                    // Add media if any
                    const mediaRows = Array.from(r.querySelectorAll('.cl_section_media_row'));
                    const media = mediaRows.map(mr => {
                        const url = mr.querySelector('.cl_section_media_url').value.trim();
                        if (!url) return null;
                        return {
                            type: mr.querySelector('.cl_section_media_type').value,
                            url: url,
                            caption: mr.querySelector('.cl_section_media_caption').value.trim() || undefined
                        };
                    }).filter(m => m !== null);
                    if (media.length > 0) section.media = media;
                    return section;
                }).filter(s => s !== null);
                if (sections.length > 0) payload.seats = sections;
            }
            
            if (type === 'hotel') {
                const attributes = {};
                const stars = parseInt(document.getElementById('cl_stars').value || '0', 10);
                if (stars > 0) attributes.stars = stars;
                const brand = document.getElementById('cl_brand').value.trim();
                if (brand) attributes.brand = brand;
                const checkInTime = document.getElementById('cl_checkin').value.trim();
                if (checkInTime) attributes.checkInTime = checkInTime;
                const checkOutTime = document.getElementById('cl_checkout').value.trim();
                if (checkOutTime) attributes.checkOutTime = checkOutTime;
                if (Object.keys(attributes).length > 0) payload.attributes = attributes;
                
                // Units
                const rows = Array.from(document.querySelectorAll('#cl_units_tbody tr'));
                const units = rows.map(r => {
                    const code = r.querySelector('.cl_unit_code').value.trim();
                    if (!code) return null;
                    return {
                        code: code,
                        kind: r.querySelector('.cl_unit_kind').value,
                        beds: parseInt(r.querySelector('.cl_unit_beds').value || '0', 10),
                        occupancy: parseInt(r.querySelector('.cl_unit_occ').value || '1', 10),
                        minPriceUSD: parseFloat(r.querySelector('.cl_unit_min').value || '0')
                    };
                }).filter(u => u !== null);
                // In edit mode, preserve existing units if form is empty, otherwise use form data
                if (cl_isEditMode && cl_originalLocationData) {
                    if (units.length > 0) {
                        payload.units = units;
                    } else if (cl_originalLocationData.units && Array.isArray(cl_originalLocationData.units) && cl_originalLocationData.units.length > 0) {
                        payload.units = cl_originalLocationData.units;
                    }
                } else if (units.length > 0) {
                    payload.units = units;
                }
            }
            
            // Sentiment removed from create payload; managed post-creation
            
            return payload;
        }

