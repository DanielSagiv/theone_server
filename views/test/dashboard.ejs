        /** Seat category <option> HTML (must match Location.seats[].category enum) */
        const SEAT_CATEGORY_OPTIONS = <%- JSON.stringify(typeof seatCategoryOptions !== 'undefined' ? seatCategoryOptions : []) %>;
        function buildSeatCategorySelectHtml() {
            if (!Array.isArray(SEAT_CATEGORY_OPTIONS) || SEAT_CATEGORY_OPTIONS.length === 0) {
                return '<option value="dance_floor">Dance Floor</option>';
            }
            return SEAT_CATEGORY_OPTIONS.map(function (o) {
                const v = String(o.value || '').replace(/"/g, '&quot;');
                const lab = String(o.label || o.value || '').replace(/</g, '&lt;');
                return '<option value="' + v + '">' + lab + '</option>';
            }).join('');
        }

        /** Escape string for HTML attribute values in seat category picker markup */
        function escapeSeatCatAttr(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;');
        }

        /** Resolve display label for a persisted seat category value */
        function getSeatCategoryLabelByValue(value) {
            if (!value) return '';
            const match = (SEAT_CATEGORY_OPTIONS || []).find(function (o) {
                return o && o.value === value;
            });
            return match ? (match.label || match.value || '') : String(value);
        }

        /** Build searchable category picker markup (hidden value field keeps class cl_seat_cat) */
        function buildSeatCategoryPickerHtml(selectedValue) {
            const selected = selectedValue || '';
            const label = getSeatCategoryLabelByValue(selected);
            return (
                '<div class="cl-seat-cat-picker">' +
                    '<input type="hidden" class="cl_seat_cat" value="' + escapeSeatCatAttr(selected) + '" />' +
                    '<input type="text" class="cl_seat_cat_search" placeholder="Search category..." value="' + escapeSeatCatAttr(label) + '" autocomplete="off" />' +
                    '<div class="cl_seat_cat_menu" role="listbox"></div>' +
                '</div>'
            );
        }

        /** Wire search/filter UI for one seat category picker */
        function initSeatCategoryPicker(pickerEl) {
            if (!pickerEl || pickerEl.dataset.seatCatPickerInit === '1') return;
            pickerEl.dataset.seatCatPickerInit = '1';

            const hidden = pickerEl.querySelector('.cl_seat_cat');
            const search = pickerEl.querySelector('.cl_seat_cat_search');
            const menu = pickerEl.querySelector('.cl_seat_cat_menu');
            if (!hidden || !search || !menu) return;

            function positionMenu() {
                const rect = search.getBoundingClientRect();
                menu.style.left = rect.left + 'px';
                menu.style.top = (rect.bottom + 2) + 'px';
                menu.style.width = Math.max(rect.width, 200) + 'px';
            }

            function renderMenu(filterText) {
                const q = String(filterText || '').trim().toLowerCase();
                const items = (SEAT_CATEGORY_OPTIONS || []).filter(function (o) {
                    if (!o) return false;
                    if (!q) return true;
                    const label = String(o.label || '').toLowerCase();
                    const value = String(o.value || '').toLowerCase();
                    return label.indexOf(q) !== -1 || value.indexOf(q) !== -1;
                });

                if (!items.length) {
                    menu.innerHTML = '<div class="cl_seat_cat_empty">No matches</div>';
                    return;
                }

                menu.innerHTML = items.map(function (o) {
                    const v = escapeSeatCatAttr(o.value || '');
                    const lab = String(o.label || o.value || '').replace(/</g, '&lt;');
                    return '<button type="button" class="cl_seat_cat_option" data-value="' + v + '">' + lab + '</button>';
                }).join('');
            }

            function openMenu() {
                renderMenu(search.value);
                positionMenu();
                menu.style.display = 'block';
            }

            function closeMenu() {
                menu.style.display = 'none';
            }

            function selectValue(value, label) {
                hidden.value = value || '';
                search.value = label || getSeatCategoryLabelByValue(value);
                closeMenu();
            }

            search.addEventListener('focus', openMenu);
            search.addEventListener('input', openMenu);
            search.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeMenu();
                    search.value = getSeatCategoryLabelByValue(hidden.value);
                }
            });
            search.addEventListener('blur', function () {
                window.setTimeout(function () {
                    if (!pickerEl.contains(document.activeElement)) {
                        search.value = getSeatCategoryLabelByValue(hidden.value);
                        closeMenu();
                    }
                }, 150);
            });

            menu.addEventListener('mousedown', function (e) {
                e.preventDefault();
            });
            menu.addEventListener('click', function (e) {
                const btn = e.target.closest('.cl_seat_cat_option');
                if (!btn) return;
                selectValue(btn.getAttribute('data-value') || '', btn.textContent || '');
            });

            window.addEventListener('resize', function () {
                if (menu.style.display === 'block') positionMenu();
            });
            window.addEventListener('scroll', function () {
                if (menu.style.display === 'block') positionMenu();
            }, true);

            document.addEventListener('click', function (e) {
                if (!pickerEl.contains(e.target) && menu.style.display === 'block') {
                    search.value = getSeatCategoryLabelByValue(hidden.value);
                    closeMenu();
                }
            });
        }

        /** Set category picker value when editing an existing location seat row */
        function setSeatCategoryPickerValue(rowOrPicker, value) {
            const picker = rowOrPicker && rowOrPicker.classList && rowOrPicker.classList.contains('cl-seat-cat-picker')
                ? rowOrPicker
                : (rowOrPicker ? rowOrPicker.querySelector('.cl-seat-cat-picker') : null);
            if (!picker) return;
            initSeatCategoryPicker(picker);
            const hidden = picker.querySelector('.cl_seat_cat');
            const search = picker.querySelector('.cl_seat_cat_search');
            if (hidden) hidden.value = value || '';
            if (search) search.value = getSeatCategoryLabelByValue(value);
        }

