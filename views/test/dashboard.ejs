                            <label style="display: block; color: #cbd5f5; margin-bottom: 0.5rem; font-size: 0.9rem;">Filter by City (optional):</label>
                            <div style="display: flex; gap: 0.5rem;">
                                <select id="alternativeEventsCityFilter" style="flex: 1; padding: 0.5rem; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; color: #cbd5f5;">
                                    <option value="">Any City</option>
                                </select>
                                <button id="applyCityFilterBtn" style="padding: 0.5rem 1rem; background: rgba(59, 130, 246, 0.3); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.5); border-radius: 4px; cursor: pointer;">
                                    Apply Filter
                                </button>
                            </div>
                        </div>
                    `;
                }

                const eventsHtml = events.map(event => {
                    // Normalize event ID to string
                    const eventId = event._id?.toString() || event._id || event.id || '';
                    const eventDate = event.start_datetime 
                        ? new Date(event.start_datetime).toLocaleDateString()
                        : 'Date TBD';
                    const locationName = event.location?.name || 'Location TBD';
                    const priceRange = event.price_range 
                        ? `$${event.price_range.min.toLocaleString()} - $${event.price_range.max.toLocaleString()}`
                        : 'Price TBD';

                    return `
                        <div class="coe-alternative-event-card" 
                             data-event-id="${eventId}"
                             style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; cursor: pointer; transition: all 0.2s ease;">
                            <h4 style="color: #d4af37; margin: 0 0 0.5rem 0; font-size: 1.1rem;">${event.name || 'Untitled Event'}</h4>
                            <div style="color: #cbd5f5; font-size: 0.9rem; margin-bottom: 0.5rem;">
                                <div><strong>Date:</strong> ${eventDate}</div>
                                <div><strong>Location:</strong> ${locationName}</div>
                                <div><strong>Price Range:</strong> ${priceRange}</div>
                                <div><strong>Available Seats:</strong> ${event.available_seats_count || 0}</div>
                            </div>
                            <button class="coe-select-event-btn" 
                                    data-event-id="${eventId}"
                                    style="background: rgba(59, 130, 246, 0.3); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.5); padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; margin-top: 0.5rem;">
                                Select Event
                            </button>
                        </div>
                    `;
                }).join('');

                modal.innerHTML = `
                    <div class="coe-modal" style="background: #1e293b; border-radius: 8px; padding: 2rem; max-width: 600px; width: 100%; max-height: 80vh; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1);">
                        <h3 style="color: #fff; margin: 0 0 1rem 0; font-size: 1.2rem;">${title}</h3>
                        <p style="color: #cbd5f5; margin: 0 0 1.5rem 0; line-height: 1.6;">${message}</p>
                        ${cityFilterHtml || ''}
                        <div class="coe-alternative-events-list">
                            ${eventsHtml}
                        </div>
                        <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
                            <button class="coe-modal-cancel" style="background: rgba(100, 116, 139, 0.3); color: #cbd5f5; border: 1px solid rgba(100, 116, 139, 0.5); padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer;">
                                Cancel
                            </button>
                        </div>
                    </div>
