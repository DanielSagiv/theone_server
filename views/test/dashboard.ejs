        .bot-input-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .bot-disabled-hint {
    color: #94a3b8;
            font-size: 0.9rem;
        }

        .industry-energy {
            background: #fff8e1;
            color: #f9a825;
        }

        .industry-crypto {
            background: #f1f8e9;
            color: #558b2f;
        }

        .industry-banking {
            background: #e8eaf6;
            color: #3f51b5;
        }

        .industry-real-estate {
            background: #fafafa;
            color: #424242;
        }

        .industry-tech {
            background: #e0f7fa;
            color: #00acc1;
        }

        .status-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .status-option {
            background: none;
