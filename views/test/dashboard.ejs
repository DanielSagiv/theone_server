        /**
         * Open status update modal
         */
        function openStatusModal(userId, userName, currentStatus) {
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can update user status', 'error');
                return;
            }

            selectedUserId = userId;
            selectedUserName = userName;
            selectedStatus = null;

            document.getElementById('statusUserName').textContent = userName;
            document.getElementById('updateStatusBtn').disabled = true;

            // Clear previous selections
            document.querySelectorAll('.status-option').forEach(option => {
                option.classList.remove('selected');
            });

            document.getElementById('statusModal').style.display = 'flex';
        }

        /**
         * Select status in modal
         */
        function selectStatus(status) {
            selectedStatus = status;

            // Update UI
            document.querySelectorAll('.status-option').forEach(option => {
                option.classList.remove('selected');
            });
            document.querySelector(`[data-status="${status}"]`).classList.add('selected');
            document.getElementById('updateStatusBtn').disabled = false;
        }

        /**
         * Close status modal
         */
