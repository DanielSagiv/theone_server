        /**
         * Display location details in modal
         */
        function displayLocationDetails(location) {
            console.log('Displaying location details:', location);
            console.log('Location keys:', Object.keys(location || {}));
            
            // Basic info
            document.getElementById('locationName').textContent = location.name || '-';
            document.getElementById('locationType').textContent = location.type || '-';
            document.getElementById('locationDescription').textContent = location.description || '-';
            document.getElementById('locationScore').textContent = typeof location.score === 'number' ? location.score.toFixed(1) : '0.0';
            document.getElementById('locationStatus').textContent = location.status || '-';
            document.getElementById('locationGratuityPercent').textContent = formatLocationPercentLabel(location.gratuityPercent);
            document.getElementById('locationAdminFeePercent').textContent = formatLocationPercentLabel(location.adminFeePercent);
            document.getElementById('locationSalesTaxPercent').textContent = formatLocationPercentLabel(location.salesTaxPercent);
            
            // Address & Contact
            const address = location.address || {};
            
            // Build full address string
            const addressParts = [];
            if (address.line1) addressParts.push(address.line1);
            if (address.line2) addressParts.push(address.line2);
            if (address.city) addressParts.push(address.city);
            if (address.state) addressParts.push(address.state);
            if (address.postalCode) addressParts.push(address.postalCode);
            if (address.country) addressParts.push(address.country);
            
            const fullAddress = addressParts.length > 0 ? addressParts.join(', ') : '-';
            document.getElementById('locationAddress').textContent = fullAddress;
            document.getElementById('locationCity').textContent = address.city || '-';
            document.getElementById('locationState').textContent = address.state || '-';
            document.getElementById('locationPostalCode').textContent = address.postalCode || '-';
            document.getElementById('locationCountry').textContent = address.country || '-';
            
            const contact = location.contact || {};
            document.getElementById('locationContactPhone').textContent = contact.phone || '-';
            document.getElementById('locationContactEmail').textContent = contact.email || '-';
            document.getElementById('locationContactWebsite').textContent = contact.website || '-';
            
            // Attributes
            displayLocationAttributes(location.attributes || {}, location.type);
            
            // Sentiment
            displayLocationSentiment(location.sentiment || []);
            
            // Main Location Media
            displayMainLocationMedia(location.media || []);
            
            // Sub-entity media based on location type
            if (location.type === 'night_club' || location.type === 'day_club') {
                displaySeatingAreas(location.seats || []);
            } else if (location.type === 'restaurant') {
                displayRestaurantSections(location.seats || []);
            } else if (location.type === 'hotel') {
                displayRoomTypes(location.units || []);
            }
        }

        /**
         * Display location attributes
         */
        function displayLocationAttributes(attributes, locationType) {
            const attributesContainer = document.getElementById('locationAttributes');
            attributesContainer.innerHTML = '';
            
            // Define which attributes are relevant for each location type
            const typeSpecificAttributes = {
                'restaurant': ['cuisine', 'priceLevel', 'michelinStars', 'privateDiningRooms'],
                'night_club': ['bottleService', 'dressCode', 'capacity', 'musicGenres'],
                'day_club': ['bottleService', 'dressCode', 'capacity', 'musicGenres'],
                'hotel': ['stars', 'brand', 'checkInTime', 'checkOutTime', 'amenities']
            };
            
            // Common attributes that apply to all types
            const commonAttributes = ['capacity', 'priceLevel'];
            
            // Get relevant attributes for this location type
            const relevantAttributes = [
                ...commonAttributes,
                ...(typeSpecificAttributes[locationType] || [])
            ];
            
            Object.entries(attributes).forEach(([key, value]) => {
                // Only show attributes that are relevant for this location type
                if (relevantAttributes.includes(key) && value !== undefined && value !== null && value !== '') {
                    const attributeDiv = document.createElement('div');
                    attributeDiv.className = 'detail-item';
                    
                    // Handle special cases for better display
                    let displayValue = value;
                    if (key === 'cuisine' && Array.isArray(value)) {
                        displayValue = value.join(', ');
                    } else if (key === 'bottleService') {
                        displayValue = value ? 'Yes' : 'No';
                    } else if (key === 'priceLevel') {
                        displayValue = '$'.repeat(value);
                    } else if (key === 'michelinStars') {
                        displayValue = value + ' star' + (value !== 1 ? 's' : '');
                    } else if (key === 'musicGenres' && Array.isArray(value)) {
                        displayValue = value.join(', ');
                    } else if (key === 'amenities' && typeof value === 'object') {
                        const amenityList = Object.entries(value)
                            .filter(([_, enabled]) => enabled)
                            .map(([amenity, _]) => amenity.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()))
                            .join(', ');
                        displayValue = amenityList || 'None';
                    }
                    
                    attributeDiv.innerHTML = `
                        <label>${key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())}:</label>
                        <span>${displayValue}</span>
                    `;
                    attributesContainer.appendChild(attributeDiv);
                }
            });
        }

