                                         loading="lazy">
                                `).join('')}
                                ${remaining > 0 ? `
                                    <div class="location-item-more-images"
                                         onclick="openLightbox(${JSON.stringify(images[3] || images[0]).replace(/"/g, '&quot;')})"
                                         title="View all ${images.length} images">+${remaining}</div>
                                ` : ''}
                            </div>
                            <div class="event-location-caption">${matchingEvent.location.name || ''}</div>
                        `;
                    }

                            // Generate seat items for carousel
                            const seatItems = eventGroup.seats.map((seat, seatIndex) => {
                                // Debug: Log seat data including recommendation
                                if (seatIndex === 0) {
                                    console.log('[COE Card] Rendering seat:', {
                                        seat_code: seat.seat_code,
                                        hasAiRecommendation: !!(seat.ai_recommendation),
                                        aiRecommendation: seat.ai_recommendation,
                                        seatKeys: Object.keys(seat)
                                    });
                                }
                                
                                // Status badge with color
                                const statusClass = `coe-seat-status-${seat.status || 'selected'}`;
                                const statusLabel = (seat.status || 'selected').charAt(0).toUpperCase() + (seat.status || 'selected').slice(1);
                                
                                // Seat media thumbnails
                                const seatMedia = seat.media || [];
                                const imageMedia = seatMedia.filter(m => m && m.type === 'image');
                                
                                const seatMediaHtml = imageMedia.length > 0 ? `
                                    <div class="coe-seat-media">
                                        ${imageMedia.slice(0, 4).map(media => `
                                            <img src="${media.url}" 
                                                 alt="${media.caption || seat.seat_code || 'Seat image'}" 
                                                 class="coe-seat-media-thumbnail"
                                                 onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})"
                                                 loading="lazy">
                                        `).join('')}
                                        ${imageMedia.length > 4 ? `
                                            <div class="coe-seat-media-thumbnail" style="display:flex;align-items:center;justify-content:center;background:rgba(30,41,59,0.8);color:#cbd5f5;font-size:0.7rem;">
                                                +${imageMedia.length - 4}
                                            </div>
                                        ` : ''}
                                    </div>
                                ` : '<div class="coe-seat-media" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">No images available</div>';
                                
                                const totalCost = seat.event_price || seat.base_price || 0;
                                return `
                                    <div class="coe-seat-carousel-slide" data-seat-index="${seatIndex}">
                                        <div class="coe-seat-item">
