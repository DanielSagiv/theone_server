        /**
         * Format a location percentage field for display (0–100 → "n%" or "-").
         * @param {number|string|null|undefined} val
         * @returns {string}
         */
        function formatLocationPercentLabel(val) {
            if (val == null || val === '') return '-';
            const n = Number(val);
            if (!Number.isFinite(n)) return '-';
            return `${n}%`;
        }

