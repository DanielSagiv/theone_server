        // Locations API
        async function loadLocations() {
            const tbody = document.getElementById('locationsTableBody');
            tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;"><div class="loading"><div class="spinner"></div><p>Loading locations...</p></div></td></tr>';
            try {
                const result = await makeApiRequest('/locations');
                if (result.success && result.data) {
                    const list = Array.isArray(result.data) ? result.data : (result.data.data || []);
                    if (!list.length) {
                        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#7f8c8d;">No locations found</td></tr>';
                        return;
                    }
                    tbody.innerHTML = list.map(loc => `
                        <tr>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.name}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.type}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.address?.city || '-'}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.address?.country || '-'}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${typeof loc.score === 'number' ? loc.score.toFixed(1) : '0.0'}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.status}</td>
                            <td style="cursor: pointer;" onclick="viewLocationDetails('${loc._id}')">${loc.createdAt ? new Date(loc.createdAt).toLocaleDateString() : '-'}</td>
                            <td>
                                <button class="btn-icon btn-icon-edit" onclick="event.stopPropagation(); openEditLocationFromList('${loc._id}')" title="Edit Location">
                                    <svg class="icon" viewBox="0 0 24 24">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </button>
                                <button class="btn-icon btn-icon-delete" onclick="event.stopPropagation(); deleteLocation('${loc._id}', '${loc.name}')" title="Delete Location">
                                    <svg class="icon" viewBox="0 0 24 24">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#e74c3c;">Failed to load locations</td></tr>';
                }
            } catch (err) {
                console.error('Load locations error:', err);
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:20px;color:#e74c3c;">Error loading locations</td></tr>';
            }
        }

        /**
         * Import venues from GXN JSON file
         */
        async function importGXNVenues() {
            if (!confirm('Import all venues from gxn_res.json? This will create new Location records with seats/tables from GXN data.')) {
                return;
            }
            
            try {
                showAlert('Starting venue import from GXN...', 'info');
                
                const response = await makeApiRequest('/gxn/import/venues', 'POST', {});
                
                if (response.success) {
                    const summary = response.summary || {};
                    showAlert(`Import complete! ${summary.imported || 0} venues imported, ${summary.failed || 0} failed, ${summary.skipped || 0} skipped.`, 'success');
                    
                    // Display detailed results
                    let resultsHtml = `<h4 style="margin:12px 0 8px;">Import Results</h4>`;
                    resultsHtml += `<p><strong>Total processed:</strong> ${summary.total || 0}</p>`;
                    resultsHtml += `<p style="color:green;"><strong>Imported:</strong> ${summary.imported || 0}</p>`;
                    resultsHtml += `<p style="color:red;"><strong>Failed:</strong> ${summary.failed || 0}</p>`;
                    resultsHtml += `<p style="color:orange;"><strong>Skipped:</strong> ${summary.skipped || 0}</p>`;
                    
                    if (response.data?.success?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;">Successfully Imported:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.success.forEach(item => {
                            resultsHtml += `<li>${item.name} (${item.venueCode}) - ${item.seatsCreated || 0} seats - <a href="#" onclick="viewLocationDetails('${item.locationId}'); return false;">View</a></li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    if (response.data?.failed?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;color:red;">Failed:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.failed.forEach(item => {
                            resultsHtml += `<li>${item.venueCode}: ${item.error}</li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    if (response.data?.skipped?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;color:orange;">Skipped:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.skipped.forEach(item => {
                            resultsHtml += `<li>${item.venueCode}: ${item.reason}${item.locationId ? ' (existing: ' + item.locationId + ')' : ''}</li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    // Show in modal or alert
                    alert(resultsHtml.replace(/<[^>]*>/g, '')); // Simple alert for now
                    
                    // Reload locations table
                    await loadLocations();
                    
                } else {
                    showAlert('Import failed: ' + (response.error?.message || 'Unknown error'), 'error');
                }
                
            } catch (error) {
                console.error('Import error:', error);
                showAlert('Import error: ' + error.message, 'error');
            }
        }

        function openCreateLocation() {
            document.getElementById('createLocationModal').style.display = 'flex';
            // reset form
            cl_isEditMode = false; 
            cl_editLocationId = null;
            cl_originalLocationData = null;
