        // Avatar upload client helpers
        let hiddenFileInput = null;
        function ensureHiddenFileInput() {
            if (!hiddenFileInput) {
                hiddenFileInput = document.createElement('input');
                hiddenFileInput.type = 'file';
                hiddenFileInput.accept = 'image/*';
                hiddenFileInput.style.display = 'none';
                hiddenFileInput.addEventListener('change', handleAvatarSelected);
                document.body.appendChild(hiddenFileInput);
            }
        }

        function triggerAvatarUpload() {
            if (!currentUser) { showAlert('Please log in', 'error'); return; }
            ensureHiddenFileInput();
            hiddenFileInput.value = '';
            hiddenFileInput.click();
        }

        async function handleAvatarSelected(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) { showAlert('Please select an image file', 'error'); return; }

            try {
                const formData = new FormData();
                formData.append('avatar', file);

                const response = await fetch('/v1/users/profile/avatar', {
                    method: 'POST',
                    headers: currentToken ? { 'Authorization': `Bearer ${currentToken}` } : {},
                    body: formData,
                    cache: 'no-store'
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    const url = result.data?.avatarUrl;
                    if (url) {
                        currentUser.avatarUrl = url;
                        const avatarEl = document.querySelector('.user-avatar');
                        avatarEl.style.backgroundImage = `url('${url}')`;
                        avatarEl.style.backgroundSize = 'cover';
                        avatarEl.style.backgroundPosition = 'center';
                        const modal = document.getElementById('profileModal');
                        if (modal && modal.style.display === 'flex') {
                            displayProfileData(currentUser, 'Your Profile');
                        }
                        showAlert('Avatar updated', 'success');
                    } else {
                        showAlert('Upload succeeded but no URL returned', 'warn');
                    }
                } else {
                    showAlert(result?.error?.message || 'Failed to upload avatar', 'error');
                }
            } catch (err) {
                console.error('Avatar upload error:', err);
                showAlert('Error uploading avatar: ' + err.message, 'error');
            }
        }

