        /**
         * Populate attributes section
         */
        function el_populateAttributes(attributes) {
            const container = document.getElementById('el_attributes_container');
            container.innerHTML = '';
            
            // Get current location type
            const locationType = document.getElementById('el_type').value;
            
            // Add common attributes
            const commonAttrs = [
                { key: 'capacity', label: 'Capacity', type: 'number' },
                { key: 'priceLevel', label: 'Price Level (1-5)', type: 'number', min: 1, max: 5 }
            ];
            
            // Add restaurant-specific attributes
            if (locationType === 'restaurant') {
                const restaurantAttrs = [
                    { key: 'cuisine', label: 'Cuisine (comma-separated)', type: 'text' },
                    { key: 'michelinStars', label: 'Michelin Stars (0-3)', type: 'number', min: 0, max: 3 },
                    { key: 'privateDiningRooms', label: 'Private Dining Rooms', type: 'number', min: 0 }
                ];
                commonAttrs.push(...restaurantAttrs);
            }
            
            // Add club-specific attributes
            if (locationType === 'night_club' || locationType === 'day_club') {
                const clubAttrs = [
                    { key: 'bottleService', label: 'Bottle Service', type: 'select', options: [
                        { value: '', text: 'Select' },
                        { value: 'true', text: 'Yes' },
                        { value: 'false', text: 'No' }
                    ]},
                    { key: 'dressCode', label: 'Dress Code', type: 'text' }
                ];
                commonAttrs.push(...clubAttrs);
            }
            
            // Add hotel-specific attributes
            if (locationType === 'hotel') {
                const hotelAttrs = [
                    { key: 'stars', label: 'Stars (1-5)', type: 'number', min: 1, max: 5 },
                    { key: 'brand', label: 'Brand', type: 'text' },
                    { key: 'checkInTime', label: 'Check-in Time', type: 'text' },
                    { key: 'checkOutTime', label: 'Check-out Time', type: 'text' }
                ];
                commonAttrs.push(...hotelAttrs);
            }
            
            commonAttrs.forEach(attr => {
                const div = document.createElement('div');
                div.className = 'form-group';
                
                let inputHtml = '';
                if (attr.type === 'select' && attr.options) {
                    inputHtml = `
                        <select id="el_attr_${attr.key}">
                            ${attr.options.map(opt => 
                                `<option value="${opt.value}" ${attributes[attr.key] === opt.value ? 'selected' : ''}>${opt.text}</option>`
                            ).join('')}
                        </select>
                    `;
                } else {
                    let value = attributes[attr.key] || '';
                    if (attr.key === 'cuisine' && Array.isArray(value)) {
                        value = value.join(', ');
                    }
                    inputHtml = `
                        <input type="${attr.type}" id="el_attr_${attr.key}" 
                               ${attr.min ? `min="${attr.min}"` : ''} 
                               ${attr.max ? `max="${attr.max}"` : ''} 
                               value="${value}">
                    `;
                }
                
                div.innerHTML = `
                    <label for="el_attr_${attr.key}">${attr.label}</label>
                    ${inputHtml}
                `;
                container.appendChild(div);
            });
