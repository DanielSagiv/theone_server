        async function sendBotPrompt() {
            if (botLoading) return;

            const textarea = document.getElementById('botPromptInput');
            if (!textarea) return;

            const prompt = textarea.value.trim();
            if (!prompt) {
                showAlert('Please enter a prompt before sending.', 'warning');
                return;
            }

            const previousConversation = [...botConversation];
            const optimisticConversation = [
                ...botConversation,
                { role: 'user', content: prompt }
            ];

            textarea.value = '';
            renderBotMessages(optimisticConversation);
            setBotLoading(true);

            try {
                const response = await makeApiRequest('/bot/message', 'POST', { prompt });
                if (response.success && response.data?.success) {
                    renderBotMessages(response.data.data || []);
                } else {
                    renderBotMessages(previousConversation);
                    const errorMsg = response.data?.error?.message || response.data?.error || 'Bot failed to respond.';
                    showAlert(errorMsg, 'error');
                }
            } catch (error) {
                console.error('Error sending the1 prompt:', error);
                renderBotMessages(previousConversation);
                showAlert('Bot failed to respond.', 'error');
            } finally {
                setBotLoading(false);
            }
        }

        /**
         * Make API request with authentication
         */
        async function makeApiRequest(endpoint, method = 'GET', body = null) {
            const headers = {
                'Content-Type': 'application/json'
            };
            
            if (currentToken) {
                headers['Authorization'] = `Bearer ${currentToken}`;
            }

            const config = {
                method: method,
                headers: headers,
                cache: 'no-store'
            };

            if (body) {
                config.body = JSON.stringify(body);
            }

            // Cache-busting for GET requests
            let finalEndpoint = endpoint;
            if (method === 'GET') {
                const ts = Date.now();
                finalEndpoint += (endpoint.includes('?') ? '&' : '?') + `_=${ts}`;
                headers['Cache-Control'] = 'no-cache';
            }

            console.log('Making API request:', { endpoint: `/v1${finalEndpoint}`, method, headers });

            try {
                const response = await fetch(`/v1${finalEndpoint}`, config);
                const data = await response.json();
                console.log('API response:', { status: response.status, data });
                return { success: response.ok, data, status: response.status };
            } catch (error) {
                console.error('API request error:', error);
                return { success: false, data: { error: error.message }, status: 0 };
            }
        }

        /**
         * Admin Tools: CLEAN selected collection (requires tools password on server).
         */
        async function executeToolsClean() {
            if (currentUser?.role !== 'admin') {
                showAlert('Tools are available to administrators only.', 'error');
                return;
            }
            const collectionEl = document.getElementById('toolsCleanCollection');
            const passwordEl = document.getElementById('toolsPassword');
            const collection = collectionEl ? collectionEl.value : '';
            const toolsPassword = passwordEl ? passwordEl.value : '';
            if (!collection) {
                showAlert('Select a collection from the list.', 'error');
                return;
            }
            if (!toolsPassword) {
                showAlert('Enter the tools password.', 'error');
                return;
            }
            const opt = collectionEl && collectionEl.options[collectionEl.selectedIndex];
            const label = opt ? opt.textContent : collection;
            const confirmMsg = collection === 'all'
                ? 'CLEAN ALL will permanently remove data from EVERY tools collection (in order: botconversations, messages, notifications, payments, coes).\n\nCOEs use per-item delete (releases seats). This cannot be undone. Continue?'
                : ('CLEAN will permanently remove data for: ' + label + '\n\nThis cannot be undone. Continue?');
            if (!confirm(confirmMsg)) {
                return;
            }
            showAlert(collection === 'all' ? 'Running CLEAN ALL (this may take a while)...' : 'Running CLEAN...', 'info');
            const result = await makeApiRequest('/admin/tools/clean', 'POST', { toolsPassword, collection });
            const payload = result.data || {};
            const pre = document.getElementById('toolsCleanResult');
            if (result.success && payload.success) {
                let msg = payload.message || 'CLEAN completed.';
                if (payload.failedCount > 0) {
                    msg += ' Some items failed (see details below).';
                }
                if (payload.all && Array.isArray(payload.results)) {
                    const anyCoeFails = payload.results.some(function (r) {
                        return r.collection === 'coes' && r.failedCount > 0;
                    });
                    if (anyCoeFails) {
                        msg += ' Some COEs could not be deleted (see results).';
                    }
                }
                const alertType = (payload.failedCount > 0 || (payload.all && payload.success === false)) ? 'error' : 'success';
                showAlert(msg, alertType);
                if (pre) {
                    pre.style.display = 'block';
                    pre.textContent = JSON.stringify(payload, null, 2);
                }
                if ((collection === 'coes' || collection === 'all') && typeof loadCOEs === 'function') {
                    loadCOEs();
                }
            } else {
                showAlert(payload.message || payload.error || 'CLEAN failed', 'error');
                if (pre) {
                    pre.style.display = 'block';
                    pre.textContent = JSON.stringify(payload, null, 2);
                }
            }
        }

