    <script>
        let currentToken = null;
        let currentUser = null;
        let currentUserInitials = '';
        let currentUserAvatarUrl = '';
        let botConversation = [];
        let botLoading = false;

        // Check for existing session on page load
        window.onload = function() {
            checkExistingSession();
            setupNavigation();
            
            // Ensure openCreateCOE button works (backup event listener)
            setTimeout(() => {
                const createCOEButton = document.querySelector('button[onclick*="openCreateCOE"]');
                if (createCOEButton) {
                    console.log('[INIT] Found Create COE button, adding event listener backup');
                    createCOEButton.addEventListener('click', function(e) {
                        console.log('[INIT] Create COE button clicked via event listener');
                        if (typeof window.openCreateCOE === 'function') {
                            window.openCreateCOE();
                        } else {
                            console.error('[INIT] window.openCreateCOE is not a function!', typeof window.openCreateCOE);
                        }
                    });
                } else {
                    console.warn('[INIT] Create COE button not found');
                }
            }, 500);
        };

        /**
         * Check if user has existing session from login
         */
        function checkExistingSession() {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');
            const user = urlParams.get('user');
            
            if (token && user) {
                currentToken = token;
                currentUser = JSON.parse(decodeURIComponent(user));
                displayUserInfo();
                setupRoleBasedNavigation();
                loadUsers();
            } else {
                showAlert('No session found. Please login first.', 'error');
                setTimeout(() => {
                    window.location.href = '/test/login';
                }, 2000);
            }
        }

        /**
         * Display user information in the UI
         */
        function displayUserInfo() {
            if (currentUser) {
                // Update avatar initials
                const initials = (currentUser.firstName?.[0] || '') + (currentUser.lastName?.[0] || '');
                const avatarInitialsEl = document.getElementById('avatarInitials');
                currentUserInitials = initials.toUpperCase();
                avatarInitialsEl.textContent = currentUserInitials;
                
                // Update dropdown info
                document.getElementById('dropdownName').textContent = `${currentUser.firstName} ${currentUser.lastName}`;
                document.getElementById('dropdownEmail').textContent = currentUser.email;
                document.getElementById('dropdownRole').textContent = currentUser.role;
                
                // Update bot user role display
                const botUserRoleText = document.getElementById('botUserRoleText');
                if (botUserRoleText && currentUser.role) {
                    botUserRoleText.textContent = currentUser.role;
                }
                
                // Update avatar image if available (use inner .avatar-img)
                // IMPORTANT: Set currentUserAvatarUrl BEFORE updating header avatars
                if (currentUser.avatarUrl) {
                    currentUserAvatarUrl = currentUser.avatarUrl;
                    const avatarImgEl = document.querySelector('.user-avatar .avatar-img');
                    if (avatarImgEl) {
                        avatarImgEl.style.backgroundImage = `url('${currentUser.avatarUrl}')`;
                        avatarImgEl.style.backgroundSize = 'cover';
                        avatarImgEl.style.backgroundPosition = 'center';
                        avatarImgEl.style.color = 'transparent';
                    }
                } else {
                    currentUserAvatarUrl = '';
                }
                
                // Update header avatars - show actual user image
                // This runs AFTER currentUserAvatarUrl is set
                const botHeaderUserInitials = document.getElementById('botHeaderUserInitials');
                const botHeaderUserAvatar = document.getElementById('botHeaderUserAvatar');
                if (botHeaderUserInitials) {
                    botHeaderUserInitials.textContent = currentUserInitials;
                }
                // Always try to show user image if available
                if (botHeaderUserAvatar) {
                    if (currentUserAvatarUrl) {
                        // Show user image
                        botHeaderUserAvatar.style.backgroundImage = `url('${currentUserAvatarUrl}')`;
                        botHeaderUserAvatar.style.backgroundSize = 'cover';
                        botHeaderUserAvatar.style.backgroundPosition = 'center';
                        botHeaderUserAvatar.style.backgroundRepeat = 'no-repeat';
                        if (botHeaderUserInitials) {
                            botHeaderUserInitials.style.display = 'none';
                        }
                    } else {
                        // Show initials if no image
                        botHeaderUserAvatar.style.backgroundImage = 'none';
                        if (botHeaderUserInitials) {
                            botHeaderUserInitials.style.display = 'flex';
                        }
                    }
                }
            }
        }

        /**
         * Setup role-based navigation
         */
        function setupRoleBasedNavigation() {
            const usersNav = document.getElementById('usersNav');
            
            // Show users and Tools only for admin users
            const toolsNav = document.getElementById('toolsNav');
            if (currentUser && currentUser.role === 'admin') {
                usersNav.style.display = 'block';
                if (toolsNav) toolsNav.style.display = 'block';
            } else {
                usersNav.style.display = 'none';
                if (toolsNav) toolsNav.style.display = 'none';
                // If user is not admin and users section is active, switch to locations
                const activeNav = document.querySelector('.nav-item.active');
                if (activeNav && activeNav.dataset.section === 'users') {
                    switchSection('locations');
                }
                if (activeNav && activeNav.dataset.section === 'tools') {
                    switchSection('locations');
                }
            }
        }

        /**
         * Setup navigation event listeners
         */
        function setupNavigation() {
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const section = this.dataset.section;
                    switchSection(section);
                });
            });
        }

        /**
         * Switch between content sections
         */
        function switchSection(sectionName) {
            if (sectionName === 'tools' && currentUser?.role !== 'admin') {
                switchSection('locations');
                return;
            }

            const navTarget = document.querySelector(`[data-section="${sectionName}"]`);
            if (!navTarget) {
                console.warn('switchSection: unknown section', sectionName);
                return;
            }

            // Update active nav item
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            navTarget.classList.add('active');

            // Update active content section
            const sectionEl = document.getElementById(`${sectionName}Section`);
            if (!sectionEl) {
                console.warn('switchSection: missing content section', sectionName);
                return;
            }
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });
            sectionEl.classList.add('active');

            // Reset scroll so short sections (e.g. Tools) are not stuck below prior long-page scroll position
            const contentAreaEl = document.querySelector('.content-area');
            if (contentAreaEl) {
                contentAreaEl.scrollTop = 0;
            }

            // Load section-specific data
            if (sectionName === 'users' && currentUser?.role === 'admin') {
                loadUsers();
            }
            if (sectionName === 'locations' && currentUser?.role === 'admin') {
                loadLocations();
            }
            if (sectionName === 'events' && currentUser?.role === 'admin') {
                loadEvents();
            }
            if (sectionName === 'coes') {
                loadCOEs();
            }
            if (sectionName === 'payments') {
                loadPaymentsSection();
            }
            if (sectionName === 'bot') {
                loadBotConversation();
            }
            if (sectionName === 'tools' && currentUser?.role === 'admin') {
                const pre = document.getElementById('toolsCleanResult');
                if (pre) {
                    pre.style.display = 'none';
                    pre.textContent = '';
                }
            }
        }

        /**
         * Toggle user dropdown
         */
        function toggleUserDropdown() {
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('userDropdown');
            const avatar = document.querySelector('.user-avatar');
            if (!avatar.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        /**
         * Load users for admin
         */
        async function loadUsers() {
            if (currentUser?.role !== 'admin') {
                console.log('User is not admin, cannot load users');
                return;
            }

            console.log('Loading users...', { currentToken: currentToken ? 'present' : 'missing', userRole: currentUser?.role });

            const tableBody = document.getElementById('usersTableBody');
            
            // Show loading state
            tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px;"><div class="loading"><div class="spinner"></div><p>Loading users...</p></div></td></tr>';

            try {
                const result = await makeApiRequest('/users');
                console.log('Users API response:', result);
                console.log('Response details:', {
                    success: result.success,
                    dataType: typeof result.data,
                    isArray: Array.isArray(result.data),
                    dataLength: result.data?.length,
                    dataKeys: result.data ? Object.keys(result.data) : 'no data'
                });
                
                if (result.success && result.data) {
                    // Check if data is an array directly
                    if (Array.isArray(result.data)) {
                        displayUsersTable(result.data);
                        showAlert('Users loaded successfully!', 'success');
                    } 
                    // Check if data has a users property
                    else if (result.data.users && Array.isArray(result.data.users)) {
                        displayUsersTable(result.data.users);
                        showAlert('Users loaded successfully!', 'success');
                    }
                    // Check if data has a data property (nested)
                    else if (result.data.data && Array.isArray(result.data.data)) {
                        displayUsersTable(result.data.data);
                        showAlert('Users loaded successfully!', 'success');
                    }
                    else {
                        const errorMsg = 'Invalid data format: ' + JSON.stringify(result.data);
                        tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Failed to load users: ' + errorMsg + '</td></tr>';
                        showAlert('Failed to load users: ' + errorMsg, 'error');
                    }
                } else {
                    const errorMsg = result.data?.message || result.data?.error?.message || 'Unknown error';
                    tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Failed to load users: ' + errorMsg + '</td></tr>';
                    showAlert('Failed to load users: ' + errorMsg, 'error');
                }
            } catch (error) {
                console.error('Error loading users:', error);
                tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Error loading users: ' + error.message + '</td></tr>';
                showAlert('Error loading users: ' + error.message, 'error');
            }
        }

