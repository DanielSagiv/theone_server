        /**
         * Load cities into select dropdown
         * @param {HTMLElement} selectElement - The select element to populate
         */
        async function loadCitiesIntoSelect(selectElement) {
            try {
                console.log('Loading cities into dropdown...');
                const result = await makeApiRequest('/locations/cities');
                console.log('Cities API response:', result);
                
                // makeApiRequest returns { success, data: { success, data: [...], ... } }
                const cities = result.success && result.data?.success ? result.data.data : null;
                
                if (cities && Array.isArray(cities)) {
                    console.log(`Found ${cities.length} cities:`, cities);
                    
                    // Clear existing options except the first placeholder
                    const placeholder = selectElement.querySelector('option[value=""]');
                    selectElement.innerHTML = '';
                    if (placeholder) {
                        selectElement.appendChild(placeholder);
                    }
                    
                    // Add city options
                    if (cities.length > 0) {
                        cities.forEach(city => {
                            const option = document.createElement('option');
                            option.value = city;
                            option.textContent = city;
                            selectElement.appendChild(option);
                        });
                        console.log('Cities populated in dropdown');
                    } else {
                        console.warn('No cities found in response');
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No cities available';
                        option.disabled = true;
                        selectElement.appendChild(option);
                    }
                } else {
                    console.error('Failed to load cities - invalid response:', result);
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Error loading cities';
                    option.disabled = true;
                    selectElement.appendChild(option);
                }
            } catch (error) {
                console.error('Error loading cities:', error);
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'Error loading cities';
                option.disabled = true;
                selectElement.appendChild(option);
            }
        }

        /**
         * Render Location list
         */
        function renderLocationList(locations) {
            const container = document.createElement('div');
            container.className = 'bot-structured-card bot-location-list';

            if (locations.length === 0) {
                container.innerHTML = '<p class="bot-empty-message">No locations found.</p>';
                return container;
            }

            const locationsHtml = locations.map(location => {
                // Format location type for display
                const typeLabels = {
                    'night_club': 'Night Club',
                    'day_club': 'Day Club',
                    'restaurant': 'Restaurant',
                    'hotel': 'Hotel'
                };
                const typeLabel = typeLabels[location.type] || location.type || 'Location';
                
                // Extract and sort images from media
                const images = (location.media || [])
                    .filter(item => item.type === 'image')
                    .sort((a, b) => (a.order || 0) - (b.order || 0));
                
                const heroImage = images.length > 0 ? images[0] : null;
                const thumbnailImages = images.length > 1 ? images.slice(1, 4) : []; // Show up to 3 thumbnails
                const remainingCount = images.length > 4 ? images.length - 4 : 0;
                
                // Format address
                let addressText = 'Address TBD';
                if (location.address) {
                    const addr = location.address;
                    const parts = [];
                    if (addr.line1) parts.push(addr.line1);
                    if (addr.line2) parts.push(addr.line2);
                    if (addr.city) parts.push(addr.city);
                    if (addr.state) parts.push(addr.state);
                    if (addr.postalCode) parts.push(addr.postalCode);
                    if (addr.country) parts.push(addr.country);
                    if (parts.length > 0) {
                        addressText = parts.join(', ');
                    }
                }
                
                // Create map link from geo coordinates
                let mapLink = null;
                if (location.geo && location.geo.coordinates && location.geo.coordinates.length >= 2) {
                    const [longitude, latitude] = location.geo.coordinates;
                    mapLink = `https://www.google.com/maps?q=${latitude},${longitude}`;
                }
                
                // Generate hero image HTML
                const heroImageHtml = heroImage ? `
                    <img src="${heroImage.url}" 
                         alt="${heroImage.caption || location.name || 'Location image'}" 
                         class="location-item-hero-image"
                         onclick="openLightbox(${JSON.stringify(heroImage).replace(/"/g, '&quot;')})"
                         loading="lazy">
                ` : '';
                
                // Generate thumbnail gallery HTML
                const thumbnailGalleryHtml = thumbnailImages.length > 0 || remainingCount > 0 ? `
                    <div class="location-item-image-gallery">
                        ${thumbnailImages.map(img => `
                            <img src="${img.url}" 
                                 alt="${img.caption || 'Location image'}" 
                                 class="location-item-thumbnail"
                                 onclick="openLightbox(${JSON.stringify(img).replace(/"/g, '&quot;')})"
                                 loading="lazy">
                        `).join('')}
                        ${remainingCount > 0 ? `
                            <div class="location-item-more-images" 
                                 onclick="openLightbox(${JSON.stringify(images[4] || images[1] || images[0]).replace(/"/g, '&quot;')})"
                                 title="View all ${images.length} images">
                                +${remainingCount}
                            </div>
                        ` : ''}
                    </div>
                ` : '';
                
                // Generate seats accordion HTML
                const seatsHtml = location.seats && location.seats.length > 0 ? (() => {
                    // Group seats by category
                    const seatsByCategory = {};
                    location.seats.forEach(seat => {
                        const category = seat.category || 'Other';
                        if (!seatsByCategory[category]) {
                            seatsByCategory[category] = [];
                        }
                        seatsByCategory[category].push(seat);
                    });
                    
                    const categoryHtml = Object.entries(seatsByCategory).map(([category, seatsInCategory]) => {
                        const categoryLabel = category.replace(/_/g, ' ').toUpperCase();
                        
                        const seatItemsHtml = seatsInCategory.map(seat => {
                            // Generate seat media thumbnails
                            const seatMediaHtml = (seat.media || []).length > 0 ? `
                                <div class="location-seat-media">
                                    ${seat.media.slice(0, 4).map(media => `
                                        <img src="${media.url}" 
                                             alt="${media.caption || seat.code || 'Seat image'}" 
                                             class="location-seat-media-thumbnail"
                                             onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})"
                                             loading="lazy">
                                    `).join('')}
                                    ${seat.media.length > 4 ? `<div class="location-seat-media-thumbnail" style="display:flex;align-items:center;justify-content:center;background:rgba(30,41,59,0.8);color:#cbd5f5;font-size:0.7rem;">+${seat.media.length - 4}</div>` : ''}
                                </div>
                            ` : '';
                            
                            // Generate seat sentiment
                            const sentimentHtml = (seat.sentiment || []).length > 0 ? `
