                const resp = await fetch('/v1/locations/media/upload', { method: 'POST', headers: currentToken ? { 'Authorization': `Bearer ${currentToken}` } : {}, body: form, cache: 'no-store' });
                const result = await resp.json();
                console.log('General media upload response:', result);
                if (resp.ok && result.success && result.data?.url) {
                    addGeneralMediaRow();
                    const lastRow = document.querySelector('#cl_media_list .cl_media_row:last-child');
                    lastRow.querySelector('.cl_media_url').value = result.data.url;
                    // Set the correct media type from the upload response
                    console.log('Setting media type to:', result.data.type);
                    lastRow.querySelector('.cl_media_type').value = result.data.type;
                    console.log('Media type set to:', lastRow.querySelector('.cl_media_type').value);
                    showAlert('Media uploaded', 'success');
                } else {
                    showAlert(result?.error?.message || 'Upload failed', 'error');
                }
            } catch (err) {
                console.error('General media upload error:', err);
                showAlert('Upload error: ' + err.message, 'error');
            }
        }
