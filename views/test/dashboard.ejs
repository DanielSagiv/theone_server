        async function openEditLocationFromList(locationId) {
            console.log('openEditLocationFromList called with locationId:', locationId);
            // Visual debugging
            showAlert('Opening edit for location: ' + locationId, 'info');
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can edit locations', 'error');
                return;
            }
            try {
                const result = await makeApiRequest(`/locations/${locationId}`);
                if (!result.success) {
                    showAlert('Failed to load location', 'error');
                    return;
                }
                const loc = result.data.data || result.data;
                console.log('Setting edit mode flags:', { locationId, loc });
                cl_isEditMode = true;
                cl_editLocationId = locationId;
                cl_originalLocationData = loc; // Store original data for preserving arrays
                console.log('Edit mode flags set:', { cl_isEditMode, cl_editLocationId });
                // Visual confirmation
                showAlert('Edit mode activated for: ' + loc.name, 'success');
                // Open modal
                document.getElementById('createLocationModal').style.display = 'flex';
                // Set header and primary button text
                document.querySelector('#createLocationModal .modal-header h2').textContent = 'Edit Location';
                // Populate fields
                document.getElementById('cl_name').value = loc.name || '';
                document.getElementById('cl_type').value = loc.type || 'night_club';
                document.getElementById('cl_address_line1').value = loc.address?.line1 || '';
                document.getElementById('cl_address_line2').value = loc.address?.line2 || '';
                document.getElementById('cl_city').value = loc.address?.city || '';
                document.getElementById('cl_state').value = loc.address?.state || '';
                document.getElementById('cl_postalCode').value = loc.address?.postalCode || '';
                document.getElementById('cl_country').value = loc.address?.country || '';
                // Ensure type-specific sections visible
                onClTypeChange();
                // Attributes
                document.getElementById('cl_desc').value = loc.description || '';
                if (loc.type === 'night_club' || loc.type === 'day_club') {
                    if (typeof loc.attributes?.bottleService === 'boolean') {
                        document.getElementById('cl_bottle').value = String(loc.attributes.bottleService);
                    }
                    document.getElementById('cl_dress').value = loc.attributes?.dressCode || '';
                    document.getElementById('cl_capacity').value = loc.attributes?.capacity || '';
                } else if (loc.type === 'restaurant') {
                    document.getElementById('cl_cuisine').value = loc.attributes?.cuisine?.join(', ') || '';
                    document.getElementById('cl_priceLevel').value = loc.attributes?.priceLevel || '';
                    document.getElementById('cl_michelinStars').value = loc.attributes?.michelinStars || '';
                    document.getElementById('cl_privateDiningRooms').value = loc.attributes?.privateDiningRooms || '';
                } else if (loc.type === 'hotel') {
                    document.getElementById('cl_stars').value = loc.attributes?.stars || '';
                    document.getElementById('cl_brand').value = loc.attributes?.brand || '';
                    document.getElementById('cl_checkin').value = loc.attributes?.checkInTime || '';
                    document.getElementById('cl_checkout').value = loc.attributes?.checkOutTime || '';
                }
                
                // Populate existing general media
                document.getElementById('cl_media_list').innerHTML = '';
                if (loc.media && Array.isArray(loc.media)) {
                    loc.media.forEach(mediaItem => {
                        addGeneralMediaRow();
                        const lastRow = document.querySelector('#cl_media_list .cl_media_row:last-child');
                        if (lastRow) {
                            lastRow.querySelector('.cl_media_type').value = mediaItem.type || 'image';
                            lastRow.querySelector('.cl_media_url').value = mediaItem.url || '';
                            lastRow.querySelector('.cl_media_caption').value = mediaItem.caption || '';
                        }
                    });
                }
                
                // Inventory: clear and populate
                document.getElementById('cl_seats_tbody').innerHTML = '';
                (loc.seats || []).forEach(seat => {
                    addSeatRow();
                    const row = document.querySelector('#cl_seats_tbody tr:last-child');
                    if (row) {
                        row.querySelector('.cl_seat_code').value = seat.code || '';
                        const categorySelect = row.querySelector('.cl_seat_cat');
                        if (categorySelect && seat.category) {
                            categorySelect.value = seat.category;
                        }
                        const capacityInput = row.querySelector('.cl_seat_cap');
                        if (capacityInput) {
                            capacityInput.value = seat.capacity || '';
                        }
                        const minInput = row.querySelector('.cl_seat_min');
                        if (minInput) {
                            minInput.value = seat.minSpendUSD || '';
                        }
                        // Note: Seat media can be added separately through the seat row interface
                        // If seat has existing media, it should be preserved in the merge logic
                    }
                });
                document.getElementById('cl_units_tbody').innerHTML = '';
                (loc.units || []).forEach(unit => {
                    addUnitRow();
                    const row = document.querySelector('#cl_units_tbody tr:last-child');
                    row.querySelector('.cl_unit_code').value = unit.code || '';
                    row.querySelector('.cl_unit_kind').value = unit.kind || '';
                    row.querySelector('.cl_unit_beds').value = unit.beds || '';
                    row.querySelector('.cl_unit_occ').value = unit.occupancy || '';
                    row.querySelector('.cl_unit_min').value = unit.minPriceUSD || '';
                });
                // Start at step 1
                setClStep(1);
            } catch (e) {
                console.error('openEditLocationFromList error:', e);
                showAlert('Error opening edit: ' + e.message, 'error');
            }
        }

