        /**
         * Submit create COE
         */
        async function submitCreateCOE() {
            try {
                const isEditMode = window.coeEditMode && window.currentEditingCOEId;
                showAlert(isEditMode ? 'Updating COE...' : 'Creating COE...', 'info');

                // Check if form elements exist
                const nameEl = document.getElementById('coec_name');
                const descEl = document.getElementById('coec_description');
                const clientEl = document.getElementById('coec_client_id');
                const startDateEl = document.getElementById('coec_start_date');
                const endDateEl = document.getElementById('coec_end_date');
                
                console.log('Form elements found:', {
                    nameEl: !!nameEl,
                    descEl: !!descEl,
                    clientEl: !!clientEl,
                    startDateEl: !!startDateEl,
                    endDateEl: !!endDateEl
                });

                // Validate required fields
                const name = nameEl ? nameEl.value.trim() : '';
                const description = descEl ? descEl.value.trim() : '';
                const clientId = clientEl ? clientEl.value : '';
                const startDate = startDateEl ? startDateEl.value : '';
                const endDate = endDateEl ? endDateEl.value : '';
                
                console.log('Form validation:', { 
                    name, 
                    description, 
                    clientId, 
                    startDate, 
                    endDate,
                    currentUserId: currentUser?._id,
                    currentUser: currentUser,
                    eventsCount: coecSelectedEvents.length, 
                    seatsCount: coecSelectedSeats.length 
                });
                
                if (!name) {
                    showAlert('Please enter a COE name', 'error');
                    return;
                }
                
                if (!description) {
                    showAlert('Please enter a COE description', 'error');
                    return;
                }
                
                if (!clientId) {
                    showAlert('Please select a client', 'error');
                    return;
                }
                
                if (!startDate) {
                    showAlert('Please select a start date', 'error');
                    return;
                }
                
                if (!endDate) {
                    showAlert('Please select an end date', 'error');
                    return;
                }
                
                if (coecSelectedEvents.length === 0) {
                    showAlert('Please select at least one event', 'error');
                    return;
                }
                
                if (!currentUser || !currentUser._id) {
                    showAlert('User session expired. Please log in again.', 'error');
                    return;
                }

                // Prepare COE data
                const coeData = {
                    name: document.getElementById('coec_name').value.trim(),
                    description: document.getElementById('coec_description').value.trim(),
                    client_id: document.getElementById('coec_client_id').value,
                    admin_id: currentUser._id,
                    start_date: document.getElementById('coec_start_date').value,
                    end_date: document.getElementById('coec_end_date').value,
                    currency: document.getElementById('coec_currency').value,
                    policies: document.getElementById('coec_policies').value.trim(),
                    notes: document.getElementById('coec_notes').value.trim(),
                    events: coecSelectedEvents.map((event, index) => ({
                        event_id: event._id.toString(),
                        event_date: new Date(event.start_datetime).toISOString().split('T')[0],
                        event_time: new Date(event.start_datetime).toTimeString().split(' ')[0],
                        base_price: event.base_price || 0,
                        quantity: 1,
                        total_price: event.base_price || 0,
                        sequence: index + 1
                    })),
                    selected_seats: coecSelectedSeats.map(seat => ({
                        event_id: seat.event_id.toString(),
                        seat_id: seat.seat_id.toString(),
                        seat_code: seat.seat_code || 'TBD', // Will be populated from seat data
                        capacity: seat.capacity || 1, // Will be populated from seat data
                        base_price: seat.base_price || 0, // Will be populated from seat data
                        event_price: seat.event_price || 0, // Will be populated from seat data
                        available_from: new Date(),
                        available_until: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000), // 30 days from now
                        status: 'selected'
                    }))
                };

                // Calculate pricing breakdown using event-specific pricing
                const pricingBreakdown = calculateCOEPricingBreakdown();
                
                // Add pricing to COE data
                coeData.subtotal = pricingBreakdown.subtotal;
                coeData.taxes = pricingBreakdown.taxes;
                coeData.fees = pricingBreakdown.fees;
                coeData.total = pricingBreakdown.total;
                coeData.pricing_breakdown = pricingBreakdown.pricing_breakdown;

                // Add runner assignment
                const runnerType = document.getElementById('coec_runner_type').value;
                if (runnerType === 'coe') {
                    const runnerId = document.getElementById('coec_coe_runner_id').value;
                    if (runnerId) {
                        coeData.runner_assignment = {
                            type: 'coe',
                            runner_id: runnerId,
                            notes: document.getElementById('coec_runner_notes').value.trim()
                        };
                    }
                }

                // Create or Update COE
                let result;
                if (isEditMode) {
                    result = await makeApiRequest(`/coes/${window.currentEditingCOEId}`, 'PUT', coeData);
                } else {
                    result = await makeApiRequest('/coes', 'POST', coeData);
                }
                
                // Log detailed error if available
                if (result.error || (result.data && result.data.error)) {
                    console.error('Detailed error:', result.error || result.data.error);
                }

                if (result.success) {
                    showAlert(isEditMode ? 'COE updated successfully!' : 'COE created successfully!', 'success');
                    closeCreateCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    console.error(isEditMode ? 'COE update failed:' : 'COE creation failed:', result);
                    showAlert(`Failed to ${isEditMode ? 'update' : 'create'} COE: ` + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error creating COE:', error);
                showAlert('Error creating COE: ' + error.message, 'error');
            }
        }

