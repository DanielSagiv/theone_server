                // Add hover effects
                modal.querySelectorAll('.coe-alternative-event-card').forEach(card => {
                    card.addEventListener('mouseenter', () => {
                        card.style.background = 'rgba(30, 41, 59, 0.8)';
                        card.style.borderColor = 'rgba(212, 175, 55, 0.5)';
                    });
                    card.addEventListener('mouseleave', () => {
                        card.style.background = 'rgba(30, 41, 59, 0.6)';
                        card.style.borderColor = 'rgba(255,255,255,0.1)';
                    });
                });

                // Handle event selection
                modal.querySelectorAll('.coe-select-event-btn').forEach(btn => {
                    btn.onclick = (e) => {
                        e.stopPropagation();
                        const eventId = btn.dataset.eventId;
                        console.log('[showEventSelectionModal] Button clicked, eventId:', eventId);
                        console.log('[showEventSelectionModal] Available events:', events.map(ev => ({
                            _id: ev._id,
                            _idType: typeof ev._id,
                            _idString: ev._id?.toString(),
                            name: ev.name
                        })));
                        
                        // Try multiple ways to match the event ID
                        const selectedEvent = events.find(ev => {
                            const evId = ev._id?.toString() || ev._id || ev.id;
                            const matchId = eventId.toString();
                            const matches = evId === matchId || String(evId) === String(matchId);
                            if (matches) {
                                console.log('[showEventSelectionModal] Found matching event:', ev);
                            }
                            return matches;
                        });
                        
                        console.log('[showEventSelectionModal] Selected event:', selectedEvent);
                        document.body.removeChild(modal);
                        resolve(selectedEvent || null);
                    };
                });
                
                // Also allow clicking the card itself
                modal.querySelectorAll('.coe-alternative-event-card').forEach(card => {
                    card.onclick = (e) => {
                        // Don't trigger if clicking the button
                        if (e.target.classList.contains('coe-select-event-btn')) {
                            return;
                        }
                        const eventId = card.dataset.eventId;
                        console.log('[showEventSelectionModal] Card clicked, eventId:', eventId);
                        const selectedEvent = events.find(ev => {
                            const evId = ev._id?.toString() || ev._id || ev.id;
                            return evId === eventId || String(evId) === String(eventId);
                        });
                        console.log('[showEventSelectionModal] Selected event from card:', selectedEvent);
                        document.body.removeChild(modal);
                        resolve(selectedEvent || null);
                    };
                });

                const cancelBtn = modal.querySelector('.coe-modal-cancel');
                cancelBtn.onclick = () => {
                    document.body.removeChild(modal);
                    resolve(null);
                };

                modal.onclick = (e) => {
                    if (e.target === modal) {
                        document.body.removeChild(modal);
                        resolve(null);
                    }
                };

                document.body.appendChild(modal);

                // Load cities into filter dropdown if available
                const citySelect = modal.querySelector('#alternativeEventsCityFilter');
                if (citySelect && coeId && eventId) {
                    loadCitiesIntoSelect(citySelect).then(() => {
                        if (currentCityFilter) {
                            citySelect.value = currentCityFilter;
                        }
                    });
                }

                // Handle city filter change
                const applyCityFilterBtn = modal.querySelector('#applyCityFilterBtn');
                if (applyCityFilterBtn && coeId && eventId) {
                    applyCityFilterBtn.onclick = async () => {
                        const selectedCity = citySelect.value;
                        console.log('[showEventSelectionModal] City filter changed to:', selectedCity);
                        
                        // Close current modal
                        document.body.removeChild(modal);
                        
                        // Reload alternatives with city filter
                        if (typeof handleReplaceEvent === 'function') {
                            await handleReplaceEvent(coeId, eventId, selectedCity || null);
                        }
                    };
                }
            });
        }
        
        /**
         * Render client list card with search and pagination
         * @param {Object} clientListData - Client list data with clients array and pagination
         * @returns {HTMLElement} Client list card element
         */
        function renderClientList(clientListData) {
            const card = document.createElement('div');
            card.className = 'bot-structured-card bot-client-list';
            
            const clients = clientListData.clients || [];
            const pagination = clientListData.pagination || { page: 1, limit: 20, total: 0, totalPages: 1 };
            
            // Generate client cards HTML
            let clientsHtml = '';
            if (clients.length === 0) {
                clientsHtml = '<div class="bot-client-empty">No clients found.</div>';
            } else {
                const canCreateCOE = currentUser && currentUser.role === 'admin';
                clientsHtml = clients.map(client => {
                    const initials = getInitials(client.name || client.email);
                    const avatarHtml = client.avatarUrl
                        ? `<img src="${client.avatarUrl}" alt="${client.name || 'Client'}" loading="lazy">`
                        : `<span class="bot-client-avatar-initials">${initials}</span>`;
                    
                    return `
                        <div class="bot-client-card" data-client-id="${client.id}">
                            <div class="bot-client-card-avatar">
                                ${avatarHtml}
                            </div>
                            <div class="bot-client-card-info">
                                <div class="bot-client-card-name">${client.name || 'Unknown Client'}</div>
                                <div class="bot-client-card-email">${client.email || 'No email'}</div>
                            </div>
                            <div class="bot-client-card-actions">
                                <button class="bot-client-view-btn" onclick="handleViewClientProfile('${client.id}')">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M8 1C4.134 1 1 4.134 1 8s3.134 7 7 7 7-3.134 7-7-3.134-7-7-7zM8 13c-2.761 0-5-2.239-5-5s2.239-5 5-5 5 2.239 5 5-2.239 5-5 5z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                                        <path d="M8 5.5c-1.381 0-2.5 1.119-2.5 2.5s1.119 2.5 2.5 2.5 2.5-1.119 2.5-2.5-1.119-2.5-2.5-2.5z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                                    </svg>
                                    View
                                </button>
                                ${canCreateCOE ? `
                                <button class="bot-client-view-btn" style="margin-left: 8px;" onclick="handleCreateCOEForClient('${client.id}')">
                                    Create COE
                                </button>` : ''}
                            </div>
                        </div>
                    `;
                }).join('');
            }
            
            // Pagination HTML
            let paginationHtml = '';
            if (pagination.totalPages > 1) {
                const prevDisabled = pagination.page <= 1 ? 'disabled' : '';
                const nextDisabled = pagination.page >= pagination.totalPages ? 'disabled' : '';
                
                // Generate page numbers (show max 5 pages)
                let pageNumbers = [];
                const maxPages = 5;
                let startPage = Math.max(1, pagination.page - Math.floor(maxPages / 2));
                let endPage = Math.min(pagination.totalPages, startPage + maxPages - 1);
                if (endPage - startPage < maxPages - 1) {
                    startPage = Math.max(1, endPage - maxPages + 1);
                }
                
                for (let i = startPage; i <= endPage; i++) {
                    pageNumbers.push(i);
                }
                
                paginationHtml = `
                    <div class="bot-client-pagination">
                        <button class="bot-client-pagination-btn" ${prevDisabled} onclick="handleClientListPage(${pagination.page - 1})" ${prevDisabled ? 'disabled' : ''}>
                            Previous
                        </button>
                        <div class="bot-client-pagination-pages">
                            ${pageNumbers.map(pageNum => `
                                <button class="bot-client-pagination-page ${pageNum === pagination.page ? 'active' : ''}" 
                                        onclick="handleClientListPage(${pageNum})">
                                    ${pageNum}
                                </button>
                            `).join('')}
                        </div>
                        <button class="bot-client-pagination-btn" ${nextDisabled} onclick="handleClientListPage(${pagination.page + 1})" ${nextDisabled ? 'disabled' : ''}>
                            Next
                        </button>
                        <span class="bot-client-pagination-info">
                            Page ${pagination.page} of ${pagination.totalPages} (${pagination.total} total)
                        </span>
                    </div>
                `;
            }
            
            // Generate unique ID for this search input
            const searchInputId = `clientSearchInput_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            
            card.innerHTML = `
                <div class="bot-client-list-header">
                    <h3 class="bot-client-list-title">Users</h3>
