            document.getElementById('mediaLightbox').style.display = 'none';
        }

        /**
         * Delete location with confirmation
         */
        async function deleteLocation(locationId, locationName) {
            // Check if user is admin
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can delete locations', 'error');
                return;
            }

            // Show confirmation dialog
            const confirmed = confirm(`Are you sure you want to delete the location "${locationName}"?\n\nThis action cannot be undone.`);
            if (!confirmed) {
                return;
            }

            try {
                const result = await makeApiRequest(`/locations/${locationId}`, 'DELETE');
                if (result.success) {
                    showAlert('Location deleted successfully', 'success');
                    loadLocations(); // Refresh the locations table
                } else {
                    showAlert('Failed to delete location: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Delete location error:', error);
                showAlert('Error deleting location: ' + error.message, 'error');
            }
        }

        /**
         * Close location modal
         */
        function closeLocationModal() {
            const modal = document.getElementById('locationModal');
            if (modal) modal.style.display = 'none';
            // Reset state so reopening works reliably
            currentLocationId = null;
            // Clear section content but keep modal skeleton in DOM
            const sentimentContainer = document.getElementById('locationSentimentList');
            if (sentimentContainer) sentimentContainer.innerHTML = '';
            const attributesContainer = document.getElementById('locationAttributes');
            if (attributesContainer) attributesContainer.innerHTML = '';
            const seatingAreas = document.getElementById('seatingAreas');
            if (seatingAreas) seatingAreas.innerHTML = '';
            const roomTypes = document.getElementById('roomTypes');
            if (roomTypes) roomTypes.innerHTML = '';
        }

        // ===== Edit Location Functions =====
        let currentEditLocation = null;
        let el_currentStep = 1;

        /**
         * Open edit location modal
         */
        async function openEditLocationModal() {
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can edit locations', 'error');
                return;
            }

            if (!currentLocationId) {
                showAlert('No location selected', 'error');
                return;
            }

            try {
                // Fetch current location data
                const result = await makeApiRequest(`/locations/${currentLocationId}`);
                if (!result.success) {
                    showAlert('Failed to load location data', 'error');
                    return;
                }

                // Extract location data (handle nested response structure)
                const locationData = result.data?.data || result.data;
                currentEditLocation = locationData;
                el_currentStep = 1;
                
                // Populate form with current data
                populateEditForm(locationData);
                
                // Show modal
                document.getElementById('editLocationModal').style.display = 'flex';
                el_showStep(1);
                
            } catch (error) {
                console.error('Error opening edit modal:', error);
                showAlert('Error loading location data: ' + error.message, 'error');
            }
        }

