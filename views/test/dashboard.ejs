                                        event_id: o.event_id,
                                        event_id_type: typeof o.event_id,
                                        event_id_isObject: typeof o.event_id === 'object',
                                        event_id_hasToString: !!(o.event_id && o.event_id.toString),
                                        event_id_str: o.event_id?.toString?.(),
                                        event_id_normalized: normalizedOfferId,
                                        eventId_normalized: normalizedEventId,
                                        will_match: normalizedOfferId === normalizedEventId,
                                        current_seat_code: o.current_seat_code,
