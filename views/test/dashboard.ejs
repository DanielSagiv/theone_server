                                </div>
                            `;
                        }).join('');
                        
                        return `
                            <div class="location-seat-category">
                                <div class="location-seat-category-header" onclick="toggleSeatCategory(this)">
                                    <div>
                                        <span class="location-seat-category-title">${categoryLabel}</span>
                                        <span class="location-seat-category-count">(${seatsInCategory.length})</span>
                                    </div>
                                    <span class="expand-icon">▼</span>
                                </div>
                                <div class="location-seat-category-content">
                                    ${seatItemsHtml}
                                </div>
                            </div>
                        `;
                    }).join('');
                    
                    return `
                        <div class="location-seats-section">
                            <button class="location-seats-toggle" onclick="toggleLocationSeats(this)">
                                <span>View Seats (${location.seats.length})</span>
                                <span class="expand-icon">▼</span>
                            </button>
                            <div class="location-seats-content">
                                ${categoryHtml}
                            </div>
                        </div>
                    `;
                })() : '';
                
                return `
                    <div class="bot-location-item">
                        ${heroImageHtml}
                        <div class="location-item-header">
                            <h5 class="location-item-title">${location.name || 'Untitled Location'}</h5>
                            <span class="location-item-type">${typeLabel}</span>
                        </div>
                        ${thumbnailGalleryHtml}
                        <div class="location-item-details">
                            <div class="location-detail">
                                <span class="location-detail-label">Type:</span>
                                <span class="location-detail-value">${typeLabel}</span>
                            </div>
                            <div class="location-detail">
                                <span class="location-detail-label">Address:</span>
                                <span class="location-detail-value">${addressText}${mapLink ? ` <a href="${mapLink}" target="_blank" class="event-map-link" title="View on map"><svg class="event-map-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>View Map</a>` : ''}</span>
                            </div>
