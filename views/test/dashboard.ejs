        /**
         * Get coverage display for COE
         */
        function getCoverageDisplay(coe) {
            const coveredAmount = coe.covered_by_t1?.amount || 0;
            const total = coe.total || 0;
            const coveragePercentage = total > 0 ? ((coveredAmount / total) * 100).toFixed(1) : 0;
            
            let statusClass = 'status-uncovered';
            let statusText = 'Not Covered';
            
            if (coveredAmount > 0) {
                if (coveredAmount >= total) {
                    statusClass = 'status-fully-covered';
                    statusText = 'Fully Covered';
                } else {
                    statusClass = 'status-partially-covered';
                    statusText = 'Partially Covered';
                }
            }
            
            return `
                <div style="text-align: center;">
                    <div style="font-weight: bold; color: #2c3e50;">$${coveredAmount.toLocaleString()} / $${total.toLocaleString()}</div>
                    <div style="font-size: 0.9em; color: #7f8c8d;">${coveragePercentage}%</div>
                    <span class="status-badge ${statusClass}" style="font-size: 0.8em; margin-top: 3px; display: inline-block;">${statusText}</span>
                </div>
            `;
        }

