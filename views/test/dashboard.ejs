                                    Current Coverage: $${currentCovered.toLocaleString()}
                                </div>
                            </div>
                            <div class="form-field">
                                <label for="coverageAmount">Covered Amount ($)</label>
                                <input type="number" id="coverageAmount" min="0" max="${total}" step="0.01" value="${currentCovered}" 
                                       style="width: 100%; padding: 10px; border: 1px solid #ecf0f1; border-radius: 8px; font-size: 1.1em;">
                                <div style="font-size: 0.8em; color: #6c757d; margin-top: 5px;">
                                    Maximum: $${total.toLocaleString()}
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" onclick="closeCoverageModal()">Cancel</button>
                            <button class="btn btn-primary" onclick="updateCoverage('${coeId}')">Update Coverage</button>
                        </div>
                    </div>
                </div>
            `;

