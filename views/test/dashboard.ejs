                    // Build event-level runner details card (display at bottom of event section if present)
                    const evRunner = matchingEvent?.runner_assignment?.runner || null;
                    const evRunnerStatus = matchingEvent?.runner_assignment?.status || null;
                    const eventRunnerDetailsHtml = evRunner
