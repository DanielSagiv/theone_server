        /**
         * Close COE view modal
         */
        function closeViewCOE() {
            const modal = document.getElementById('viewCOEModal');
            if (modal) {
                modal.remove();
            }
        }

        /**
         * Show coverage modal for updating COE coverage
         */
        function showCoverageModal(coeId, total, currentCovered) {
            const modalHtml = `
                <div id="coverageModal" class="modal" style="display: flex;">
                    <div class="modal-content" style="max-width: 500px;">
                        <div class="modal-header">
                            <h2>Update COE Coverage</h2>
                            <button class="close-btn" onclick="closeCoverageModal()">&times;</button>
                        </div>
                        <div class="modal-body">
                            <div style="margin-bottom: 20px;">
                                <div style="font-size: 1.1em; font-weight: bold; color: #2c3e50; margin-bottom: 10px;">
                                    COE Total: $${total.toLocaleString()}
                                </div>
                                <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 15px;">
                                    Current Coverage: $${currentCovered.toLocaleString()}
                                </div>
                            </div>
                            <div class="form-field">
                                <label for="coverageAmount">Covered Amount ($)</label>
                                <input type="number" id="coverageAmount" min="0" max="${total}" step="0.01" value="${currentCovered}" 
                                       style="width: 100%; padding: 10px; border: 1px solid #ecf0f1; border-radius: 8px; font-size: 1.1em;">
                                <div style="font-size: 0.8em; color: #6c757d; margin-top: 5px;">
                                    Maximum: $${total.toLocaleString()}
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" onclick="closeCoverageModal()">Cancel</button>
                            <button class="btn btn-primary" onclick="updateCoverage('${coeId}')">Update Coverage</button>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('coverageModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        /**
         * Close coverage modal
         */
        function closeCoverageModal() {
            const modal = document.getElementById('coverageModal');
            if (modal) {
                modal.remove();
            }
        }

        /**
         * Update COE coverage amount
         */
        async function updateCoverage(coeId) {
            try {
                const amountInput = document.getElementById('coverageAmount');
                const amount = parseFloat(amountInput.value);

                if (isNaN(amount) || amount < 0) {
                    showAlert('Please enter a valid amount', 'error');
                    return;
                }

                showAlert('Updating coverage...', 'info');

                const result = await makeApiRequest(`/coes/${coeId}/covered-amount`, 'PUT', {
                    amount: amount
                });

                if (result.success) {
                    showAlert('Coverage updated successfully!', 'success');
                    closeCoverageModal();
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Failed to update coverage: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error updating coverage:', error);
                showAlert('Failed to update coverage: ' + error.message, 'error');
            }
        }

        /**
         * Set COE as fully covered
         */
        async function setFullCoverage(coeId, total) {
            try {
                const confirmed = confirm(`Set this COE as fully covered for $${total.toLocaleString()}?`);
                
                if (!confirmed) {
                    return;
                }

                showAlert('Setting full coverage...', 'info');

                const result = await makeApiRequest(`/coes/${coeId}/covered-all`, 'PUT');

                if (result.success) {
                    showAlert('COE set as fully covered!', 'success');
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Failed to set full coverage: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error setting full coverage:', error);
                showAlert('Failed to set full coverage: ' + error.message, 'error');
            }
        }

        /**
         * Show COE payment modal
         */
        async function showCOEPaymentModal(coeId, amount) {
            try {
                // Get saved payment methods
                const result = await makeApiRequest('/payments/saved-cards', 'GET');
                
                if (!result.success || !result.data) {
                    showAlert('Failed to load payment methods', 'error');
                    return;
                }

                const apiData = result.data.data || result.data;
                const savedCards = apiData.saved_cards || [];

                let paymentMethodsHtml = '';
                if (savedCards.length > 0) {
                    paymentMethodsHtml = savedCards.map(card => `
                        <div class="payment-method-option" onclick="selectPaymentMethod('${card.token_id}')">
                            <div class="payment-method-card">
                                <div class="card-brand-icon ${getCardBrandClass(card.card_brand)}">
                                    ${getCardBrandIcon(card.card_brand)}
                                </div>
                                <div class="payment-method-details">
                                    <div class="payment-method-name">
                                        ${card.nickname || card.card_brand + ' •••• ' + card.card_last_four}
                                        ${card.is_default ? '<span class="badge-success" style="margin-left: 8px;">DEFAULT</span>' : ''}
                                    </div>
                                    <div class="payment-method-number">
                                        ${card.card_brand} •••• ${card.card_last_four} • Expires ${card.expiry_month}/${card.expiry_year}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    paymentMethodsHtml = '<p style="text-align: center; color: #7f8c8d; padding: 20px;">No saved payment methods. Please add a card first.</p>';
                }

                const modalHtml = `
                    <div id="coePaymentModal" class="modal" style="display: flex;">
                        <div class="modal-content" style="max-width: 500px;">
                            <div class="modal-header">
                                <h2>Pay for COE</h2>
                                <button class="close-btn" onclick="closeCOEPaymentModal()">&times;</button>
                            </div>
                            <div class="modal-body">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                                    <div style="font-size: 1.2em; font-weight: bold; color: #2c3e50;">Total Amount: $${amount.toLocaleString()}</div>
                                    <div style="color: #7f8c8d; font-size: 0.9em;">Full payment required</div>
                                </div>
                                
                                <div>
                                    <h3 style="margin-bottom: 15px;">Select Payment Method</h3>
                                    <div id="paymentMethodsList" style="max-height: 300px; overflow-y: auto;">
                                        ${paymentMethodsHtml}
                                    </div>
                                </div>
                                
                                <div style="margin-top: 20px; text-align: center;">
                                    <button class="btn btn-primary" onclick="processCOEPayment('${coeId}', ${amount})" id="processPaymentBtn" disabled>
                                        Pay $${amount.toLocaleString()}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Remove existing modal if any
                const existingModal = document.getElementById('coePaymentModal');
                if (existingModal) {
                    existingModal.remove();
                }

                document.body.insertAdjacentHTML('beforeend', modalHtml);
            } catch (error) {
                console.error('Error showing COE payment modal:', error);
                showAlert('Failed to load payment methods', 'error');
            }
        }

        /**
         * Close COE payment modal
         */
        function closeCOEPaymentModal() {
            const modal = document.getElementById('coePaymentModal');
            if (modal) {
                modal.remove();
            }
        }

        /**
         * Select payment method
         */
        function selectPaymentMethod(tokenId) {
            // Remove previous selection
            document.querySelectorAll('.payment-method-option').forEach(option => {
                option.classList.remove('selected');
            });
            
            // Add selection to clicked option
            event.currentTarget.classList.add('selected');
            
            // Enable process button
            document.getElementById('processPaymentBtn').disabled = false;
            
            // Store selected token
            window.selectedPaymentToken = tokenId;
        }

        /**
         * Process COE payment
         */
        async function processCOEPayment(coeId, amount) {
            if (!window.selectedPaymentToken) {
                showAlert('Please select a payment method', 'error');
                return;
            }

            try {
                showAlert('Processing payment...', 'info');
                
                const result = await makeApiRequest(`/coes/${coeId}/payments/full`, 'POST', {
                    token_id: window.selectedPaymentToken
                });

                if (result.success) {
                    showAlert('Payment processed successfully!', 'success');
                    closeCOEPaymentModal();
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Payment failed: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error processing COE payment:', error);
                showAlert('Payment failed: ' + error.message, 'error');
            }
        }

        /**
         * Show COE refund modal
         */
        function showCOERefundModal(coeId, totalAmount, refundedAmount) {
            const remainingRefundable = totalAmount - refundedAmount;
            
            const modalHtml = `
                <div id="coeRefundModal" class="modal" style="display: flex;">
                    <div class="modal-content" style="max-width: 500px;">
                        <div class="modal-header">
                            <h2>Process COE Refund</h2>
                            <button class="close-btn" onclick="closeCOERefundModal()">&times;</button>
                        </div>
                        <div class="modal-body">
                            <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                                <div style="font-size: 1.1em; font-weight: bold; color: #2c3e50;">Refund Information</div>
                                <div style="margin-top: 10px; color: #7f8c8d;">
                                    <div><strong>Original Amount:</strong> $${totalAmount.toLocaleString()}</div>
                                    <div><strong>Already Refunded:</strong> $${refundedAmount.toLocaleString()}</div>
                                    <div><strong>Remaining Refundable:</strong> $${remainingRefundable.toLocaleString()}</div>
                                </div>
                            </div>
                            
                            <div style="margin-bottom: 20px;">
                                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Refund Options</label>
                                <div style="margin-bottom: 15px;">
                                    <button class="btn btn-secondary" onclick="selectRefundAmount(${remainingRefundable})" style="margin-right: 10px; padding: 8px 16px;">
                                        Full Refund ($${remainingRefundable.toLocaleString()})
                                    </button>
                                </div>
                                <div style="margin-bottom: 15px;">
                                    <label style="display: block; margin-bottom: 5px;">Or enter partial refund amount:</label>
                                    <input type="number" id="refundAmount" placeholder="Enter amount" min="0.01" max="${remainingRefundable}" step="0.01" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                                </div>
                            </div>
                            
                            <div style="margin-bottom: 20px;">
                                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Refund Reason (Required)</label>
                                <textarea id="refundReason" placeholder="Enter reason for refund..." style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; min-height: 80px; resize: vertical;"></textarea>
                            </div>
                            
                            <div style="text-align: center;">
                                <button class="btn btn-warning" onclick="processCOERefund('${coeId}')" id="processRefundBtn" disabled>
                                    Process Refund
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('coeRefundModal');
            if (existingModal) {
                existingModal.remove();
            }

            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Add event listeners for validation
            const refundAmountInput = document.getElementById('refundAmount');
            const refundReasonInput = document.getElementById('refundReason');
            const processBtn = document.getElementById('processRefundBtn');
            
            function validateForm() {
                const amount = parseFloat(refundAmountInput.value) || 0;
                const reason = refundReasonInput.value.trim();
                const isValid = amount > 0 && amount <= remainingRefundable && reason.length > 0;
                processBtn.disabled = !isValid;
            }
            
            refundAmountInput.addEventListener('input', validateForm);
            refundReasonInput.addEventListener('input', validateForm);
        }

        /**
         * Close COE refund modal
         */
        function closeCOERefundModal() {
            const modal = document.getElementById('coeRefundModal');
            if (modal) {
                modal.remove();
            }
        }

        /**
         * Select refund amount
         */
        function selectRefundAmount(amount) {
            document.getElementById('refundAmount').value = amount;
            document.getElementById('processRefundBtn').disabled = false;
        }

        /**
         * Process COE refund
         */
        async function processCOERefund(coeId) {
            const refundAmount = parseFloat(document.getElementById('refundAmount').value);
            const refundReason = document.getElementById('refundReason').value.trim();

            if (!refundAmount || refundAmount <= 0) {
                showAlert('Please enter a valid refund amount', 'error');
                return;
            }

            if (!refundReason) {
                showAlert('Please enter a refund reason', 'error');
                return;
            }

            try {
                showAlert('Processing refund...', 'info');
                
                const result = await makeApiRequest(`/coes/${coeId}/payments/refund`, 'POST', {
                    refund_amount: refundAmount,
                    reason: refundReason
                });

                if (result.success) {
                    showAlert('Refund processed successfully!', 'success');
                    closeCOERefundModal();
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Refund failed: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error processing COE refund:', error);
                showAlert('Refund failed: ' + error.message, 'error');
            }
        }

        /**
         * Display price history based on user role
         */
        function displayPriceHistory(eventId, tableId) {
            if (currentUser?.role === 'admin') {
                // Admin sees all price history
                showAdminPriceHistory(eventId, tableId);
            } else if (currentUser?.role === 'client') {
                // Client sees only beneficial price changes
                showClientPriceHistory(eventId, tableId);
            }
            // Runners don't see price history
        }

        /**
         * Show admin price history (all changes)
         */
        async function showAdminPriceHistory(eventId, tableId) {
            try {
                const result = await makeApiRequest(`/events/${eventId}/pricing/history`);
                
                const allHistory = result.data.pricing_history;
                const tableHistory = allHistory.filter(h => h.table_id === tableId);
                
                const historyHtml = tableHistory.map(history => `
                    <div class="price-history-item">
                        <div class="price-change">
                            <span class="previous-price">$${history.previous_price}</span>
                            <span class="arrow">→</span>
                            <span class="new-price">$${history.new_price}</span>
                        </div>
                        <div class="change-details">
                            <div class="reason">${history.change_reason}</div>
                            <div class="changed-by">by ${history.changed_by.firstName} ${history.changed_by.lastName}</div>
                            <div class="changed-at">${new Date(history.changed_at).toLocaleDateString()}</div>
                        </div>
                    </div>
                `).join('');
                
                showPriceHistoryModal('Admin Price History', historyHtml);
            } catch (error) {
                console.error('Error loading admin price history:', error);
                showAlert('Failed to load price history', 'error');
            }
        }

