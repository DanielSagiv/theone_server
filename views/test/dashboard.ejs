        /**
         * Add sentiment
         */
        async function addSentiment() {
            console.log('addSentiment called');
            console.log('currentLocationId:', currentLocationId);
            console.log('currentSentimentContext:', currentSentimentContext);
            
            if (!currentLocationId) {
                showAlert('No location selected', 'error');
                return;
            }

            const type = document.getElementById('sentimentType').value;
            const text = document.getElementById('sentimentText').value.trim();

            console.log('Sentiment data:', { type, text });

            if (!type) {
                showAlert('Please select a sentiment type', 'error');
                return;
            }

            try {
                let endpoint = '';
                if (currentSentimentContext === 'location') {
                    endpoint = `/locations/${currentLocationId}/sentiment`;
                } else if (currentSentimentContext === 'seat') {
                    if (!currentSeatCode) {
                        showAlert('Seat code not set', 'error');
                        return;
                    }
                    endpoint = `/locations/${currentLocationId}/seats/${currentSeatCode}/sentiment`;
                } else if (currentSentimentContext === 'unit') {
                    if (!currentUnitCode) {
                        showAlert('Unit code not set', 'error');
                        return;
                    }
                    endpoint = `/locations/${currentLocationId}/units/${currentUnitCode}/sentiment`;
                }

                console.log('API endpoint:', endpoint);

                const result = await makeApiRequest(endpoint, 'POST', {
                    type: type,
                    text: text
                });

                console.log('API response:', result);

                if (result.success) {
                    showAlert('Sentiment added successfully!', 'success');
                    closeAddSentimentModal();
                    // Refresh location details
                    viewLocationDetails(currentLocationId);
                } else {
                    showAlert('Failed to add sentiment: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error adding sentiment:', error);
                showAlert('Error adding sentiment: ' + error.message, 'error');
            }
        }

