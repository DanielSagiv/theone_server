        function updateSeatDisplayForCOE(eventId) {
            const seatsGrid = document.getElementById(`seats_grid_${eventId}`);
            
            if (!seatsGrid) {
                return;
            }
            
            // Get all seat cards in the grid
            const seatCards = seatsGrid.querySelectorAll('.seat-card');
            
            seatCards.forEach(card => {
                const seatId = card.getAttribute('data-seat-id');
                const isSelected = coecSelectedSeats.some(s => s.seat_id === seatId && s.event_id === eventId);
                
                if (isSelected) {
                    card.classList.add('selected');
