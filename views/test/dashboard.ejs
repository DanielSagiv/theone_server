        /**
         * Load events for the events section
         */
        async function loadEvents(page = eventsPage) {
            try {
                const pageSizeEl = document.getElementById('eventsPageSize');
                if (pageSizeEl) {
                    eventsLimit = parseInt(pageSizeEl.value) || eventsLimit;
                }

                const params = new URLSearchParams();
                params.set('page', page);
                params.set('limit', eventsLimit);

                const locationFilter = document.getElementById('eventLocationFilter')?.value || '';
                const statusFilter = document.getElementById('eventStatusFilter')?.value || '';
                const typeFilter = document.getElementById('eventTypeFilter')?.value || '';
                const searchInput = document.getElementById('eventSearchInput')?.value || '';

                if (locationFilter) params.set('location_id', locationFilter);
                if (statusFilter) params.set('status', statusFilter);
                if (typeFilter) params.set('type', typeFilter);
                if (searchInput) params.set('search', searchInput);

                console.log('Loading events...', Object.fromEntries(params.entries()));
                const result = await makeApiRequest(`/events?${params.toString()}`);
                console.log('Events API result:', result);
                
                if (result.success && result.data) {
                    const dataArray = Array.isArray(result.data) ? result.data : (result.data.data || []);
                    allEvents = dataArray;

                    const pagination = result.pagination || result.data?.pagination || {};
                    eventsPage = parseInt(pagination.page || page || 1);
                    eventsLimit = parseInt(pagination.limit || eventsLimit);
                    eventsTotal = parseInt(pagination.total || dataArray.length || 0);
                    eventsTotalPages = parseInt(pagination.pages || Math.max(1, Math.ceil(eventsTotal / eventsLimit)));

                    console.log('Events loaded:', allEvents.length, 'page', eventsPage, 'of', eventsTotalPages, 'total', eventsTotal);
                    displayEventsTable(allEvents);
                    renderEventsPagination();
                    populateEventLocationFilter();
                    showAlert('Events loaded successfully!', 'success');
                } else {
                    console.error('Failed to load events:', result);
                    showAlert('Failed to load events: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error loading events:', error);
                showAlert('Error loading events: ' + error.message, 'error');
            }
        }

        /**
         * Import events from GXN JSON file
         */
        async function importGXNEvents() {
            if (!confirm('Import all events from gxn_res.json schedules? This will create Event records linked to existing Locations. Make sure venues are imported first!')) {
                return;
            }
            
            try {
                showAlert('Starting event import from GXN...', 'info');
                
                const response = await makeApiRequest('/gxn/import/events', 'POST', {});
                
                if (response.success) {
                    const summary = response.summary || {};
                    showAlert(`Import complete! ${summary.imported || 0} events imported, ${summary.failed || 0} failed, ${summary.skipped || 0} skipped.`, 'success');
                    
                    // Display detailed results
                    let resultsHtml = `<h4 style="margin:12px 0 8px;">Import Results</h4>`;
                    resultsHtml += `<p><strong>Total processed:</strong> ${summary.total || 0}</p>`;
                    resultsHtml += `<p style="color:green;"><strong>Imported:</strong> ${summary.imported || 0}</p>`;
                    resultsHtml += `<p style="color:red;"><strong>Failed:</strong> ${summary.failed || 0}</p>`;
                    resultsHtml += `<p style="color:orange;"><strong>Skipped:</strong> ${summary.skipped || 0}</p>`;
                    
                    if (response.data?.success?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;">Successfully Imported:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.success.forEach(item => {
                            resultsHtml += `<li>${item.name} (${item.eventcode}) - ${item.seatsInherited || 0} seats - <a href="#" onclick="viewEventDetails('${item.eventId}'); return false;">View</a></li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    if (response.data?.failed?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;color:red;">Failed:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.failed.forEach(item => {
                            resultsHtml += `<li>${item.venueCode}/${item.ecozone}: ${item.error}</li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    if (response.data?.skipped?.length > 0) {
                        resultsHtml += `<h5 style="margin:12px 0 6px;color:orange;">Skipped:</h5><ul style="margin:0 0 12px 20px;">`;
                        response.data.skipped.forEach(item => {
                            resultsHtml += `<li>${item.venueCode}/${item.ecozone}: ${item.reason}${item.eventId ? ' (existing: ' + item.eventId + ')' : ''}</li>`;
                        });
                        resultsHtml += `</ul>`;
                    }
                    
                    // Show in alert (simple for now)
                    alert(resultsHtml.replace(/<[^>]*>/g, ''));
                    
                    // Reload events table
                    await loadEvents();
                    
                } else {
                    showAlert('Import failed: ' + (response.error?.message || 'Unknown error'), 'error');
                }
                
            } catch (error) {
                console.error('Import error:', error);
                showAlert('Import error: ' + error.message, 'error');
            }
        }

        /**
         * Display events in table
         */
        function displayEventsTable(events) {
            const tableBody = document.getElementById('eventsTableBody');
            
            if (events.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:#7f8c8d;">No events found</td></tr>';
                return;
            }

            tableBody.innerHTML = events.map(event => {
                const startDate = new Date(event.start_datetime).toLocaleDateString();
                const startTime = new Date(event.start_datetime).toLocaleTimeString();
                const locationName = event.location_id?.name || 'Unknown Location';
                const statusClass = `status-${event.status}`;
                const statusText = event.status.replace('_', ' ').toUpperCase();
                
                return `
                    <tr onclick="viewEventDetails('${event._id}')" style="cursor:pointer;">
                        <td>
                            <strong>${event.name}</strong>
                            <br><small style="color:#666;">${event.description || 'No description'}</small>
                        </td>
                        <td>${locationName}</td>
                        <td>${event.type ? event.type.replace('_', ' ').toUpperCase() : 'N/A'}</td>
                        <td>
                            ${startDate}<br>
                            <small style="color:#666;">${startTime}</small>
                        </td>
                        <td>
                            ${event.total_booked || 0} / ${event.total_capacity || 0}
                            <br><small style="color:#666;">${event.availability_percentage || 0}% available</small>
                        </td>
                        <td>
                            <span class="status-badge ${statusClass}">${statusText}</span>
                        </td>
                        <td>
                            $${(event.total_revenue || 0).toLocaleString()}
                            <br><small style="color:#666;">${event.currency || 'USD'}</small>
                        </td>
                        <td>
                            <button class="btn-icon btn-icon-edit" onclick="event.stopPropagation(); editEvent('${event._id}')" title="Edit Event">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                </svg>
                            </button>
                            <button class="btn-icon btn-icon-delete" onclick="event.stopPropagation(); deleteEvent('${event._id}', '${event.name}')" title="Delete Event">
                                <svg class="icon" viewBox="0 0 24 24">
                                    <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                </svg>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        /**
         * Populate event location filter
         */
        async function populateEventLocationFilter() {
            try {
                const result = await makeApiRequest('/locations');
                if (result.success && result.data) {
                    allLocations = Array.isArray(result.data) ? result.data : result.data.data || [];
                    const locationFilter = document.getElementById('eventLocationFilter');
                    locationFilter.innerHTML = '<option value="">All Locations</option>' +
                        allLocations.map(loc => `<option value="${loc._id}">${loc.name}</option>`).join('');
                }
