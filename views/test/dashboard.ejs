         * Reset create COE form
         */
        function resetCreateCOEForm() {
            // Reset form fields
            document.getElementById('coec_name').value = '';
            document.getElementById('coec_description').value = '';
            document.getElementById('coec_client_id').value = '';
            document.getElementById('coec_start_date').value = '';
            document.getElementById('coec_end_date').value = '';
            document.getElementById('coec_currency').value = 'USD';
            document.getElementById('coec_taxes_percent').value = '0';
            document.getElementById('coec_fees_amount').value = '0';
            document.getElementById('coec_deposit_percent').value = '20';
            document.getElementById('coec_policies').value = '';
            document.getElementById('coec_notes').value = '';
            document.getElementById('coec_runner_notes').value = '';
