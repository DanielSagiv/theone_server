        function renderErrorResponse(errorData) {
            console.log('[FRONTEND] renderErrorResponse called with:', {
                hasSpecificReason: !!errorData.specific_reason,
                specificReason: errorData.specific_reason,
                hasDetails: !!errorData.details,
                hasPrimaryReason: !!errorData.details?.primary_reason,
                primaryReason: errorData.details?.primary_reason,
