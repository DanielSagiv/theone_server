            z-index: 10;
        }

        /* List items use the same menu styles as cards - styles inherited from card menu */

        .bot-empty-message {
            color: #94a3b8;
            font-size: 0.9rem;
            text-align: center;
            padding: 20px;
        }

        .bot-loading-indicator {
            display: flex;
            align-items: center;
            gap: 12px;
    color: #94a3b8;
            font-size: 0.9rem;
        }
        
        /* Small caption under location thumbnails inside event groups */
        .event-location-caption {
            margin-top: 4px;
            font-size: 0.75rem;
            color: #94a3b8;
        }

        .bot-input-area label {
            display: block;
            font-weight: 600;
    color: #cbd5f5;
            margin-bottom: 8px;
        }

        .bot-input-area textarea {
            width: 100%;
            min-height: 40px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 12px;
            padding: 14px;
