        /**
         * Display event details in modal
         */
        function displayEventDetails(event) {
            // Update event info
            document.getElementById('eventDetailsTitle').textContent = event.name;
            document.getElementById('eventDetailName').textContent = event.name;
            document.getElementById('eventDetailType').textContent = event.type.replace('_', ' ').toUpperCase();
            document.getElementById('eventDetailLocation').textContent = event.location_id?.name || 'Unknown Location';
            document.getElementById('eventDetailStartDate').textContent = new Date(event.start_datetime).toLocaleString();
            document.getElementById('eventDetailEndDate').textContent = event.end_datetime ? new Date(event.end_datetime).toLocaleString() : 'Not specified';
            document.getElementById('eventDetailStatus').innerHTML = `<span class="status-badge status-${event.status}">${event.status.replace('_', ' ').toUpperCase()}</span>`;
            document.getElementById('eventDetailBasePrice').textContent = `${event.currency || 'USD'} ${event.base_price || 0}`;
            document.getElementById('eventDetailCapacity').textContent = event.total_capacity || 0;
            document.getElementById('eventDetailBooked').textContent = event.total_booked || 0;
            document.getElementById('eventDetailRevenue').textContent = `${event.currency || 'USD'} ${(event.total_revenue || 0).toLocaleString()}`;
            document.getElementById('eventDetailDescription').textContent = event.description || 'No description';
            document.getElementById('eventDetailPolicies').textContent = event.policies || 'No policies specified';

            // Update analytics
            const availability = event.total_capacity > 0 ? Math.round(((event.total_capacity - (event.total_booked || 0)) / event.total_capacity) * 100) : 0;
            const revenuePerSeat = event.total_booked > 0 ? (event.total_revenue || 0) / event.total_booked : 0;
            const daysUntil = Math.ceil((new Date(event.start_datetime) - new Date()) / (1000 * 60 * 60 * 24));
            
            document.getElementById('eventAnalyticsAvailability').textContent = `${availability}%`;
            document.getElementById('eventAnalyticsRevenuePerSeat').textContent = `${event.currency || 'USD'} ${revenuePerSeat.toFixed(2)}`;
            document.getElementById('eventAnalyticsDaysUntil').textContent = daysUntil > 0 ? `${daysUntil} days` : 'Event has passed';
            document.getElementById('eventAnalyticsBookingRate').textContent = `${event.total_booked || 0}/${event.total_capacity || 0}`;

            // Store current event for management
            window.currentEvent = event;
            
            // Update management title based on event type
            const managementTitle = document.getElementById('eventManagementTitle');
            if (event.type === 'night_club' || event.type === 'day_club') {
                managementTitle.textContent = 'Table Management';
            } else if (event.type === 'restaurant') {
                managementTitle.textContent = 'Section Management';
            } else if (event.type === 'hotel') {
                managementTitle.textContent = 'Room Management';
            } else {
                managementTitle.textContent = 'Management';
            }
            
            // Display event-specific media
            displayEventMedia(event.media || []);
            
            // Display location media
            displayLocationMedia(event.location_id?.media || []);
            
            // Load seats if available
            if (event.seats && event.seats.length > 0) {
                displayEventSeats(event.seats);
            }
        }

        /**
         * Display event seats in grid
         */
        /**
         * Get display price for a seat:
         * - Prefer event-specific price when present
         * - Fall back to per-seat base/min spend
         * - Finally fall back to event-level base price (for legacy data)
         */
        function getSeatDisplayPrice(seat, event) {
            if (typeof seat.event_price === 'number') {
                return seat.event_price;
            }
            if (typeof seat.min_spend === 'number') {
                return seat.min_spend;
            }
            if (typeof seat.base_price === 'number') {
                return seat.base_price;
            }
            return typeof event?.base_price === 'number' ? event.base_price : 0;
        }

        function displayEventSeats(seats) {
            const seatsGrid = document.getElementById('eventSeatsGrid');
            
            if (!seats || seats.length === 0) {
                seatsGrid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#7f8c8d;">No tables available for this event</div>';
                return;
            }

            seatsGrid.innerHTML = seats.map(seat => {
                const status = seat.status || 'available';
                const price = getSeatDisplayPrice(seat, window.currentEvent);
                const currency = window.currentEvent?.currency || 'USD';
                
                return `
                    <div class="seat-card ${status}" onclick="toggleSeatStatus('${seat._id}', '${status}')">
                        <div class="seat-card-header">
                            <span class="seat-code">${seat.code}</span>
                            <span class="seat-status ${status}">${status}</span>
                        </div>
                        <div class="seat-details">
                            <div><strong>${currency} ${price}</strong></div>
                            <div>Capacity: ${seat.capacity || 1}</div>
                            <div>Category: ${seat.category || 'N/A'}</div>
                            ${seat.section ? `<div>Section: ${seat.section}</div>` : ''}
                            ${seat.minSpendUSD ? `<div>Min Spend: $${seat.minSpendUSD}</div>` : ''}
                            ${seat.media && seat.media.length > 0 ? `
                                <div class="seat-media">
                                    ${seat.media.map(media => {
                                        const isVideo = media.type === 'video' || 
                                                       media.url.toLowerCase().includes('.mp4') || 
                                                       media.url.toLowerCase().includes('.mov') ||
                                                       media.url.toLowerCase().includes('.avi') ||
                                                       media.url.toLowerCase().includes('.webm') ||
                                                       media.url.toLowerCase().includes('.mkv');
                                        return `
                                            <img src="${media.url}" alt="${media.alt || 'Table media'}" 
                                                 class="seat-media-thumbnail ${isVideo ? 'video' : ''}"
                                                 onclick="event.stopPropagation(); openMediaModal('${media.url}', '${isVideo ? 'video' : 'image'}')">
                                        `;
                                    }).join('')}
                                </div>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        /**
         * Toggle seat status
         */
        async function toggleSeatStatus(seatId, currentStatus) {
            const statuses = ['available', 'pending', 'held', 'booked', 'blocked'];
            const currentIndex = statuses.indexOf(currentStatus);
            const nextStatus = statuses[(currentIndex + 1) % statuses.length];
            
            if (!confirm(`Change seat status from ${currentStatus} to ${nextStatus}?`)) {
                return;
            }

            try {
                const result = await makeApiRequest(`/events/${window.currentEvent._id}/seats/${seatId}/status`, 'PUT', {
                    status: nextStatus
                });
                
                if (result.success) {
                    showAlert(`Seat status updated to ${nextStatus}`, 'success');
                    // Refresh the event details to get updated data
                    viewEventDetails(window.currentEvent._id);
                } else {
                    showAlert('Failed to update seat status: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error updating seat status:', error);
                showAlert('Error updating seat status: ' + error.message, 'error');
            }
        }

