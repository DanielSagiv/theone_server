        /**
         * Display main location media gallery
         */
        function displayMainLocationMedia(media) {
            const mediaContainer = document.getElementById('mainLocationMedia');
            const noMediaMessage = mediaContainer.querySelector('.no-media-message');
            
            if (media.length === 0) {
                noMediaMessage.style.display = 'block';
                return;
            }
            
            noMediaMessage.style.display = 'none';
            mediaContainer.innerHTML = '';
            
            media.forEach((item, index) => {
                const mediaItem = document.createElement('div');
                mediaItem.className = 'media-item';
                mediaItem.onclick = () => openLightbox(item);
                
                if (item.type === 'image') {
                    mediaItem.innerHTML = `
                        <img src="${item.url}" alt="${item.caption || 'Location image'}" loading="lazy">
                        <div class="media-type-badge">IMG</div>
                        ${item.caption ? `<div class="media-caption">${item.caption}</div>` : ''}
                    `;
                } else if (item.type === 'video') {
                    // Detect video format from URL
                    const videoType = item.url.toLowerCase().includes('.webm') ? 'video/webm' : 
                                    item.url.toLowerCase().includes('.mov') ? 'video/quicktime' :
                                    item.url.toLowerCase().includes('.avi') ? 'video/x-msvideo' :
                                    item.url.toLowerCase().includes('.bin') ? 'video/mp4' : // Handle .bin files as MP4
                                    'video/mp4';
                    
                    console.log('Creating video element:', {
                        url: item.url,
                        type: item.type,
                        videoType: videoType,
                        caption: item.caption
                    });
                    
                    // Test if URL is accessible
                    fetch(item.url, { method: 'HEAD' })
                        .then(response => {
                            console.log('Video URL accessibility test:', {
                                url: item.url,
                                status: response.status,
                                contentType: response.headers.get('content-type')
                            });
                        })
                        .catch(err => {
                            console.error('Video URL accessibility error:', err);
                        });
                    
                    // Test video element after it's created
                    setTimeout(() => {
                        const video = mediaItem.querySelector('video');
                        if (video) {
                            console.log('Video element test:', {
                                src: video.src,
                                currentSrc: video.currentSrc,
                                networkState: video.networkState,
                                readyState: video.readyState,
                                error: video.error,
                                canPlayType: {
                                    'video/mp4': video.canPlayType('video/mp4'),
                                    'video/webm': video.canPlayType('video/webm'),
                                    'video/quicktime': video.canPlayType('video/quicktime')
                                }
                            });
                            
                            // Try to load the video
                            video.load();
                            
                            // Test if we can play it
                            video.play().then(() => {
                                console.log('Video can play successfully');
                                video.pause();
                            }).catch(err => {
                                console.error('Video play failed:', err);
                            });
                        }
                    }, 100);
                    
                    mediaItem.innerHTML = `
                        <video preload="metadata" controls muted playsinline 
                               onerror="console.error('Video load error:', this.error, 'Network state:', this.networkState, 'Ready state:', this.readyState)" 
                               onloadstart="console.log('Video loading started:', this.src)"
                               oncanplay="console.log('Video can play:', this.src)"
                               onloadeddata="console.log('Video data loaded:', this.src)"
                               onloadedmetadata="console.log('Video metadata loaded:', this.src, 'Duration:', this.duration, 'Video dimensions:', this.videoWidth + 'x' + this.videoHeight)"
                               onclick="this.play(); event.stopPropagation();">
                            <source src="${item.url}" type="${videoType}">
                            Your browser does not support the video tag.
                        </video>
                        <div class="media-type-badge">VID</div>
                        <div style="position: absolute; top: 5px; left: 5px; background: rgba(0,0,0,0.7); color: white; padding: 2px 5px; font-size: 10px; border-radius: 3px;">
                            <a href="${item.url}" target="_blank" style="color: white; text-decoration: none;">Test Direct</a>
                        </div>
                        ${item.caption ? `<div class="media-caption">${item.caption}</div>` : ''}
                    `;
                }
                
                mediaContainer.appendChild(mediaItem);
            });
        }

