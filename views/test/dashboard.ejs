                                </span>
                                <span class="coe-menu-item-text">Pay</span>
                            </button>
                        </div>
                    </div>
                </div>
            `;

            // Attach event listeners to action buttons
            card.querySelectorAll('.coe-action-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const action = btn.dataset.action;
                    const coeId = btn.dataset.coeId;
                    const needsConfirm = btn.dataset.confirm === 'true';
                    
                    if (needsConfirm && !confirm(`Are you sure you want to ${btn.textContent.toLowerCase()} this COE?`)) {
                        return;
                    }
                    
                    handleCOEAction(action, coeId);
                });
            });

            // Attach event listeners to menu button
            const menuButton = card.querySelector('.coe-menu-button');
            const contextMenu = card.querySelector('.coe-context-menu');
            
            if (menuButton && contextMenu) {
                // Toggle menu on button click
                menuButton.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isActive = menuButton.classList.contains('active');
                    
                    // Close all other menus first
                    document.querySelectorAll('.coe-menu-button.active').forEach(btn => {
                        if (btn !== menuButton) {
                            btn.classList.remove('active');
                            btn.closest('.coe-card-menu-container, .coe-list-item-menu-container')
                                ?.querySelector('.coe-context-menu')?.classList.remove('show');
                        }
                    });
                    
                    // Toggle current menu
                    menuButton.classList.toggle('active');
                    contextMenu.classList.toggle('show');
                });
                
                // Handle menu item clicks
                contextMenu.querySelectorAll('.coe-menu-item').forEach(item => {
                    item.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const action = item.dataset.action;
                        const coeId = item.dataset.coeId;
                        
                        // Close menu
                        menuButton.classList.remove('active');
                        contextMenu.classList.remove('show');
                        
                        // Handle actions
                        if (action === 'chat-runner') {
                            console.log(`Chat with runner for COE ${coeId}`);
                            showAlert('Chat with runner functionality coming soon', 'info');
                        } else if (action === 'chat-the1') {
                            console.log(`Chat with The1 for COE ${coeId}`);
                            showAlert('Chat with The1 functionality coming soon', 'info');
                        } else if (action === 'edit') {
                            handleCOEAction('edit_coe', coeId);
                        } else if (action === 'pay') {
                            console.log(`Pay for COE ${coeId}`);
                            showAlert('Payment functionality coming soon', 'info');
                        }
                    });
                });
            }

            // Initialize carousel touch support for all seat carousels
            card.querySelectorAll('.coe-seat-carousel-container').forEach(carousel => {
                // Initialize current index to 0
                carousel.dataset.currentIndex = '0';
                initSeatCarouselTouch(carousel);
                // Initialize button states
                const track = carousel.querySelector('.coe-seat-carousel-track');
                const slides = carousel.querySelectorAll('.coe-seat-carousel-slide');
                const prevBtn = carousel.querySelector('.coe-seat-carousel-prev');
                const nextBtn = carousel.querySelector('.coe-seat-carousel-next');
                const controls = carousel.querySelector('.coe-seat-carousel-controls');
                
                if (slides.length > 0) {
                    // Ensure track starts at position 0
                    if (track) {
                        track.style.transform = 'translateX(0%)';
                    }
                    
                    // Show/hide controls based on slide count
                    if (controls) {
                        controls.style.display = slides.length > 1 ? 'flex' : 'none';
                    }
                    
                    // Initialize button states
                    if (prevBtn) prevBtn.disabled = true; // First slide
                    if (nextBtn) nextBtn.disabled = slides.length === 1;
                }
                
                console.log('[CAROUSEL_INIT] Initialized carousel:', {
                    eventGroupId: carousel.dataset.eventGroupId,
                    slidesCount: slides.length,
                    hasControls: !!controls,
                    controlsDisplay: controls?.style.display
                });
            });

            return card;
        }

        /**
         * Render event list
         */
        function renderEventList(events) {
            const container = document.createElement('div');
            container.className = 'bot-structured-card bot-event-list';

            if (events.length === 0) {
                container.innerHTML = '<p class="bot-empty-message">No events found.</p>';
                return container;
            }

            const eventsHtml = events.map(event => {
                const eventDate = event.start_datetime 
                    ? new Date(event.start_datetime).toLocaleDateString()
                    : 'Date TBD';
                const locationName = event.location?.name || 'Location TBD';
                
                // Format address
                let addressText = 'Address TBD';
                if (event.location?.address) {
                    const addr = event.location.address;
                    const parts = [];
                    if (addr.line1) parts.push(addr.line1);
                    if (addr.line2) parts.push(addr.line2);
                    if (addr.city) parts.push(addr.city);
                    if (addr.state) parts.push(addr.state);
                    if (addr.postalCode) parts.push(addr.postalCode);
                    if (addr.country) parts.push(addr.country);
                    if (parts.length > 0) {
                        addressText = parts.join(', ');
                    }
                }
                
                // Create map link from geo coordinates
                let mapLink = null;
                if (event.location?.geo && event.location.geo.coordinates && event.location.geo.coordinates.length >= 2) {
                    const [longitude, latitude] = event.location.geo.coordinates;
                    mapLink = `https://www.google.com/maps?q=${latitude},${longitude}`;
                }
                
                return `
                    <div class="bot-event-item">
                        <div class="event-item-header">
                            <h5 class="event-item-title">${event.name || 'Untitled Event'}</h5>
                            <span class="event-item-type">${event.type || 'event'}</span>
                        </div>
                        <div class="event-item-details">
                            <div class="event-detail">
                                <span class="event-detail-label">Date:</span>
                                <span class="event-detail-value">${eventDate}</span>
                            </div>
                            <div class="event-detail">
                                <span class="event-detail-label">Location:</span>
                                <span class="event-detail-value">${locationName}</span>
                            </div>
                            <div class="event-detail">
                                <span class="event-detail-label">Address:</span>
                                <span class="event-detail-value">${addressText}${mapLink ? ` <a href="${mapLink}" target="_blank" class="event-map-link" title="View on map"><svg class="event-map-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>View Map</a>` : ''}</span>
                            </div>
                            <div class="event-detail">
                                <span class="event-detail-label">Price:</span>
                                <span class="event-detail-value">${event.currency || 'USD'} ${(event.base_price || 0).toLocaleString()}</span>
                            </div>
                            <div class="event-detail">
                                <span class="event-detail-label">Available Tables:</span>
                                <span class="event-detail-value">${event.available_seats_count || 0}</span>
                            </div>
                        </div>
                        ${(() => {
                            const eventSeats = event.seats || [];
                            if (!Array.isArray(eventSeats) || eventSeats.length === 0) return '';
                            
                            // Group by section (fallback to category, then 'Other')
                            const seatsBySection = {};
                            eventSeats.forEach(seat => {
                                const section = seat.section || seat.category || 'Other';
                                if (!seatsBySection[section]) seatsBySection[section] = [];
                                seatsBySection[section].push(seat);
                            });
                            
                            const sectionBlocks = Object.entries(seatsBySection).map(([section, seats]) => {
                                const seatItemsHtml = seats.map(seat => {
                                    const images = (seat.media || []).filter(m => m && m.type === 'image');
                                    const mediaHtml = images.length > 0 ? `
                                        <div class="location-seat-media">
                                            ${images.slice(0, 4).map(m => `
                                                <img src="${m.url}"
                                                     alt="${m.caption || seat.code || 'Seat image'}"
                                                     class="location-seat-media-thumbnail"
                                                     onclick="openLightbox(${JSON.stringify(m).replace(/"/g, '&quot;')})"
                                                     loading="lazy">
                                            `).join('')}
                                            ${images.length > 4 ? `
                                                <div class="location-seat-media-thumbnail" style="display:flex;align-items:center;justify-content:center;background:rgba(30,41,59,0.8);color:#cbd5f5;font-size:0.7rem;">
                                                    +${images.length - 4}
                                                </div>
                                            ` : ''}
                                        </div>
                                    ` : `<div class="location-seat-media" style="color:#94a3b8;font-size:0.75rem;font-style:italic;">No images available</div>`;
                                    
                                    return `
                                        <div class="location-seat-item">
                                            <div class="location-seat-header">
                                                <div class="location-seat-code">Table ${seat.code || 'N/A'}</div>
                                                ${seat.capacity ? `<div class="location-seat-capacity">${seat.capacity} ppl</div>` : ''}
                                            </div>
                                            <div class="location-seat-details">
                                                ${seat.event_price ? `<div class="location-seat-detail"><span class="location-seat-label">Event Price:</span> $${seat.event_price}</div>` : ''}
                                                ${seat.min_spend ? `<div class="location-seat-detail"><span class="location-seat-label">Min Spend:</span> $${seat.min_spend}</div>` : ''}
                                                ${seat.status ? `<div class="location-seat-detail"><span class="location-seat-label">Status:</span> ${seat.status}</div>` : ''}
                                            </div>
                                            ${mediaHtml}
                                        </div>
                                    `;
                                }).join('');
                                
                                return `
                                    <div class="location-seat-category">
                                        <div class="location-seat-category-header" onclick="toggleEventSeatSection(this)">
                                            <span class="location-seat-category-title">${section}</span>
                                            <span class="expand-icon">▼</span>
                                        </div>
                                        <div class="location-seat-category-content">
                                            ${seatItemsHtml}
                                        </div>
                                    </div>
                                `;
                            }).join('');
                            
                            return `
                                <div class="location-seats-section">
                                    <button class="location-seats-toggle" onclick="toggleEventSeats(this)">
                                        <span>View Seats (${eventSeats.length})</span>
                                        <span class="expand-icon">▼</span>
                                    </button>
                                    <div class="location-seats-content">
                                        ${sectionBlocks}
                                    </div>
                                </div>
                            `;
                        })()}
                    </div>
                `;
            }).join('');

            container.innerHTML = `
                <div class="event-list-header">
                    <h4>Events (${events.length})</h4>
                </div>
                <div class="event-list-items">
                    ${eventsHtml}
                </div>
            `;

            return container;
        }

        /**
         * Render Create COE form for admin-selected client
         * @param {Object} formData - Structured data with client and defaults
         * @returns {HTMLElement} Form card element
         */
        function renderCOECreateForm(formData) {
            const container = document.createElement('div');
            container.className = 'bot-structured-card bot-coe-create-form';

            const client = formData.client || {};
            const defaults = formData.defaults || {};
            const message = formData.message || 'Create a new COE draft for this client.';

            const today = new Date().toISOString().split('T')[0];

            container.innerHTML = `
                <div class="coe-preferences-form-header">
                    <h3 style="margin: 0; color: #cbd5f5; font-size: 1.1rem;">Create COE for Client</h3>
                    <p style="margin: 4px 0 0 0; color: #94a3b8; font-size: 0.9rem;">${message}</p>
                </div>
                <div class="coe-create-client-summary">
                    <div class="coe-create-client-name">${client.name || 'Unknown Client'}</div>
                    <div class="coe-create-client-email">${client.email || ''}</div>
                    ${client.phone ? `<div class="coe-create-client-phone">${client.phone}</div>` : ''}
                </div>
                <form class="coe-preferences-form" onsubmit="handleSubmitCOECreateForm(event, '${client.id}')">
                    <div class="coe-preferences-field-group">
                        <div class="coe-preferences-field">
                            <label for="coe_create_start_date">Start Date <span class="required">*</span></label>
                            <input 
                                id="coe_create_start_date"
                                name="start_date"
                                type="date"
                                required
                                min="${today}"
                                class="coe-preferences-input"
                            >
                        </div>
                        <div class="coe-preferences-field">
                            <label for="coe_create_end_date">End Date <span class="required">*</span></label>
                            <input 
                                id="coe_create_end_date"
                                name="end_date"
                                type="date"
                                required
                                min="${today}"
                                class="coe-preferences-input"
                            >
                        </div>
                    </div>
                    <div class="coe-preferences-field">
                        <label for="coe_create_city">City <span class="required">*</span></label>
                        <select 
                            id="coe_create_city" 
                            name="city" 
                            required
                            class="coe-preferences-input"
                        >
                            <option value="">Select a city (choose dates first)</option>
                        </select>
                        <div id="coe_create_city_loading" style="display: none; color: #94a3b8; font-size: 0.85rem; margin-top: 4px;">
                            Loading cities...
                        </div>
                        <div id="coe_create_city_error" style="display: none; color: #ef4444; font-size: 0.85rem; margin-top: 4px;"></div>
                    </div>
                    <div class="coe-preferences-field-group">
                        <div class="coe-preferences-field">
                            <label for="coe_create_budget">Budget</label>
                            <input 
                                id="coe_create_budget"
                                name="budget"
                                type="number"
                                min="0"
                                step="1"
                                placeholder="Enter total budget"
                                class="coe-preferences-input"
                            >
                        </div>
                        <div class="coe-preferences-field">
                            <label for="coe_create_party_size">Number of People</label>
                            <input 
                                id="coe_create_party_size"
                                name="party_size"
                                type="number"
                                min="1"
                                step="1"
                                placeholder="e.g. 8"
                                class="coe-preferences-input"
                            >
                        </div>
                    </div>
                    <div class="coe-preferences-field">
                        <label for="coe_create_notes">Notes (optional)</label>
                        <textarea
                            id="coe_create_notes"
                            name="notes"
                            rows="3"
                            class="coe-preferences-textarea"
                            placeholder="Any additional context or preferences for this client..."
                        ></textarea>
                    </div>
                    <div class="coe-preferences-form-actions" style="justify-content: flex-start;">
                        <button type="submit" class="btn btn-primary">
                            Create COE
                        </button>
                    </div>
                </form>
            `;

            // Set up date change listeners to load cities based on date range
            const startDateInput = container.querySelector('#coe_create_start_date');
            const endDateInput = container.querySelector('#coe_create_end_date');
            const citySelect = container.querySelector('#coe_create_city');
            const cityLoading = container.querySelector('#coe_create_city_loading');
            const cityError = container.querySelector('#coe_create_city_error');

            const loadCitiesForDateRange = async () => {
                const startDate = startDateInput?.value;
                const endDate = endDateInput?.value;

                // Clear city selection and error when dates change
                if (citySelect) {
                    citySelect.value = '';
                    citySelect.innerHTML = '<option value="">Select a city (choose dates first)</option>';
                }
                if (cityError) {
                    cityError.style.display = 'none';
                    cityError.textContent = '';
                }

                // Only load cities if both dates are selected
                if (!startDate || !endDate) {
                    return;
                }

                // Validate date range
                if (new Date(startDate) > new Date(endDate)) {
                    if (cityError) {
                        cityError.textContent = 'End date must be on or after start date';
                        cityError.style.display = 'block';
                    }
                    return;
                }

                // Show loading state
                if (cityLoading) cityLoading.style.display = 'block';
                if (cityError) cityError.style.display = 'none';

                try {
                    // Fetch events for the date range to get cities with available events
                    // Use same pagination pattern as loadEventsForCOE to get all events
                    const params = new URLSearchParams();
                    if (startDate && endDate) {
                        params.set('coe_start_date', startDate);
                        params.set('coe_end_date', endDate);
                    }
                    params.set('status', 'active');

                    // Fetch all pages (like loadEventsForCOE does)
                    let page = 1;
                    const limit = 100;
                    let pages = 1;
                    const combined = [];

                    do {
                        params.set('page', String(page));
                        params.set('limit', String(limit));
                        const apiUrl = `/events?${params.toString()}`;
                        console.log('[COE CREATE FORM] Fetching events from:', apiUrl);
                        const result = await makeApiRequest(apiUrl);
                        
                        console.log('[COE CREATE FORM] API request result (page ' + page + '):', {
                            success: result.success,
                            status: result.status,
                            hasData: !!result.data,
                            dataType: typeof result.data,
                            isArray: Array.isArray(result.data),
                            dataKeys: result.data ? Object.keys(result.data) : null,
                            rawData: result.data,
                            pagination: result.pagination || result.data?.pagination
                        });
                        
                        if (!result.success || !result.data) {
                            console.warn('[COE CREATE FORM] Request failed or no data for page', page, result);
                            break;
                        }
                        
                        // Use the same pattern as loadEventsForCOE (line 16692)
                        const batch = Array.isArray(result.data) ? result.data : (result.data.data || []);
                        console.log('[COE CREATE FORM] Batch size:', batch.length, 'Combined so far:', combined.length);
                        if (batch.length > 0) {
                            console.log('[COE CREATE FORM] First event in batch:', {
                                name: batch[0].name,
                                start: batch[0].start_datetime,
                                location: batch[0].location_id
                            });
                        }
                        combined.push(...batch);
                        
                        const pagination = result.pagination || result.data?.pagination || {};
                        pages = parseInt(pagination.pages || '1');
                        page += 1;
                    } while (page <= pages);

                    const eventsArray = combined;
                    
                    console.log('[COE CREATE FORM] Final loaded events:', {
                        totalEvents: eventsArray.length,
                        firstEventSample: eventsArray[0] ? {
                            name: eventsArray[0].name,
                            hasLocation: !!eventsArray[0].location_id,
                            locationIdType: typeof eventsArray[0].location_id,
                            locationIdKeys: eventsArray[0].location_id ? Object.keys(eventsArray[0].location_id) : null,
                            address: eventsArray[0].location_id?.address,
                            city: eventsArray[0].location_id?.address?.city
                        } : 'No events'
                    });

                    if (cityLoading) cityLoading.style.display = 'none';

                    if (eventsArray.length > 0) {
                        // Extract unique cities from events
                        const citiesSet = new Set();
                        eventsArray.forEach(event => {
                            const city = event.location_id?.address?.city;
                            if (city && typeof city === 'string') {
                                citiesSet.add(city);
                            }
                        });

                        const cities = Array.from(citiesSet).sort();
                        
                        console.log('[COE CREATE FORM] Extracted cities:', cities);

                        // Populate city dropdown
                        if (citySelect) {
                            citySelect.innerHTML = '<option value="">Select a city</option>';
                            if (cities.length > 0) {
                                cities.forEach(city => {
                                    const option = document.createElement('option');
                                    option.value = city;
                                    option.textContent = city;
                                    citySelect.appendChild(option);
                                });
                            } else {
                                const option = document.createElement('option');
                                option.value = '';
                                option.textContent = 'No cities with events in this date range';
                                option.disabled = true;
                                citySelect.appendChild(option);
                                if (cityError) {
                                    cityError.textContent = 'No events found for the selected date range. Please choose different dates.';
                                    cityError.style.display = 'block';
                                }
                            }
                        }
                    } else {
                        // No events found
                        console.warn('[COE CREATE FORM] No events found for date range:', { startDate, endDate });
                        if (citySelect) {
                            citySelect.innerHTML = '<option value="">No cities with events in this date range</option>';
                            const option = citySelect.querySelector('option');
                            if (option) option.disabled = true;
                        }
                        if (cityError) {
                            cityError.textContent = 'No events found for the selected date range. Please choose different dates.';
                            cityError.style.display = 'block';
                        }
                    }
                } catch (error) {
                    console.error('[COE CREATE FORM] Error loading cities:', error);
                    if (cityLoading) cityLoading.style.display = 'none';
                    if (cityError) {
                        cityError.textContent = 'Error loading cities: ' + (error.message || 'Please try again.');
                        cityError.style.display = 'block';
                    }
                }
            };

            // Add change listeners to date inputs
            if (startDateInput) {
                startDateInput.addEventListener('change', loadCitiesForDateRange);
            }
            if (endDateInput) {
                endDateInput.addEventListener('change', loadCitiesForDateRange);
            }

            // If dates are already set (from defaults), load cities immediately
            if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                loadCitiesForDateRange();
            }

            return container;
        }

        /**
         * Handle submit of Create COE form (admin for client)
         */
        async function handleSubmitCOECreateForm(event, clientId) {
            console.log('[COE CREATE FORM] ===== FORM SUBMIT CLICKED =====');
            console.log('[COE CREATE FORM] Client ID:', clientId);
            
            event.preventDefault();
            const form = event.target;
            const startDate = form.querySelector('#coe_create_start_date')?.value;
            const endDate = form.querySelector('#coe_create_end_date')?.value;
            const cityVal = form.querySelector('#coe_create_city')?.value;
            const budgetVal = form.querySelector('#coe_create_budget')?.value;
            const partySizeVal = form.querySelector('#coe_create_party_size')?.value;
            const notes = form.querySelector('#coe_create_notes')?.value || '';
            
            console.log('[COE CREATE FORM] Form values:', { startDate, endDate, cityVal, budgetVal, partySizeVal, notes });

            if (!startDate || !endDate) {
                showAlert('Start date and End date are required.', 'error');
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                showAlert('End date must be on or after start date.', 'error');
                return;
            }

            if (!cityVal || !cityVal.trim()) {
                showAlert('City is required. Please select a city with available events for the selected date range.', 'error');
                return;
            }

            // Validate that events exist for the selected city and date range
            try {
                const params = new URLSearchParams({
                    coe_start_date: startDate,
                    coe_end_date: endDate,
                    status: 'active',
                    limit: '100'
                });

                const result = await makeApiRequest(`/events?${params.toString()}`);
                
                // Handle API response structure: result.data.data or result.data
                const eventsArray = Array.isArray(result.data) ? result.data : (result.data?.data || []);
                
                if (result.success && eventsArray.length > 0) {
                    // Check if any event has the selected city
                    const hasCityEvent = eventsArray.some(event => {
                        const eventCity = event.location_id?.address?.city;
                        return eventCity && eventCity.toLowerCase() === cityVal.toLowerCase();
                    });

                    if (!hasCityEvent) {
                        showAlert(`No events found in ${cityVal} for the selected date range. Please choose a different city or date range.`, 'error');
                        return;
                    }
                } else {
                    showAlert('Unable to validate events. Please try again.', 'error');
                    return;
                }
            } catch (error) {
                console.error('[COE CREATE FORM] Error validating events:', error);
                showAlert('Error validating events. Please try again.', 'error');
                return;
            }

            const parts = [];
            parts.push(`Client ID: ${clientId}`);
            parts.push(`Start date: ${startDate}`);
            parts.push(`End date: ${endDate}`);
            parts.push(`City: ${cityVal}`);
            if (budgetVal) parts.push(`Budget: $${budgetVal} USD`);
            if (partySizeVal) parts.push(`Number of people: ${partySizeVal}`);
            if (notes) parts.push(`Notes: ${notes}`);

            const promptInput = document.getElementById('botPromptInput');
            if (!promptInput) {
                console.error('[COE CREATE FORM] botPromptInput not found');
                return;
            }

            // Structured prompt so bot can call create_coe_draft with explicit client_id
            // Use the same format as mobile app for consistency
            const prompt = `Build my experience with the following preferences:\n${parts.join('\n')}`;
            console.log('[COE CREATE FORM] Sending prompt:', prompt);
            promptInput.value = prompt;
            sendBotPrompt();
        }

