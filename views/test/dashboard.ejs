                                    media.url.toLowerCase().includes('.avi') ? 'video/x-msvideo' :
                                    media.url.toLowerCase().includes('.bin') ? 'video/mp4' : // Handle .bin files as MP4
                                    'video/mp4';
                    
                    return `<div class="media-item" onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})">
