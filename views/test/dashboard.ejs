            overflow: hidden;
            position: relative;
            min-height: 200px;
        }
        
        .upgrade-offer-comparison .coe-seat-carousel-track {
            display: flex;
            transition: transform 0.3s ease;
            transform: translateX(0%) !important;
            width: 100%;
