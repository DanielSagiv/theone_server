        /**
         * Slide seat carousel
         * @param {HTMLElement} button - The navigation button clicked
         * @param {number} direction - -1 for previous, 1 for next
         */
        function slideSeatCarousel(button, direction) {
            const container = button.closest('.coe-seat-carousel-container');
            if (!container) return;

            const track = container.querySelector('.coe-seat-carousel-track');
            const slides = container.querySelectorAll('.coe-seat-carousel-slide');
            const dots = container.querySelectorAll('.coe-seat-carousel-dot');
            
            if (!track || slides.length === 0) return;

            // Get current index from data attribute (more reliable than DOM calculation)
            let currentIndex = parseInt(container.dataset.currentIndex || '0', 10);
            if (isNaN(currentIndex) || currentIndex < 0) currentIndex = 0;
            if (currentIndex >= slides.length) currentIndex = slides.length - 1;

            let newIndex = currentIndex + direction;
            if (newIndex < 0) newIndex = slides.length - 1;
            if (newIndex >= slides.length) newIndex = 0;

            // Use the container to find the correct dot
            goToSeatSlide(dots[newIndex] || null, newIndex);
        }

        /**
         * Go to specific seat slide
         * @param {HTMLElement} dot - The dot button clicked (or null to use index)
         * @param {number} index - The slide index to go to
         */
        function goToSeatSlide(dot, index) {
            const container = dot ? dot.closest('.coe-seat-carousel-container') : null;
            if (!container) {
                // If no container found from dot, try to find it from the button's context
                console.warn('[CAROUSEL] Container not found for goToSeatSlide, trying alternative method');
                // Try to find container from event target if dot is null
                if (index !== undefined) {
                    // This is called from slideSeatCarousel, container should be available
                    return;
                }
                return;
            }

            const track = container.querySelector('.coe-seat-carousel-track');
            const slides = container.querySelectorAll('.coe-seat-carousel-slide');
            const dots = container.querySelectorAll('.coe-seat-carousel-dot');
            const prevBtn = container.querySelector('.coe-seat-carousel-prev');
            const nextBtn = container.querySelector('.coe-seat-carousel-next');

            if (!track || slides.length === 0) return;

            // Determine target index
            let targetIndex;
            if (index !== undefined) {
                targetIndex = index;
            } else if (dot) {
                targetIndex = Array.from(dots).indexOf(dot);
            } else {
                targetIndex = parseInt(container.dataset.currentIndex || '0', 10);
            }
            
            if (targetIndex < 0 || targetIndex >= slides.length) {
                console.warn('[CAROUSEL] Invalid target index:', targetIndex, 'slides:', slides.length);
                return;
            }

            // Store current index in data attribute for reliable state tracking
            container.dataset.currentIndex = targetIndex.toString();

            // Use percentage-based transform (consistent with CSS)
            track.style.transform = `translateX(-${targetIndex * 100}%)`;

            // Update dots
            dots.forEach((d, i) => {
                d.classList.toggle('active', i === targetIndex);
            });

            // Update button states
            if (prevBtn) prevBtn.disabled = targetIndex === 0;
            if (nextBtn) nextBtn.disabled = targetIndex === slides.length - 1;
        }

        /**
         * Initialize touch/swipe support for seat carousel
         */
        function initSeatCarouselTouch(carouselContainer) {
            let startX = 0;
            let currentX = 0;
            let isDragging = false;
            let currentIndex = 0;
            let startTransform = 0;

            const track = carouselContainer.querySelector('.coe-seat-carousel-track');
            const wrapper = carouselContainer.querySelector('.coe-seat-carousel-wrapper');
            const slides = carouselContainer.querySelectorAll('.coe-seat-carousel-slide');
            if (!track || !wrapper || slides.length === 0) return;

            // Get current index from data attribute (more reliable)
            const getCurrentIndex = () => {
                const stored = parseInt(carouselContainer.dataset.currentIndex || '0', 10);
                if (!isNaN(stored) && stored >= 0 && stored < slides.length) {
                    return stored;
                }
                // Fallback to active dot
                const dots = carouselContainer.querySelectorAll('.coe-seat-carousel-dot');
                const activeDot = Array.from(dots).find(d => d.classList.contains('active'));
                return activeDot ? Array.from(dots).indexOf(activeDot) : 0;
            };

            carouselContainer.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                currentX = startX;
                isDragging = true;
                currentIndex = getCurrentIndex();
                // Store the starting transform value (in percentage)
                startTransform = currentIndex * 100;
                track.style.transition = 'none'; // Disable transition during drag
            }, { passive: true });

            carouselContainer.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                currentX = e.touches[0].clientX;
                const diff = startX - currentX;
                
                // Get wrapper width (single slide width)
                const wrapperRect = wrapper.getBoundingClientRect();
                const slideWidth = wrapperRect.width;
                
                // Calculate drag offset as percentage
                const dragPercent = (diff / slideWidth) * 100;
                const newTransform = startTransform - dragPercent;
                
                // Clamp to valid range (0% to (slides.length - 1) * 100%)
                const minTransform = 0;
                const maxTransform = (slides.length - 1) * 100;
                const clampedTransform = Math.max(minTransform, Math.min(maxTransform, newTransform));
                
                track.style.transform = `translateX(-${clampedTransform}%)`;
            }, { passive: true });

            carouselContainer.addEventListener('touchend', () => {
                if (!isDragging) return;
                isDragging = false;
                
                const diff = startX - currentX;
                const threshold = 50; // Minimum swipe distance in pixels
                
                // Re-enable transition
                track.style.transition = '';
                
                if (Math.abs(diff) > threshold) {
                    if (diff > 0) {
                        // Swipe left - next
                        const nextBtn = carouselContainer.querySelector('.coe-seat-carousel-next');
                        if (nextBtn && !nextBtn.disabled) {
                            slideSeatCarousel(nextBtn, 1);
                        } else {
                            // Snap back to current
                            goToSeatSlide(null, currentIndex);
                        }
                    } else {
                        // Swipe right - previous
                        const prevBtn = carouselContainer.querySelector('.coe-seat-carousel-prev');
                        if (prevBtn && !prevBtn.disabled) {
                            slideSeatCarousel(prevBtn, -1);
                        } else {
                            // Snap back to current
                            goToSeatSlide(null, currentIndex);
                        }
                    }
                } else {
                    // Snap back to current position
                    goToSeatSlide(null, currentIndex);
                }
            }, { passive: true });
        }

