        // ===== Edit Location Functions =====
        let currentEditLocation = null;
        let el_currentStep = 1;

        /**
         * Open edit location modal
         */
        async function openEditLocationModal() {
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can edit locations', 'error');
                return;
            }

            if (!currentLocationId) {
                showAlert('No location selected', 'error');
                return;
            }

            try {
                // Fetch current location data
                const result = await makeApiRequest(`/locations/${currentLocationId}`);
                if (!result.success) {
                    showAlert('Failed to load location data', 'error');
                    return;
                }

                // Extract location data (handle nested response structure)
                const locationData = result.data?.data || result.data;
                currentEditLocation = locationData;
                el_currentStep = 1;
                
                // Populate form with current data
                populateEditForm(locationData);
                
                // Show modal
                document.getElementById('editLocationModal').style.display = 'flex';
                el_showStep(1);
                
            } catch (error) {
                console.error('Error opening edit modal:', error);
                showAlert('Error loading location data: ' + error.message, 'error');
