        async function submitAdminAdhocPayment() {
            try {
                const coeId = document.getElementById('adhocCoeId').value.trim();
                const amount = parseFloat(document.getElementById('adhocAmount').value);
                const description = document.getElementById('adhocDescription').value.trim();
                const chargeMethod = document.getElementById('adhocChargeMethod').value;
                if (!coeId || !amount || amount <= 0 || !description) {
                    showAlert('COE ID, amount, and description are required', 'error');
