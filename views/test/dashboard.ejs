        function selectRefundAmount(amount) {
            document.getElementById('refundAmount').value = amount;
            document.getElementById('processRefundBtn').disabled = false;
        }

        /**
         * Process COE refund
         */
        async function processCOERefund(coeId) {
            const refundAmount = parseFloat(document.getElementById('refundAmount').value);
            const refundReason = document.getElementById('refundReason').value.trim();

            if (!refundAmount || refundAmount <= 0) {
                showAlert('Please enter a valid refund amount', 'error');
                return;
            }

            if (!refundReason) {
                showAlert('Please enter a refund reason', 'error');
                return;
            }

            try {
                showAlert('Processing refund...', 'info');
                
                const result = await makeApiRequest(`/coes/${coeId}/payments/refund`, 'POST', {
                    refund_amount: refundAmount,
                    reason: refundReason
                });

                if (result.success) {
                    showAlert('Refund processed successfully!', 'success');
                    closeCOERefundModal();
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Refund failed: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error processing COE refund:', error);
                showAlert('Refund failed: ' + error.message, 'error');
            }
        }

        /**
         * Display price history based on user role
         */
        function displayPriceHistory(eventId, tableId) {
            if (currentUser?.role === 'admin') {
                // Admin sees all price history
                showAdminPriceHistory(eventId, tableId);
            } else if (currentUser?.role === 'client') {
                // Client sees only beneficial price changes
                showClientPriceHistory(eventId, tableId);
            }
            // Runners don't see price history
        }

        /**
         * Show admin price history (all changes)
         */
        async function showAdminPriceHistory(eventId, tableId) {
            try {
                const result = await makeApiRequest(`/events/${eventId}/pricing/history`);
                
                const allHistory = result.data.pricing_history;
                const tableHistory = allHistory.filter(h => h.table_id === tableId);
                
                const historyHtml = tableHistory.map(history => `
                    <div class="price-history-item">
                        <div class="price-change">
                            <span class="previous-price">$${history.previous_price}</span>
                            <span class="arrow">→</span>
                            <span class="new-price">$${history.new_price}</span>
                        </div>
                        <div class="change-details">
                            <div class="reason">${history.change_reason}</div>
                            <div class="changed-by">by ${history.changed_by.firstName} ${history.changed_by.lastName}</div>
                            <div class="changed-at">${new Date(history.changed_at).toLocaleDateString()}</div>
                        </div>
                    </div>
                `).join('');
                
                showPriceHistoryModal('Admin Price History', historyHtml);
            } catch (error) {
                console.error('Error loading admin price history:', error);
                showAlert('Failed to load price history', 'error');
            }
        }

        /**
         * Show client price history (only beneficial changes)
         */
        async function showClientPriceHistory(eventId, tableId) {
            try {
                const result = await makeApiRequest(`/events/${eventId}/pricing/history`);
                
                const filteredHistory = result.data.pricing_history;
                const tableHistory = filteredHistory.filter(h => h.table_id === tableId);
                
                if (tableHistory.length === 0) {
                    showPriceHistoryModal('Price History', '<p>No price reductions available.</p>');
                    return;
                }
                
                const historyHtml = tableHistory.map(history => `
                    <div class="price-history-item beneficial">
                        <div class="price-change">
                            <span class="previous-price">$${history.previous_price}</span>
                            <span class="arrow down">↓</span>
                            <span class="new-price">$${history.new_price}</span>
                            <span class="savings">You save $${history.previous_price - history.new_price}!</span>
                        </div>
                        <div class="change-details">
                            <div class="reason">${history.change_reason}</div>
                            <div class="changed-at">${new Date(history.changed_at).toLocaleDateString()}</div>
                        </div>
                    </div>
                `).join('');
                
                showPriceHistoryModal('Price Reductions', historyHtml);
            } catch (error) {
                console.error('Error loading client price history:', error);
                showAlert('Failed to load price history', 'error');
            }
