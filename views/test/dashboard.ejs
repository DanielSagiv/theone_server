            const existingModal = document.getElementById('coverageModal');
            if (existingModal) {
                existingModal.remove();
            }

            // Add modal to page
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        /**
         * Close coverage modal
         */
        function closeCoverageModal() {
            const modal = document.getElementById('coverageModal');
            if (modal) {
                modal.remove();
            }
        }

        /**
         * Update COE coverage amount
         */
        async function updateCoverage(coeId) {
            try {
                const amountInput = document.getElementById('coverageAmount');
                const amount = parseFloat(amountInput.value);

                if (isNaN(amount) || amount < 0) {
                    showAlert('Please enter a valid amount', 'error');
                    return;
                }

                showAlert('Updating coverage...', 'info');

                const result = await makeApiRequest(`/coes/${coeId}/covered-amount`, 'PUT', {
                    amount: amount
                });

                if (result.success) {
                    showAlert('Coverage updated successfully!', 'success');
                    closeCoverageModal();
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Failed to update coverage: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error updating coverage:', error);
                showAlert('Failed to update coverage: ' + error.message, 'error');
            }
        }

        /**
         * Set COE as fully covered
         */
        async function setFullCoverage(coeId, total) {
            try {
                const confirmed = confirm(`Set this COE as fully covered for $${total.toLocaleString()}?`);
                
                if (!confirmed) {
                    return;
                }

                showAlert('Setting full coverage...', 'info');

                const result = await makeApiRequest(`/coes/${coeId}/covered-all`, 'PUT');

                if (result.success) {
                    showAlert('COE set as fully covered!', 'success');
                    closeViewCOE();
                    loadCOEs(); // Refresh COE list
                } else {
                    showAlert('Failed to set full coverage: ' + (result.error || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error setting full coverage:', error);
                showAlert('Failed to set full coverage: ' + error.message, 'error');
            }
        }

        /**
         * Show COE payment modal
         */
        async function showCOEPaymentModal(coeId, amount) {
            try {
                // Get saved payment methods
                const result = await makeApiRequest('/payments/saved-cards', 'GET');
                
                if (!result.success || !result.data) {
                    showAlert('Failed to load payment methods', 'error');
                    return;
                }

                const apiData = result.data.data || result.data;
                const savedCards = apiData.saved_cards || [];

                let paymentMethodsHtml = '';
                if (savedCards.length > 0) {
                    paymentMethodsHtml = savedCards.map(card => `
                        <div class="payment-method-option" onclick="selectPaymentMethod('${card.token_id}')">
                            <div class="payment-method-card">
                                <div class="card-brand-icon ${getCardBrandClass(card.card_brand)}">
                                    ${getCardBrandIcon(card.card_brand)}
                                </div>
                                <div class="payment-method-details">
                                    <div class="payment-method-name">
                                        ${card.nickname || card.card_brand + ' •••• ' + card.card_last_four}
                                        ${card.is_default ? '<span class="badge-success" style="margin-left: 8px;">DEFAULT</span>' : ''}
                                    </div>
                                    <div class="payment-method-number">
                                        ${card.card_brand} •••• ${card.card_last_four} • Expires ${card.expiry_month}/${card.expiry_year}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    paymentMethodsHtml = '<p style="text-align: center; color: #7f8c8d; padding: 20px;">No saved payment methods. Please add a card first.</p>';
                }

                const modalHtml = `
                    <div id="coePaymentModal" class="modal" style="display: flex;">
                        <div class="modal-content" style="max-width: 500px;">
                            <div class="modal-header">
                                <h2>Pay for COE</h2>
                                <button class="close-btn" onclick="closeCOEPaymentModal()">&times;</button>
                            </div>
                            <div class="modal-body">
                                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                                    <div style="font-size: 1.2em; font-weight: bold; color: #2c3e50;">Total Amount: $${amount.toLocaleString()}</div>
                                    <div style="color: #7f8c8d; font-size: 0.9em;">Full payment required</div>
                                </div>
                                
                                <div>
                                    <h3 style="margin-bottom: 15px;">Select Payment Method</h3>
                                    <div id="paymentMethodsList" style="max-height: 300px; overflow-y: auto;">
                                        ${paymentMethodsHtml}
                                    </div>
                                </div>
                                
                                <div style="margin-top: 20px; text-align: center;">
                                    <button class="btn btn-primary" onclick="processCOEPayment('${coeId}', ${amount})" id="processPaymentBtn" disabled>
                                        Pay $${amount.toLocaleString()}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Remove existing modal if any
                const existingModal = document.getElementById('coePaymentModal');
                if (existingModal) {
                    existingModal.remove();
                }

                document.body.insertAdjacentHTML('beforeend', modalHtml);
