    <script>
        let currentToken = null;
        let currentUser = null;

        // Check for existing session on page load
        window.onload = function() {
            checkExistingSession();
            setupNavigation();
        };

        /**
         * Check if user has existing session from login
         */
        function checkExistingSession() {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');
            const user = urlParams.get('user');
            
            if (token && user) {
                currentToken = token;
                currentUser = JSON.parse(decodeURIComponent(user));
                displayUserInfo();
                setupRoleBasedNavigation();
                loadUsers();
            } else {
                showAlert('No session found. Please login first.', 'error');
                setTimeout(() => {
                    window.location.href = '/test/login';
                }, 2000);
            }
        }

        /**
         * Display user information in the UI
         */
        function displayUserInfo() {
            if (currentUser) {
                // Update avatar initials
                const initials = (currentUser.firstName?.[0] || '') + (currentUser.lastName?.[0] || '');
                const avatarInitialsEl = document.getElementById('avatarInitials');
                avatarInitialsEl.textContent = initials.toUpperCase();
                
                // Update dropdown info
                document.getElementById('dropdownName').textContent = `${currentUser.firstName} ${currentUser.lastName}`;
                document.getElementById('dropdownEmail').textContent = currentUser.email;
                document.getElementById('dropdownRole').textContent = currentUser.role;
                
                // Update avatar image if available (use inner .avatar-img)
                if (currentUser.avatarUrl) {
                    const avatarImgEl = document.querySelector('.user-avatar .avatar-img');
                    if (avatarImgEl) {
                        avatarImgEl.style.backgroundImage = `url('${currentUser.avatarUrl}')`;
                        avatarImgEl.style.backgroundSize = 'cover';
                        avatarImgEl.style.backgroundPosition = 'center';
                        avatarImgEl.style.color = 'transparent';
                    }
                }
            }
        }

        /**
         * Setup role-based navigation
         */
        function setupRoleBasedNavigation() {
            const usersNav = document.getElementById('usersNav');
            
            // Show users section only for admin users
            if (currentUser && currentUser.role === 'admin') {
                usersNav.style.display = 'block';
            } else {
                usersNav.style.display = 'none';
                // If user is not admin and users section is active, switch to locations
                if (document.querySelector('.nav-item.active').dataset.section === 'users') {
                    switchSection('locations');
                }
            }
        }

        /**
         * Setup navigation event listeners
         */
        function setupNavigation() {
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const section = this.dataset.section;
                    switchSection(section);
                });
            });
        }

        /**
         * Switch between content sections
         */
        function switchSection(sectionName) {
            // Update active nav item
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            document.querySelector(`[data-section="${sectionName}"]`).classList.add('active');

            // Update active content section
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });
            document.getElementById(`${sectionName}Section`).classList.add('active');

            // Load section-specific data
            if (sectionName === 'users' && currentUser?.role === 'admin') {
                loadUsers();
            }
            if (sectionName === 'locations' && currentUser?.role === 'admin') {
                loadLocations();
            }
            if (sectionName === 'events' && currentUser?.role === 'admin') {
                loadEvents();
            }
            if (sectionName === 'coes') {
                loadCOEs();
            }
            if (sectionName === 'payments') {
                loadPaymentsSection();
            }
        }

        /**
         * Toggle user dropdown
         */
        function toggleUserDropdown() {
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('userDropdown');
            const avatar = document.querySelector('.user-avatar');
            if (!avatar.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        /**
         * Load users for admin
         */
        async function loadUsers() {
            if (currentUser?.role !== 'admin') {
                console.log('User is not admin, cannot load users');
                return;
            }

            console.log('Loading users...', { currentToken: currentToken ? 'present' : 'missing', userRole: currentUser?.role });

            const tableBody = document.getElementById('usersTableBody');
            
            // Show loading state
            tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px;"><div class="loading"><div class="spinner"></div><p>Loading users...</p></div></td></tr>';

            try {
                const result = await makeApiRequest('/users');
                console.log('Users API response:', result);
                console.log('Response details:', {
                    success: result.success,
                    dataType: typeof result.data,
                    isArray: Array.isArray(result.data),
                    dataLength: result.data?.length,
                    dataKeys: result.data ? Object.keys(result.data) : 'no data'
                });
                
                if (result.success && result.data) {
                    // Check if data is an array directly
                    if (Array.isArray(result.data)) {
                        displayUsersTable(result.data);
                        showAlert('Users loaded successfully!', 'success');
                    } 
                    // Check if data has a users property
                    else if (result.data.users && Array.isArray(result.data.users)) {
                        displayUsersTable(result.data.users);
                        showAlert('Users loaded successfully!', 'success');
                    }
                    // Check if data has a data property (nested)
                    else if (result.data.data && Array.isArray(result.data.data)) {
                        displayUsersTable(result.data.data);
                        showAlert('Users loaded successfully!', 'success');
                    }
                    else {
                        const errorMsg = 'Invalid data format: ' + JSON.stringify(result.data);
                        tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Failed to load users: ' + errorMsg + '</td></tr>';
                        showAlert('Failed to load users: ' + errorMsg, 'error');
                    }
                } else {
                    const errorMsg = result.data?.message || result.data?.error?.message || 'Unknown error';
                    tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Failed to load users: ' + errorMsg + '</td></tr>';
                    showAlert('Failed to load users: ' + errorMsg, 'error');
                }
            } catch (error) {
                console.error('Error loading users:', error);
                tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #e74c3c;">Error loading users: ' + error.message + '</td></tr>';
                showAlert('Error loading users: ' + error.message, 'error');
            }
        }

        /**
         * Display users in table
         */
        function displayUsersTable(users) {
            const tableBody = document.getElementById('usersTableBody');
            
            if (users.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="10" style="text-align: center; padding: 40px; color: #7f8c8d;">No users found</td></tr>';
                return;
            }

            tableBody.innerHTML = users.map(user => `
                <tr>
                    <td>
                        <span class="user-name ${currentUser?.role === 'admin' ? 'clickable' : ''}" 
                              ${currentUser?.role === 'admin' ? `onclick="viewUserProfile('${user._id}', '${user.firstName} ${user.lastName}')"` : ''}>
                            ${user.firstName} ${user.lastName}
                        </span>
                        <small style="display: block; color: #7f8c8d; font-size: 0.7rem;">ID: ${user._id}</small>
                    </td>
                    <td>${user.email}</td>
                    <td>${user.phone || '-'}</td>
                    <td>${user.dateOfBirth ? new Date(user.dateOfBirth).toLocaleDateString() : '-'}</td>
                    <td>
                        <span class="industry-badge industry-${user.industry || 'tech'}">
                            ${user.industry ? user.industry.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Tech'}
                        </span>
                    </td>
                    <td>
                        <span class="role-badge role-${user.role} ${currentUser?.role === 'admin' ? 'clickable' : ''}" 
                              ${currentUser?.role === 'admin' ? `onclick="openRoleModal('${user._id}', '${user.firstName} ${user.lastName}', '${user.role}')"` : ''}>
                            ${user.role}
                        </span>
                    </td>
                    <td>
                        <span class="status-badge status-${user.entity_status} ${currentUser?.role === 'admin' ? 'clickable' : ''}" 
                              ${currentUser?.role === 'admin' ? `onclick="openStatusModal('${user._id}', '${user.firstName} ${user.lastName}', '${user.entity_status}')"` : ''}>
                            ${user.entity_status}
                        </span>
                    </td>
                    <td>
                        <span class="visibility-badge visibility-${user.visibilityStatus || 'public'}">
                            ${user.visibilityStatus === 'private' ? 'private' : 'public'}
                        </span>
                    </td>
                    <td>
                        <span class="tier-badge tier-${user.userTier || 'member'}">
                            ${user.userTier || 'member'}
                        </span>
                    </td>
                    <td>${new Date(user.createdAt).toLocaleDateString()}</td>
                </tr>
            `).join('');
        }

        /**
         * Show alert message
         */
        function showAlert(message, type = 'success') {
            const alertsDiv = document.getElementById('alerts');
            let alertClass = 'alert-success';
            if (type === 'error') {
                alertClass = 'alert-error';
            } else if (type === 'info') {
                alertClass = 'alert-info';
            }
            alertsDiv.innerHTML = `<div class="alert ${alertClass}">${message}</div>`;
            alertsDiv.style.display = 'block';
            
            setTimeout(() => {
                alertsDiv.style.display = 'none';
            }, 5000);
        }

        /**
         * Make API request with authentication
         */
        async function makeApiRequest(endpoint, method = 'GET', body = null) {
            const headers = {
                'Content-Type': 'application/json'
            };
            
            if (currentToken) {
                headers['Authorization'] = `Bearer ${currentToken}`;
            }

            const config = {
                method: method,
                headers: headers,
                cache: 'no-store'
            };

            if (body) {
                config.body = JSON.stringify(body);
            }

            // Cache-busting for GET requests
            let finalEndpoint = endpoint;
            if (method === 'GET') {
                const ts = Date.now();
                finalEndpoint += (endpoint.includes('?') ? '&' : '?') + `_=${ts}`;
                headers['Cache-Control'] = 'no-cache';
            }

            console.log('Making API request:', { endpoint: `/v1${finalEndpoint}`, method, headers });

            try {
                const response = await fetch(`/v1${finalEndpoint}`, config);
                const data = await response.json();
                console.log('API response:', { status: response.status, data });
                return { success: response.ok, data, status: response.status };
            } catch (error) {
                console.error('API request error:', error);
                return { success: false, data: { error: error.message }, status: 0 };
            }
        }

        /**
         * View user profile
         */
        async function viewProfile() {
            try {
                // Close the dropdown first
                document.getElementById('userDropdown').classList.remove('show');
                
                // Show loading in modal
                document.getElementById('profileModalBody').innerHTML = '<div class="loading"><div class="spinner"></div><p>Loading profile...</p></div>';
                document.getElementById('profileModal').style.display = 'flex';
                
                // Fetch detailed profile from API
                const result = await makeApiRequest('/users/profile');
                console.log('Profile API response:', result);
                
                if (result.success && result.data) {
                    // Handle different response structures
                    let user = result.data;
                    
                    // Check if user data is nested
                    if (result.data.user) {
                        user = result.data.user;
                    }
                    
                    console.log('User data from API:', user);
                    console.log('Current user from session:', currentUser);
                    
                    // Use API data if available, otherwise fall back to session data
                    const profileData = (user && user.firstName) ? user : currentUser;
                    
                    // Show the profile content directly
                    document.getElementById('profileModalBody').innerHTML = `
                        <div class="profile-info">
                            <div class="profile-field">
                                <label>Name:</label>
                                <span>${profileData.firstName || 'N/A'} ${profileData.lastName || 'N/A'}</span>
                            </div>
                            <div class="profile-field">
                                <label>Email:</label>
                                <span>${profileData.email || 'N/A'}</span>
                            </div>
                            <div class="profile-field">
                                <label>Phone:</label>
                                <span>${profileData.phone || 'Not provided'}</span>
                            </div>
                            <div class="profile-field">
                                <label>Role:</label>
                                <span>${profileData.role || 'N/A'}</span>
                            </div>
                            <div class="profile-field">
                                <label>Created:</label>
                                <span>${profileData.createdAt ? new Date(profileData.createdAt).toLocaleString() : 'N/A'}</span>
                            </div>
                <div class="profile-field">
                    <label>Last Updated:</label>
                    <span>${profileData.updatedAt ? new Date(profileData.updatedAt).toLocaleString() : 'N/A'}</span>
                </div>
                <div class="profile-section">
                    <h3>Social Media</h3>
                    <div class="profile-field">
                        <label>Facebook:</label>
                        <span>${profileData.socialMedia?.facebook ? `<a href="${profileData.socialMedia.facebook}" target="_blank" style="color: #3498db;">${profileData.socialMedia.facebook}</a>` : 'Not provided'}</span>
                    </div>
                    <div class="profile-field">
                        <label>LinkedIn:</label>
                        <span>${profileData.socialMedia?.linkedin ? `<a href="${profileData.socialMedia.linkedin}" target="_blank" style="color: #3498db;">${profileData.socialMedia.linkedin}</a>` : 'Not provided'}</span>
                    </div>
                    <div class="profile-field">
                        <label>X (Twitter):</label>
                        <span>${profileData.socialMedia?.x ? `<a href="${profileData.socialMedia.x}" target="_blank" style="color: #3498db;">${profileData.socialMedia.x}</a>` : 'Not provided'}</span>
                    </div>
                    <div class="profile-field">
                        <label>Instagram:</label>
                        <span>${profileData.socialMedia?.instagram ? `<a href="${profileData.socialMedia.instagram}" target="_blank" style="color: #3498db;">${profileData.socialMedia.instagram}</a>` : 'Not provided'}</span>
                    </div>
                </div>
                        </div>
                    `;
                } else {
                    document.getElementById('profileModalBody').innerHTML = '<p style="color: #e74c3c; text-align: center;">Failed to load profile: ' + (result.data?.message || 'Unknown error') + '</p>';
                }
            } catch (error) {
                console.error('Error loading profile:', error);
                document.getElementById('profileModalBody').innerHTML = '<p style="color: #e74c3c; text-align: center;">Error loading profile: ' + error.message + '</p>';
            }
        }

        /**
         * Close profile modal
         */
        function closeProfileModal() {
            document.getElementById('profileModal').style.display = 'none';
        }

        /**
         * Edit profile (placeholder)
         */
        function editProfile() {
