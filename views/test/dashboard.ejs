            // Remove existing modal if any
            const existingModal = document.getElementById('coeRefundModal');
            if (existingModal) {
                existingModal.remove();
            }

            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Add event listeners for validation
            const refundAmountInput = document.getElementById('refundAmount');
            const refundReasonInput = document.getElementById('refundReason');
            const processBtn = document.getElementById('processRefundBtn');
            
            function validateForm() {
                const amount = parseFloat(refundAmountInput.value) || 0;
                const reason = refundReasonInput.value.trim();
                const isValid = amount > 0 && amount <= remainingRefundable && reason.length > 0;
                processBtn.disabled = !isValid;
            }
            
            refundAmountInput.addEventListener('input', validateForm);
            refundReasonInput.addEventListener('input', validateForm);
