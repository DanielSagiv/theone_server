        /**
         * Filter events based on selected filters
         */
        function filterEvents() {
            // On any filter change, reload from server starting at page 1
            loadEvents(1);
        }

        /**
         * Search events
         */
        function searchEvents() {
            // Debounced server-side search
            if (window.__eventsSearchTimeout) clearTimeout(window.__eventsSearchTimeout);
            window.__eventsSearchTimeout = setTimeout(() => loadEvents(1), 300);
        }

        /**
         * Refresh events
         */
        function refreshEvents() {
            loadEvents();
        }

        /**
         * Pagination controls for events
         */
        function renderEventsPagination() {
            const prevBtn = document.getElementById('eventsPrevBtn');
            const nextBtn = document.getElementById('eventsNextBtn');
            const pageInfo = document.getElementById('eventsPageInfo');
            const totalInfo = document.getElementById('eventsTotalInfo');
            const headerTotal = document.getElementById('eventsHeaderTotal');
            const pageSizeEl = document.getElementById('eventsPageSize');

            if (pageInfo) pageInfo.textContent = `Page ${eventsPage} of ${eventsTotalPages}`;
            if (totalInfo) totalInfo.textContent = `${eventsTotal} total`;
            if (headerTotal) headerTotal.textContent = `(${eventsTotal} total)`;
            if (prevBtn) prevBtn.disabled = eventsPage <= 1;
            if (nextBtn) nextBtn.disabled = eventsPage >= eventsTotalPages;
            if (pageSizeEl) pageSizeEl.value = String(eventsLimit);
        }

        function prevEventsPage() {
            if (eventsPage > 1) loadEvents(eventsPage - 1);
        }

        function nextEventsPage() {
            if (eventsPage < eventsTotalPages) loadEvents(eventsPage + 1);
        }

        function changeEventsPageSize(size) {
            const newSize = parseInt(size) || 20;
            if (newSize !== eventsLimit) {
                eventsLimit = newSize;
                loadEvents(1);
            }
        }

        /**
         * Open create event modal
         */
        async function openCreateEvent() {
            try {
                // Load locations for selection
                const result = await makeApiRequest('/locations');
                if (result.success && result.data) {
                    const locations = Array.isArray(result.data) ? result.data : result.data.data || [];
                    const locationSelect = document.getElementById('ce_location_id');
                    locationSelect.innerHTML = '<option value="">Choose a location...</option>' +
                        locations.map(loc => `<option value="${loc._id}">${loc.name} (${loc.type.replace('_', ' ')})</option>`).join('');
                }

                // Reset form and show modal
                resetCreateEventForm();
                document.getElementById('createEventModal').style.display = 'flex';
                setCeStep(1);
            } catch (error) {
                console.error('Error opening create event modal:', error);
                showAlert('Error opening create event modal: ' + error.message, 'error');
            }
        }

        /**
         * Close create event modal
         */
        function closeCreateEvent() {
            document.getElementById('createEventModal').style.display = 'none';
            resetCreateEventForm();
        }

        /**
         * Reset create event form
         */
        function resetCreateEventForm() {
            document.getElementById('ce_name').value = '';
            document.getElementById('ce_description').value = '';
            document.getElementById('ce_type').value = 'night_club';
            document.getElementById('ce_start_datetime').value = '';
            document.getElementById('ce_end_datetime').value = '';
            document.getElementById('ce_location_id').value = '';
            document.getElementById('ce_base_price').value = '';
            document.getElementById('ce_currency').value = 'USD';
            document.getElementById('ce_price_tier').value = '1';
            document.getElementById('ce_policies').value = '';
            document.getElementById('ce_notes').value = '';
            document.getElementById('ce_location_preview').style.display = 'none';
            currentEventStep = 1;
        }

        /**
         * Set current step in create event modal
         */
        function setCeStep(step) {
            currentEventStep = step;
            
            // Hide all steps
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`ce_step${i}`).style.display = 'none';
                document.getElementById(`ce_step${i}_badge`).style.opacity = '0.6';
            }
            
            // Show current step
            document.getElementById(`ce_step${step}`).style.display = 'block';
            document.getElementById(`ce_step${step}_badge`).style.opacity = '1';
            
            // Update buttons
            const backBtn = document.querySelector('#createEventModal .modal-footer .btn-secondary');
            const nextBtn = document.getElementById('ce_next_btn');
            const createBtn = document.getElementById('ce_create_btn');
            
            backBtn.style.display = step > 1 ? 'inline-block' : 'none';
            nextBtn.style.display = step < 4 ? 'inline-block' : 'none';
            createBtn.style.display = step === 4 ? 'inline-block' : 'none';
        }

        /**
         * Next step in create event modal
         */
        function nextCeStep() {
            if (validateCeStep(currentEventStep)) {
                if (currentEventStep < 4) {
                    setCeStep(currentEventStep + 1);
                    if (currentEventStep === 4) {
                        updateCeReview();
                    }
                }
            }
        }

        /**
         * Previous step in create event modal
         */
        function prevCeStep() {
            if (currentEventStep > 1) {
                setCeStep(currentEventStep - 1);
            }
        }

        /**
         * Validate current step in create event modal
         */
        function validateCeStep(step) {
            // Clear previous validation indicators
            clearCeValidationIndicators();
            
            switch (step) {
                case 1:
                    const name = document.getElementById('ce_name').value.trim();
                    const startDate = document.getElementById('ce_start_datetime').value;
                    const endDate = document.getElementById('ce_end_datetime').value;
                    
                    if (!name) {
                        addCeFieldValidation('ce_name', 'Event name is required');
                        return false;
                    }
                    if (!startDate) {
                        addCeFieldValidation('ce_start_datetime', 'Start date and time is required');
                        return false;
                    }
                    if (!endDate) {
                        addCeFieldValidation('ce_end_datetime', 'End date and time is required');
                        return false;
                    }
                    if (new Date(startDate) >= new Date(endDate)) {
                        addCeFieldValidation('ce_end_datetime', 'End date must be after start date');
                        return false;
                    }
                    return true;
                    
                case 2:
                    const locationId = document.getElementById('ce_location_id').value;
                    if (!locationId) {
                        addCeFieldValidation('ce_location_id', 'Please select a location');
                        return false;
                    }
                    return true;
                    
                case 3:
                    const basePrice = document.getElementById('ce_base_price').value;
                    if (!basePrice || parseFloat(basePrice) < 0) {
                        addCeFieldValidation('ce_base_price', 'Base price must be a positive number');
                        return false;
                    }
                    return true;
                    
                default:
                    return true;
            }
        }

        /**
         * Clear all event validation indicators
         */
        function clearCeValidationIndicators() {
            const fields = ['ce_name', 'ce_start_datetime', 'ce_end_datetime', 'ce_location_id', 'ce_base_price'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.style.borderColor = '';
                    field.style.backgroundColor = '';
                }
            });
            
            const validationMsgs = document.querySelectorAll('.ce-validation-msg');
            validationMsgs.forEach(msg => msg.remove());
        }

        /**
         * Add event field validation indicator
         */
        function addCeFieldValidation(fieldId, message) {
            const field = document.getElementById(fieldId);
            if (field) {
                field.style.borderColor = '#e74c3c';
                field.style.backgroundColor = '#fdf2f2';
                
                const existingMsg = field.parentNode.querySelector('.ce-validation-msg');
                if (!existingMsg) {
                    const msgDiv = document.createElement('div');
                    msgDiv.className = 'ce-validation-msg';
                    msgDiv.style.color = '#e74c3c';
                    msgDiv.style.fontSize = '12px';
                    msgDiv.style.marginTop = '4px';
                    msgDiv.textContent = message;
                    field.parentNode.appendChild(msgDiv);
                }
            }
        }

        /**
         * Handle location selection change
         */
        async function onCeLocationChange() {
            const locationId = document.getElementById('ce_location_id').value;
            const preview = document.getElementById('ce_location_preview');
            const details = document.getElementById('ce_location_details');
            
            if (!locationId) {
                preview.style.display = 'none';
                return;
            }
            
            try {
                const result = await makeApiRequest(`/locations/${locationId}`);
                if (result.success && result.data) {
                    const location = result.data.data || result.data;
                    details.innerHTML = `
                        <p><strong>${location.name}</strong> - ${location.type.replace('_', ' ').toUpperCase()}</p>
                        <p>Seats: ${location.seats?.length || 0} | Units: ${location.units?.length || 0}</p>
                        <p>Total Capacity: ${(location.seats?.reduce((sum, seat) => sum + (seat.capacity || 0), 0) || 0) + (location.units?.reduce((sum, unit) => sum + (unit.occupancy || 0), 0) || 0)}</p>
                        <p>City: ${location.address?.city || 'N/A'} | Country: ${location.address?.country || 'N/A'}</p>
                    `;
                    preview.style.display = 'block';
                }
            } catch (error) {
                console.error('Error loading location details:', error);
            }
        }

        /**
         * Update review section
         */
        function updateCeReview() {
            const reviewData = {
                name: document.getElementById('ce_name').value,
                description: document.getElementById('ce_description').value,
                type: document.getElementById('ce_type').value,
                start_datetime: document.getElementById('ce_start_datetime').value,
                end_datetime: document.getElementById('ce_end_datetime').value,
                location_id: document.getElementById('ce_location_id').value,
                base_price: document.getElementById('ce_base_price').value,
                currency: document.getElementById('ce_currency').value,
                price_tier: document.getElementById('ce_price_tier').value,
                policies: document.getElementById('ce_policies').value,
                notes: document.getElementById('ce_notes').value
            };
            
            document.getElementById('ce_review').textContent = JSON.stringify(reviewData, null, 2);
        }

        /**
         * Store uploaded event media URLs
         */
        let ce_uploadedMedia = [];

        /**
         * Preview event media files
         */
        function previewEventMedia() {
            const fileInput = document.getElementById('ce_media_files');
            const preview = document.getElementById('ce_media_preview');
            const files = fileInput.files;
            
            preview.innerHTML = '';
            
            if (files.length === 0) {
                return;
            }
            
            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const isVideo = file.type.startsWith('video/');
                    const previewItem = document.createElement('div');
                    previewItem.style.cssText = 'position:relative;border:1px solid #ecf0f1;border-radius:8px;overflow:hidden;';
                    
                    if (isVideo) {
                        previewItem.innerHTML = `
                            <video src="${e.target.result}" style="width:100%;height:120px;object-fit:cover;"></video>
                            <div style="position:absolute;bottom:5px;left:5px;background:rgba(0,0,0,0.7);color:white;padding:2px 6px;font-size:10px;border-radius:3px;">VIDEO</div>
                        `;
                    } else {
                        previewItem.innerHTML = `<img src="${e.target.result}" style="width:100%;height:120px;object-fit:cover;" />`;
                    }
                    
                    preview.appendChild(previewItem);
                };
                reader.readAsDataURL(file);
            });
        }

        /**
         * Upload event media files to S3
         */
        async function uploadEventMediaFiles() {
            const fileInput = document.getElementById('ce_media_files');
            const files = fileInput.files;
            
            console.log('Upload event media files - files selected:', files.length);
            
            if (!files || files.length === 0) {
                console.log('No files selected for upload');
                return [];
            }
            
            const uploadedUrls = [];
            
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                console.log(`Uploading file ${i + 1}/${files.length}:`, file.name, file.type, file.size);
                
                const formData = new FormData();
                formData.append('asset', file);
                
                try {
                    console.log('Making upload request to /v1/events/media/upload');
                    
                    // Use direct fetch for FormData (makeApiRequest doesn't handle FormData properly)
                    const response = await fetch(`/v1/events/media/upload`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${currentToken}`
                        },
                        body: formData
                    });
                    
                    console.log('Upload response status:', response.status);
                    const result = await response.json();
                    console.log('Upload response result:', result);
                    
                    if (result.success && result.data) {
                        console.log('File uploaded successfully:', result.data);
                        uploadedUrls.push({
                            type: result.data.type,
                            url: result.data.url,
                            order: i
                        });
                    } else {
                        console.error('Failed to upload file:', file.name, result.error);
                        showAlert(`Failed to upload ${file.name}: ${result.error?.message || 'Unknown error'}`, 'error');
                    }
                } catch (error) {
                    console.error('Error uploading file:', file.name, error);
                    showAlert(`Error uploading ${file.name}: ${error.message}`, 'error');
                }
            }
            
            console.log('All files uploaded. URLs:', uploadedUrls);
            return uploadedUrls;
        }

        /**
         * Submit create event
         */
        async function submitCreateEvent() {
            try {
                // Upload media files first
                showAlert('Uploading event media...', 'info');
                ce_uploadedMedia = await uploadEventMediaFiles();
                console.log('Uploaded media:', ce_uploadedMedia);
                console.log('Number of media files uploaded:', ce_uploadedMedia.length);
                
                const eventData = {
                    name: document.getElementById('ce_name').value.trim(),
                    description: document.getElementById('ce_description').value.trim(),
                    type: document.getElementById('ce_type').value,
                    location_id: document.getElementById('ce_location_id').value,
                    start_datetime: new Date(document.getElementById('ce_start_datetime').value).toISOString(),
                    end_datetime: new Date(document.getElementById('ce_end_datetime').value).toISOString(),
                    base_price: parseFloat(document.getElementById('ce_base_price').value),
                    currency: document.getElementById('ce_currency').value,
                    price_tier: parseInt(document.getElementById('ce_price_tier').value),
                    policies: document.getElementById('ce_policies').value.trim(),
                    notes: document.getElementById('ce_notes').value.trim(),
                    media: ce_uploadedMedia
                };

                console.log('Creating event with data:', eventData);
                console.log('Event media array:', eventData.media);

                const result = await makeApiRequest('/events', 'POST', eventData);
                
                if (result.success) {
                    showAlert('Event created successfully!', 'success');
                    closeCreateEvent();
                    loadEvents(); // Refresh events list
                    ce_uploadedMedia = []; // Reset
                } else {
                    showAlert('Failed to create event: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error creating event:', error);
                showAlert('Error creating event: ' + error.message, 'error');
            }
        }

        /**
         * View event details
         */
        async function viewEventDetails(eventId) {
            try {
                console.log('Viewing event details for:', eventId);
                const result = await makeApiRequest(`/events/${eventId}`);
                
                if (result.success && result.data) {
                    const event = result.data.data || result.data;
                    displayEventDetails(event);
                    document.getElementById('eventDetailsModal').style.display = 'flex';
                } else {
                    showAlert('Failed to load event details: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error loading event details:', error);
                showAlert('Error loading event details: ' + error.message, 'error');
            }
        }

        /**
         * Display event details in modal
         */
        function displayEventDetails(event) {
            // Update event info
            document.getElementById('eventDetailsTitle').textContent = event.name;
            document.getElementById('eventDetailName').textContent = event.name;
            document.getElementById('eventDetailType').textContent = event.type.replace('_', ' ').toUpperCase();
            document.getElementById('eventDetailLocation').textContent = event.location_id?.name || 'Unknown Location';
            document.getElementById('eventDetailStartDate').textContent = new Date(event.start_datetime).toLocaleString();
            document.getElementById('eventDetailEndDate').textContent = new Date(event.end_datetime).toLocaleString();
            document.getElementById('eventDetailStatus').innerHTML = `<span class="status-badge status-${event.status}">${event.status.replace('_', ' ').toUpperCase()}</span>`;
            document.getElementById('eventDetailBasePrice').textContent = `${event.currency || 'USD'} ${event.base_price || 0}`;
            document.getElementById('eventDetailCapacity').textContent = event.total_capacity || 0;
            document.getElementById('eventDetailBooked').textContent = event.total_booked || 0;
            document.getElementById('eventDetailRevenue').textContent = `${event.currency || 'USD'} ${(event.total_revenue || 0).toLocaleString()}`;
            document.getElementById('eventDetailDescription').textContent = event.description || 'No description';
            document.getElementById('eventDetailPolicies').textContent = event.policies || 'No policies specified';

            // Update analytics
            const availability = event.total_capacity > 0 ? Math.round(((event.total_capacity - (event.total_booked || 0)) / event.total_capacity) * 100) : 0;
            const revenuePerSeat = event.total_booked > 0 ? (event.total_revenue || 0) / event.total_booked : 0;
            const daysUntil = Math.ceil((new Date(event.start_datetime) - new Date()) / (1000 * 60 * 60 * 24));
            
            document.getElementById('eventAnalyticsAvailability').textContent = `${availability}%`;
            document.getElementById('eventAnalyticsRevenuePerSeat').textContent = `${event.currency || 'USD'} ${revenuePerSeat.toFixed(2)}`;
            document.getElementById('eventAnalyticsDaysUntil').textContent = daysUntil > 0 ? `${daysUntil} days` : 'Event has passed';
            document.getElementById('eventAnalyticsBookingRate').textContent = `${event.total_booked || 0}/${event.total_capacity || 0}`;

            // Store current event for management
            window.currentEvent = event;
            
            // Update management title based on event type
            const managementTitle = document.getElementById('eventManagementTitle');
            if (event.type === 'night_club' || event.type === 'day_club') {
                managementTitle.textContent = 'Table Management';
            } else if (event.type === 'restaurant') {
                managementTitle.textContent = 'Section Management';
            } else if (event.type === 'hotel') {
                managementTitle.textContent = 'Room Management';
            } else {
                managementTitle.textContent = 'Management';
            }
            
            // Display event-specific media
            displayEventMedia(event.media || []);
            
            // Display location media
            displayLocationMedia(event.location_id?.media || []);
            
            // Load seats if available
            if (event.seats && event.seats.length > 0) {
                displayEventSeats(event.seats);
            }
        }

        /**
         * Display event seats in grid
         */
        function displayEventSeats(seats) {
            const seatsGrid = document.getElementById('eventSeatsGrid');
            
            if (!seats || seats.length === 0) {
                seatsGrid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#7f8c8d;">No tables available for this event</div>';
                return;
            }

            seatsGrid.innerHTML = seats.map(seat => {
                const status = seat.status || 'available';
                const price = seat.price || window.currentEvent?.base_price || 0;
                const currency = window.currentEvent?.currency || 'USD';
                
                return `
                    <div class="seat-card ${status}" onclick="toggleSeatStatus('${seat._id}', '${status}')">
                        <div class="seat-card-header">
                            <span class="seat-code">${seat.code}</span>
                            <span class="seat-status ${status}">${status}</span>
                        </div>
                        <div class="seat-details">
                            <div><strong>${currency} ${price}</strong></div>
                            <div>Capacity: ${seat.capacity || 1}</div>
                            <div>Category: ${seat.category || 'N/A'}</div>
                            ${seat.section ? `<div>Section: ${seat.section}</div>` : ''}
                            ${seat.minSpendUSD ? `<div>Min Spend: $${seat.minSpendUSD}</div>` : ''}
                            ${seat.media && seat.media.length > 0 ? `
                                <div class="seat-media">
                                    ${seat.media.map(media => {
                                        const isVideo = media.type === 'video' || 
                                                       media.url.toLowerCase().includes('.mp4') || 
                                                       media.url.toLowerCase().includes('.mov') ||
                                                       media.url.toLowerCase().includes('.avi') ||
                                                       media.url.toLowerCase().includes('.webm') ||
                                                       media.url.toLowerCase().includes('.mkv');
                                        return `
                                            <img src="${media.url}" alt="${media.alt || 'Table media'}" 
                                                 class="seat-media-thumbnail ${isVideo ? 'video' : ''}"
