                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            ${(() => {
                                                const coeStatus = (coeData.status || '').toLowerCase();
                                                const isDraft = coeStatus === 'draft';
                                                console.log('[COE_EVENT_ACTIONS] Status check:', {
                                                    coeId: coeData.id || coeData._id,
                                                    status: coeData.status,
                                                    coeStatus,
                                                    isDraft,
                                                    eventId: eventGroup.event_id,
                                                    hasSameDayAlternatives: hasSameDayAlternatives
                                                });
                                                return isDraft ? `
                                                    <button class="coe-event-action-btn" 
                                                            onclick="event.stopPropagation(); handleRemoveEvent('${coeData.id || coeData._id}', '${eventGroup.event_id}');" 
                                                            title="Remove Event"
                                                            style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer;">
                                                        Remove
                                                    </button>
                                                    ${hasSameDayAlternatives ? `
                                                        <button class="coe-event-action-btn" 
                                                                onclick="event.stopPropagation(); console.log('Replace button clicked', {coeId: '${coeData.id || coeData._id}', eventId: '${eventGroup.event_id}'}); if (typeof handleReplaceEvent === 'function') { handleReplaceEvent('${coeData.id || coeData._id}', '${eventGroup.event_id}'); } else { console.error('handleReplaceEvent is not defined'); alert('Replace function not available. Please refresh the page.'); }" 
                                                                title="Replace Event"
                                                                style="background: rgba(59, 130, 246, 0.2); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.4); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer;">
                                                            Replace
                                                        </button>
                                                    ` : ''}
                                                ` : '';
                                            })()}
                                            <span class="expand-icon">▼</span>
                                        </div>
                                    </div>
                                    <div class="coe-seat-event-content">
                                        ${sentimentMatchHtml}
                                        ${locationThumbsHtml}
                                        ${seatItemsHtml}
                                        ${eventRunnerDetailsHtml}
                                    </div>
                                </div>
                            `;
                        }).join('');
                        
                        // Runner details / assignment (COE-level)
                        const hasRunner = !!coeData.runner_assignment?.runner;
                        
                        // Debug logging for runner assignment visibility
                        console.log('[COE_CARD] Runner assignment debug:', {
                            coeId: coeData.id || coeData._id,
                            coeStatus: coeData.status,
                            coeStatusType: typeof coeData.status,
                            hasRunnerAssignment: !!coeData.runner_assignment,
                            runnerAssignment: coeData.runner_assignment,
                            hasRunner: hasRunner,
                            runner: coeData.runner_assignment?.runner,
                            currentUser: currentUser ? {
                                id: currentUser._id || currentUser.id,
                                role: currentUser.role,
                                email: currentUser.email
                            } : null,
                            isDraft: (coeData.status || '').toLowerCase() === 'draft',
                            isAdmin: currentUser && currentUser.role === 'admin',
                            willShowAssignButton: !hasRunner && (coeData.status || '').toLowerCase() === 'draft' && currentUser && currentUser.role === 'admin'
                        });
                        
                        const runnerHtml = hasRunner ? (() => {
                            const r = coeData.runner_assignment.runner;
                            const initials = getInitials(r.name || r.email);
                            const avatarEl = r.avatarUrl
                                ? `<span class="coe-runner-avatar"><img src="${r.avatarUrl}" alt="${r.name || 'Runner'}" loading="lazy"></span>`
                                : `<span class="coe-runner-avatar">${initials}</span>`;
                            return `
                                <div class="coe-runner-section">
                                    <div class="coe-runner-title">Runner Details</div>
