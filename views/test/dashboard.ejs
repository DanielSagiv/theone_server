        async function submitCreateLocation(event) {
            event?.preventDefault?.();
            const name = document.getElementById('cl_name').value.trim();
            const type = document.getElementById('cl_type').value;
            const address_line1 = document.getElementById('cl_address_line1').value.trim();
            const address_line2 = document.getElementById('cl_address_line2').value.trim();
            const city = document.getElementById('cl_city').value.trim();
            const state = document.getElementById('cl_state').value.trim();
            const postalCode = document.getElementById('cl_postalCode').value.trim();
            const country = document.getElementById('cl_country').value.trim();
            if (!name) { showAlert('Name is required', 'error'); return; }
            try {
                // Build address object with only non-empty fields
                const address = {};
                if (address_line1) address.line1 = address_line1;
                if (address_line2) address.line2 = address_line2;
                if (city) address.city = city;
                if (state) address.state = state;
                if (postalCode) address.postalCode = postalCode;
                if (country) address.country = country;
                
                const payload = { name, type };
                if (Object.keys(address).length > 0) payload.address = address;
                const result = await makeApiRequest('/locations', 'POST', payload);
                if (result.success) {
                    closeCreateLocation();
                    showAlert('Location created', 'success');
                    loadLocations();
                } else {
                    showAlert(result.data?.error?.message || 'Failed to create location', 'error');
                }
            } catch (err) {
                console.error('Create location error:', err);
                showAlert('Error creating location: ' + err.message, 'error');
            }
        }

        async function createLocation(payload) {
            try {
                const result = await makeApiRequest('/locations', 'POST', payload);
                if (result.success) {
                    showAlert('Location created', 'success');
                    loadLocations();
                } else {
                    showAlert(result.data?.error?.message || 'Failed to create location', 'error');
                }
            } catch (err) {
                console.error('Create location error:', err);
                showAlert('Error creating location: ' + err.message, 'error');
            }
        }


        // Avatar upload client helpers
        let hiddenFileInput = null;
        function ensureHiddenFileInput() {
            if (!hiddenFileInput) {
                hiddenFileInput = document.createElement('input');
                hiddenFileInput.type = 'file';
                hiddenFileInput.accept = 'image/*,video/*';
                hiddenFileInput.style.display = 'none';
                hiddenFileInput.addEventListener('change', handleAvatarSelected);
                document.body.appendChild(hiddenFileInput);
            }
        }

        function triggerAvatarUpload() {
            if (!currentUser) { showAlert('Please log in', 'error'); return; }
            ensureHiddenFileInput();
            hiddenFileInput.value = '';
            hiddenFileInput.click();
        }

        async function handleAvatarSelected(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) { showAlert('Please select an image file', 'error'); return; }

            try {
                const formData = new FormData();
                formData.append('avatar', file);

                const response = await fetch('/v1/users/profile/avatar', {
                    method: 'POST',
                    headers: currentToken ? { 'Authorization': `Bearer ${currentToken}` } : {},
                    body: formData,
                    cache: 'no-store'
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    const url = result.data?.avatarUrl;
                    if (url) {
                        currentUser.avatarUrl = url;
                        const avatarEl = document.querySelector('.user-avatar');
                        avatarEl.style.backgroundImage = `url('${url}')`;
                        avatarEl.style.backgroundSize = 'cover';
                        avatarEl.style.backgroundPosition = 'center';
                        const modal = document.getElementById('profileModal');
                        if (modal && modal.style.display === 'flex') {
                            displayProfileData(currentUser, 'Your Profile');
                        }
                        showAlert('Avatar updated', 'success');
                    } else {
                        showAlert('Upload succeeded but no URL returned', 'warn');
                    }
                } else {
                    showAlert(result?.error?.message || 'Failed to upload avatar', 'error');
                }
            } catch (err) {
                console.error('Avatar upload error:', err);
                showAlert('Error uploading avatar: ' + err.message, 'error');
            }
        }

