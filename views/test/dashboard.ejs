            position: relative;
            padding: 12px 12px 52px 12px !important; /* Space for menu button at bottom */
            background: rgba(30, 41, 59, 0.5);
            border-radius: 8px;
            border: 1px solid rgba(148, 163, 184, 0.15);
        }

