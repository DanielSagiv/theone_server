            const lightboxImage = document.getElementById('lightboxImage');
            const lightboxVideo = document.getElementById('lightboxVideo');
            const lightboxCaption = document.getElementById('lightboxCaption');
            
            // Hide both media elements
            lightboxImage.style.display = 'none';
            lightboxVideo.style.display = 'none';
            
            if (mediaItem.type === 'image') {
                lightboxImage.src = mediaItem.url;
                lightboxImage.alt = mediaItem.caption || 'Media';
                lightboxImage.style.display = 'block';
            } else if (mediaItem.type === 'video') {
                // Detect video format from URL
                const videoType = mediaItem.url.toLowerCase().includes('.webm') ? 'video/webm' : 
                                mediaItem.url.toLowerCase().includes('.mov') ? 'video/quicktime' :
                                mediaItem.url.toLowerCase().includes('.avi') ? 'video/x-msvideo' :
                                mediaItem.url.toLowerCase().includes('.bin') ? 'video/mp4' : // Handle .bin files as MP4
                                'video/mp4';
                
                const source = lightboxVideo.querySelector('source');
                source.src = mediaItem.url;
                source.type = videoType;
                lightboxVideo.load();
                lightboxVideo.style.display = 'block';
            }
            
            lightboxCaption.textContent = mediaItem.caption || '';
            lightbox.style.display = 'flex';
        }

