        }

        /**
         * Make API request with authentication
         */
        async function makeApiRequest(endpoint, method = 'GET', body = null) {
            const headers = {
                'Content-Type': 'application/json'
            };
            
            if (currentToken) {
                headers['Authorization'] = `Bearer ${currentToken}`;
            }

            const config = {
                method: method,
                headers: headers,
                cache: 'no-store'
            };

            if (body) {
                config.body = JSON.stringify(body);
            }

            // Cache-busting for GET requests
            let finalEndpoint = endpoint;
            if (method === 'GET') {
                const ts = Date.now();
                finalEndpoint += (endpoint.includes('?') ? '&' : '?') + `_=${ts}`;
                headers['Cache-Control'] = 'no-cache';
            }

            console.log('Making API request:', { endpoint: `/v1${finalEndpoint}`, method, headers });

            try {
                const response = await fetch(`/v1${finalEndpoint}`, config);
                const data = await response.json();
                console.log('API response:', { status: response.status, data });
                return { success: response.ok, data, status: response.status };
            } catch (error) {
                console.error('API request error:', error);
                return { success: false, data: { error: error.message }, status: 0 };
            }
        }

