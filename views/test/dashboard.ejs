                                });
                            }
                            
                            // Combine selected seats and upgrade options
                            const allSeatItems = seatItems.join('') + upgradeSlides.join('');
                            const totalSlides = eventGroup.seats.length + upgradeSlides.length;
                            
                            console.log('[UPGRADE_DEBUG] Final carousel state:', {
                                eventId: eventId,
                                eventName: eventGroup.event_name,
                                selectedSeatsCount: eventGroup.seats.length,
                                upgradeSlidesCount: upgradeSlides.length,
                                totalSlides: totalSlides,
                                willShowCarousel: totalSlides > 1 || upgradeSlides.length > 0,
                                seatItemsLength: seatItems.length,
                                upgradeSlidesLength: upgradeSlides.length
                            });
                            
                            // Build carousel HTML if:
                            // 1. Multiple items (seats + upgrades) OR
                            // 2. Has upgrade slides (even with single selected seat)
                            // Otherwise just show single seat without carousel
                            const shouldShowCarousel = totalSlides > 1 || upgradeSlides.length > 0;
                            const seatItemsHtml = shouldShowCarousel ? `
                                <div class="coe-seat-carousel-container" data-event-group-id="${eventGroup.event_id || 'unknown'}">
                                    <div class="coe-seat-carousel-wrapper">
                                        <div class="coe-seat-carousel-track">
                                            ${allSeatItems}
                                        </div>
                                    </div>
                                    ${totalSlides > 1 ? `
                                    <div class="coe-seat-carousel-controls">
                                        <button class="coe-seat-carousel-btn coe-seat-carousel-prev" onclick="slideSeatCarousel(this, -1)" aria-label="Previous">
                                            ‹
                                        </button>
                                        <div class="coe-seat-carousel-indicators">
                                            ${Array.from({ length: totalSlides }).map((_, idx) => `
                                                <button class="coe-seat-carousel-dot ${idx === 0 ? 'active' : ''}" 
                                                        onclick="goToSeatSlide(this, ${idx})" 
                                                        aria-label="Go to ${idx < eventGroup.seats.length ? 'table' : 'upgrade'} ${idx + 1}"></button>
                                            `).join('')}
                                        </div>
                                        <button class="coe-seat-carousel-btn coe-seat-carousel-next" onclick="slideSeatCarousel(this, 1)" aria-label="Next">
                                            ›
                                        </button>
                                    </div>
                                    ` : ''}
                                </div>
                            ` : (eventGroup.seats.length > 0 ? seatItems.join('') : '');
                            
                            const eventDate = eventGroup.event_date 
                                ? new Date(eventGroup.event_date).toLocaleDateString()
                                : 'Date TBD';
                            
                            return `
                                <div class="coe-seat-event-group">
                                    <div class="coe-seat-event-header" onclick="toggleCoeSeatEvent(this)">
