            padding: 15px;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            text-align: center;
        }

        .lightbox .close {
            color: white;
            font-size: 30px;
            position: absolute;
            top: 15px;
            right: 25px;
            z-index: 1000;
        }

        .modal-footer {
            padding: 20px;
            border-top: 1px solid #ecf0f1;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .modal-footer .btn {
            background: #3498db;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.9rem;
            min-width: 80px;
        }

        .modal-footer .btn:hover {
            background: #2980b9;
        }

        .modal-footer .btn-secondary {
            background: #95a5a6;
        }

        .modal-footer .btn-secondary:hover {
            background: #7f8c8d;
        }

