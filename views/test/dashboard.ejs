                                                    <span class="coe-seat-cost-label">Capacity:</span>
                                                    <span>${seat.capacity || 0}</span>
                                                </div>
                                                <div class="coe-seat-cost-item">
                                                    <span class="coe-seat-cost-label">Base Price:</span>
                                                    <span>$${seat.base_price || 0}</span>
                                                </div>
                                                <div class="coe-seat-cost-item">
                                                    <span class="coe-seat-cost-label">Event Price:</span>
                                                    <span>$${seat.event_price || seat.base_price || 0}</span>
                                                </div>
                                                <div class="coe-seat-cost-item">
                                                    <span class="coe-seat-cost-label">Total Cost:</span>
                                                    <span style="font-weight: 600; color: #60a5fa;">$${totalCost}</span>
                                                </div>
                                            </div>
                                            ${seat.ai_recommendation ? `
                                                <div class="coe-seat-recommendation">
                                                    <img src="/images/amir.png" alt="Recommendation" class="recommendation-icon">
                                                    <p>${seat.ai_recommendation}</p>
                                                </div>
                                            ` : ''}
                                            ${seatMediaHtml}
                                        </div>
                                    </div>
                                `;
                            });
                            
                            // Check for upgrade offers for this event
                            // Normalize event ID to string for consistent comparison
                            const eventId = String(eventGroup.event_id || '');
                            
                            // Helper function to normalize event ID for comparison
                            // Handles ObjectId objects, strings, and other formats
                            const normalizeEventId = (id) => {
                                if (!id && id !== 0) return '';
                                // Handle ObjectId objects (Mongoose)
                                if (typeof id === 'object') {
                                    // Check if it's a Mongoose ObjectId
                                    if (id._id) return String(id._id);
                                    if (id.toString && typeof id.toString === 'function') {
                                        const str = id.toString();
                                        // ObjectId strings are 24 hex characters
                                        if (str.length === 24 && /^[0-9a-fA-F]{24}$/.test(str)) {
                                            return str;
                                        }
                                        return str;
                                    }
                                    // If it has a value property, use that
                                    if (id.value) return String(id.value);
                                    // Last resort: JSON stringify and extract
                                    return String(JSON.parse(JSON.stringify(id)));
                                }
                                // Handle strings and numbers
                                return String(id);
                            };
                            
                            // Debug logging for upgrade offers
