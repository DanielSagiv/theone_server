                        expiry_month: document.getElementById('adhocExpiryMonth').value.trim(),
                        expiry_year: document.getElementById('adhocExpiryYear').value.trim(),
                    };
                    body.save_to_payer = document.getElementById('adhocSaveToPayer').checked;
                }
                const result = await makeApiRequest('/payments/admin/adhoc', 'POST', body);
                document.getElementById('adhocChargeResult').textContent = JSON.stringify(result, null, 2);
                if (result.success) {
                    showAlert('On-spot payment completed', 'success');
