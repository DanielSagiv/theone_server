                                                        <span class="coe-seat-code">${alt.seat_code || 'N/A'}</span>
                                                        <span class="upgrade-tag ${alt.fits_budget ? 'tag-within-budget' : 'tag-premium'}">${alt.tag || (alt.fits_budget ? 'Within Budget' : 'Premium Upgrade')}</span>
                                                    </div>
                                                    <div class="coe-seat-label">Upgrade Option</div>
                                                    <div class="coe-seat-costs">
                                                        <div class="coe-seat-cost-item">
                                                            <span class="coe-seat-cost-label">Event Price:</span>
                                                            <span>$${(alt.event_price || alt.price || 0).toLocaleString()}</span>
                                                        </div>
                                                        <div class="coe-seat-cost-item">
                                                            <span class="coe-seat-cost-label">Price Delta:</span>
                                                            <span style="color: #10b981;">+$${(alt.price_delta || 0).toLocaleString()}</span>
                                                        </div>
                                                        <div class="coe-seat-cost-item">
                                                            <span class="coe-seat-cost-label">Total Cost:</span>
                                                            <span style="font-weight: 600; color: #60a5fa;">$${((alt.event_price || alt.price || 0) + (eventGroup.seats[0]?.base_price || 0)).toLocaleString()}</span>
                                                        </div>
                                                    </div>
                                                    ${alt.ai_recommendation ? `
                                                        <div class="coe-seat-recommendation">
                                                            <img src="/images/amir.png" alt="Recommendation" class="recommendation-icon">
                                                            <p>${alt.ai_recommendation}</p>
                                                        </div>
                                                    ` : ''}
                                                    ${altMediaHtml}
                                                    ${alt.upgrade_reasons && alt.upgrade_reasons.length > 0 ? `
                                                        <div class="upgrade-reasons" style="margin-top: 8px;">
                                                            ${alt.upgrade_reasons.map(reason => `
