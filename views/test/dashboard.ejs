         */
        async function processCOEPayment(coeId, amount) {
            if (!window.selectedPaymentToken) {
                showAlert('Please select a payment method', 'error');
                return;
            }

            try {
                showAlert('Processing payment...', 'info');
                
                const result = await makeApiRequest(`/coes/${coeId}/payments/full`, 'POST', {
