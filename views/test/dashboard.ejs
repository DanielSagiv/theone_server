        /**
         * Calculate COE pricing
         */
        function calculateCOEPricing() {
            let subtotal = 0;

            // Calculate subtotal from selected events
            coecSelectedEvents.forEach(event => {
                const eventSeats = coecSelectedSeats.filter(s => s.event_id === event._id);
                if (eventSeats.length > 0) {
                    eventSeats.forEach(seatSelection => {
                        // Find the seat details
                        const seat = event.seats?.find(s => s._id === seatSelection.seat_id);
                        if (seat) {
                            subtotal += (seat.event_price || seat.min_spend || event.base_price || 0);
                        }
                    });
                } else {
                    // If no seats selected, use base price
                    subtotal += (event.base_price || 0);
                }
            });

            // Get tax and fee percentages/amounts
            const taxesPercent = parseFloat(document.getElementById('coec_taxes_percent').value) || 0;
            const feesAmount = parseFloat(document.getElementById('coec_fees_amount').value) || 0;

            // Calculate taxes and total
            const taxes = subtotal * (taxesPercent / 100);
            const total = subtotal + taxes + feesAmount;

            // Update display
            document.getElementById('coec_subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('coec_taxes_display').textContent = `$${taxes.toFixed(2)}`;
            document.getElementById('coec_fees_display').textContent = `$${feesAmount.toFixed(2)}`;
            document.getElementById('coec_total_display').textContent = `$${total.toFixed(2)}`;

            return { subtotal, taxes, fees: feesAmount, total };
        }

        /**
         * Calculate detailed COE pricing breakdown with event-specific pricing
         */
        function calculateCOEPricingBreakdown() {
            const taxesPercent = parseFloat(document.getElementById('coec_taxes_percent').value) || 0;
            const feesAmount = parseFloat(document.getElementById('coec_fees_amount').value) || 0;

            // Group seats by event
            const eventPricing = {};
            coecSelectedSeats.forEach(seat => {
                const eventId = seat.event_id;
                if (!eventPricing[eventId]) {
                    const event = coecSelectedEvents.find(e => e._id === eventId);
                    eventPricing[eventId] = {
                        event_id: eventId,
                        event_name: event?.name || 'Unknown Event',
                        event_date: event?.start_datetime || new Date(),
                        tables: []
                    };
                }
                
                eventPricing[eventId].tables.push({
                    table_id: seat.seat_id,
                    table_code: seat.seat_code || 'TBD',
                    base_price: seat.base_price || 0,
                    event_price: seat.event_price || seat.base_price || 0,
                    price_difference: (seat.event_price || seat.base_price || 0) - (seat.base_price || 0)
                });
            });

            // Calculate subtotals for each event
            let totalSubtotal = 0;
            const events = Object.values(eventPricing);
            events.forEach(event => {
                event.event_subtotal = event.tables.reduce((sum, table) => sum + table.event_price, 0);
                totalSubtotal += event.event_subtotal;
            });

            // Calculate overall totals
            const taxes = totalSubtotal * (taxesPercent / 100);
            const total = totalSubtotal + taxes + feesAmount;

            return {
                subtotal: totalSubtotal,
                taxes: taxes,
                fees: feesAmount,
                total: total,
                pricing_breakdown: {
                    events: events,
                    subtotal: totalSubtotal,
                    taxes: taxes,
                    fees: feesAmount,
                    total: total
                }
            };
        }

