                                <div style="max-height: 200px; overflow-y: auto;">
                                    ${eventsHtml}
                                </div>
                            </div>
                            
                            <div>
                                <h3 style="color: #2c3e50; margin-bottom: 10px;">Selected Tables (${seatsCount})</h3>
                                <div style="max-height: 200px; overflow-y: auto;">
