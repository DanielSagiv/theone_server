        /**
         * Handle COE preferences form submission
         * @param {Event} event - Form submit event
         */
        async function handleCOEPreferencesSubmit(event) {
            event.preventDefault();
            
            const form = event.target;
            const formData = new FormData(form);
            
            // Get form values
            const city = formData.get('city');
            const startDate = formData.get('start_date');
            const endDate = formData.get('end_date');
            const budget = parseFloat(formData.get('budget'));
            const partySize = parseInt(formData.get('party_size'));
            const seatPreferences = formData.get('seat_preferences') || '';
            const specificPreferences = formData.get('specific_preferences') || '';
            
            // Validate city
            if (!city || city.trim() === '') {
                showAlert('Please select a city', 'error');
                return;
            }
            
            // Validate dates
            if (new Date(endDate) < new Date(startDate)) {
                showAlert('End date must be on or after start date', 'error');
                return;
            }
            
            // Validate budget
            if (!budget || budget <= 0) {
                showAlert('Please enter a valid budget amount', 'error');
                return;
            }
            
            // Validate party size
            if (!partySize || partySize < 1) {
                showAlert('Please enter a valid number of people (minimum 1)', 'error');
                return;
            }
            
            // Build preferences message to send to bot
            let preferencesMessage = `Build my experience with the following preferences:\n`;
            preferencesMessage += `City: ${city}\n`;
            preferencesMessage += `Start date: ${startDate}\n`;
            preferencesMessage += `End date: ${endDate}\n`;
            preferencesMessage += `Budget: $${budget} USD\n`;
            preferencesMessage += `Number of people: ${partySize}\n`;
            if (seatPreferences) {
                preferencesMessage += `Seat/Table preferences: ${seatPreferences}\n`;
            }
            if (specificPreferences) {
                preferencesMessage += `Specific preferences: ${specificPreferences}\n`;
            }
            
            // Send preferences to bot
            const promptInput = document.getElementById('botPromptInput');
            if (promptInput) {
                promptInput.value = preferencesMessage.trim();
                sendBotPrompt();
            }
        }

