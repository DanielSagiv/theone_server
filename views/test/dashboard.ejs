            // Add hotel-specific attributes
            if (locationType === 'hotel') {
                const hotelAttrs = [
                    { key: 'stars', label: 'Stars (1-5)', type: 'number', min: 1, max: 5 },
                    { key: 'brand', label: 'Brand', type: 'text' },
                    { key: 'checkInTime', label: 'Check-in Time', type: 'text' },
