        /**
         * Set current step in create event modal
         */
        function setCeStep(step) {
            currentEventStep = step;
            
            // Hide all steps
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`ce_step${i}`).style.display = 'none';
                document.getElementById(`ce_step${i}_badge`).style.opacity = '0.6';
            }
            
            // Show current step
            document.getElementById(`ce_step${step}`).style.display = 'block';
            document.getElementById(`ce_step${step}_badge`).style.opacity = '1';
            
            // Update buttons
            const backBtn = document.querySelector('#createEventModal .modal-footer .btn-secondary');
            const nextBtn = document.getElementById('ce_next_btn');
            const createBtn = document.getElementById('ce_create_btn');
            
            backBtn.style.display = step > 1 ? 'inline-block' : 'none';
            nextBtn.style.display = step < 4 ? 'inline-block' : 'none';
            createBtn.style.display = step === 4 ? 'inline-block' : 'none';
        }

        /**
         * Next step in create event modal
         */
        function nextCeStep() {
            if (validateCeStep(currentEventStep)) {
                if (currentEventStep < 4) {
                    setCeStep(currentEventStep + 1);
                    if (currentEventStep === 4) {
                        updateCeReview();
                    }
                }
            }
        }

        /**
         * Previous step in create event modal
         */
        function prevCeStep() {
            if (currentEventStep > 1) {
                setCeStep(currentEventStep - 1);
            }
        }

        /**
         * Validate current step in create event modal
         */
        function validateCeStep(step) {
            // Clear previous validation indicators
            clearCeValidationIndicators();
            
            switch (step) {
                case 1:
                    const name = document.getElementById('ce_name').value.trim();
                    const startDate = document.getElementById('ce_start_datetime').value;
                    
                    if (!name) {
                        addCeFieldValidation('ce_name', 'Event name is required');
                        return false;
                    }
                    if (!startDate) {
                        addCeFieldValidation('ce_start_datetime', 'Start date and time is required');
                        return false;
                    }
                    return true;
                    
                case 2:
                    const locationId = document.getElementById('ce_location_id').value;
                    if (!locationId) {
                        addCeFieldValidation('ce_location_id', 'Please select a location');
                        return false;
                    }
                    return true;
                    
                case 3:
                    const basePrice = document.getElementById('ce_base_price').value;
                    if (!basePrice || parseFloat(basePrice) < 0) {
                        addCeFieldValidation('ce_base_price', 'Base price must be a positive number');
                        return false;
                    }
                    return true;
                    
                default:
                    return true;
            }
        }

        /**
         * Clear all event validation indicators
         */
        function clearCeValidationIndicators() {
            const fields = ['ce_name', 'ce_start_datetime', 'ce_location_id', 'ce_base_price'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.style.borderColor = '';
                    field.style.backgroundColor = '';
                }
            });
            
            const validationMsgs = document.querySelectorAll('.ce-validation-msg');
            validationMsgs.forEach(msg => msg.remove());
        }

        /**
         * Add event field validation indicator
         */
        function addCeFieldValidation(fieldId, message) {
            const field = document.getElementById(fieldId);
            if (field) {
                field.style.borderColor = '#e74c3c';
                field.style.backgroundColor = '#fdf2f2';
                
                const existingMsg = field.parentNode.querySelector('.ce-validation-msg');
                if (!existingMsg) {
                    const msgDiv = document.createElement('div');
                    msgDiv.className = 'ce-validation-msg';
                    msgDiv.style.color = '#e74c3c';
                    msgDiv.style.fontSize = '12px';
                    msgDiv.style.marginTop = '4px';
                    msgDiv.textContent = message;
                    field.parentNode.appendChild(msgDiv);
                }
            }
        }

        /**
         * Handle location selection change
         */
        async function onCeLocationChange() {
            const locationId = document.getElementById('ce_location_id').value;
            const preview = document.getElementById('ce_location_preview');
            const details = document.getElementById('ce_location_details');
            
            if (!locationId) {
                preview.style.display = 'none';
                return;
            }
            
            try {
                const result = await makeApiRequest(`/locations/${locationId}`);
                if (result.success && result.data) {
                    const location = result.data.data || result.data;
                    details.innerHTML = `
                        <p><strong>${location.name}</strong> - ${location.type.replace('_', ' ').toUpperCase()}</p>
                        <p>Seats: ${location.seats?.length || 0} | Units: ${location.units?.length || 0}</p>
                        <p>Total Capacity: ${(location.seats?.reduce((sum, seat) => sum + (seat.capacity || 0), 0) || 0) + (location.units?.reduce((sum, unit) => sum + (unit.occupancy || 0), 0) || 0)}</p>
                        <p>City: ${location.address?.city || 'N/A'} | Country: ${location.address?.country || 'N/A'}</p>
                    `;
                    preview.style.display = 'block';
                }
            } catch (error) {
                console.error('Error loading location details:', error);
            }
