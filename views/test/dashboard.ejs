            }
        }

        function createBotAvatar(role) {
            const avatar = document.createElement('div');
            avatar.className = 'bot-avatar';

            if (role === 'assistant') {
                const img = document.createElement('img');
                img.src = '/images/logo.png';
                img.alt = 'Bot';
