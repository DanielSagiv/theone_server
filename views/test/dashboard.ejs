        /**
         * Pagination controls for events
         */
        function renderEventsPagination() {
            const prevBtn = document.getElementById('eventsPrevBtn');
            const nextBtn = document.getElementById('eventsNextBtn');
            const pageInfo = document.getElementById('eventsPageInfo');
            const totalInfo = document.getElementById('eventsTotalInfo');
            const headerTotal = document.getElementById('eventsHeaderTotal');
            const pageSizeEl = document.getElementById('eventsPageSize');

            if (pageInfo) pageInfo.textContent = `Page ${eventsPage} of ${eventsTotalPages}`;
            if (totalInfo) totalInfo.textContent = `${eventsTotal} total`;
            if (headerTotal) headerTotal.textContent = `(${eventsTotal} total)`;
            if (prevBtn) prevBtn.disabled = eventsPage <= 1;
            if (nextBtn) nextBtn.disabled = eventsPage >= eventsTotalPages;
            if (pageSizeEl) pageSizeEl.value = String(eventsLimit);
        }

        function prevEventsPage() {
            if (eventsPage > 1) loadEvents(eventsPage - 1);
        }

        function nextEventsPage() {
            if (eventsPage < eventsTotalPages) loadEvents(eventsPage + 1);
        }

        function changeEventsPageSize(size) {
            const newSize = parseInt(size) || 20;
            if (newSize !== eventsLimit) {
                eventsLimit = newSize;
                loadEvents(1);
            }
        }

