        async function handleSeatAssetSelected(e) {
            const file = e.target.files && e.target.files[0];
            if (!file || !seatUploadTargetTd) return;
            try {
                const form = new FormData();
                form.append('asset', file);
                const resp = await fetch('/v1/locations/media/upload', { method: 'POST', headers: currentToken ? { 'Authorization': `Bearer ${currentToken}` } : {}, body: form, cache: 'no-store' });
                const result = await resp.json();
                console.log('Seat media upload response:', result);
                if (resp.ok && result.success && result.data?.url) {
                    // add a seat media row
                    const container = seatUploadTargetTd.querySelector('.cl_seat_media_container');
                    const row = document.createElement('div');
                    row.className = 'cl_seat_media_row';
                    row.style.marginTop = '6px';
                    console.log('Creating seat media row with type:', result.data.type);
                    row.innerHTML = `
                        <select class="cl_seat_media_type">
                            <option value="image" ${result.data.type === 'image' ? 'selected' : ''}>Image</option>
                            <option value="video" ${result.data.type === 'video' ? 'selected' : ''}>Video</option>
