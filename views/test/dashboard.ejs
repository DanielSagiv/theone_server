            });
            
            const card = document.createElement('div');
            card.className = 'bot-structured-card bot-error-card';
            
            const details = errorData.details || {};
            const attempts = details.attempts || [];
            const suggestions = details.suggestions || [];
            const specificReason = errorData.specific_reason || details.primary_reason;
            const eventDiagnostics = details.event_diagnostics || [];
            
            console.log('[FRONTEND] renderErrorResponse extracted values:', {
                specificReason: specificReason,
                eventDiagnosticsCount: eventDiagnostics.length,
                hasSuggestions: suggestions.length > 0
            });
            
            // Build reason label for display
            let reasonLabel = '';
            if (specificReason) {
                const reasonLabels = {
                    'NO_SEATS_IN_EVENT': 'No Seats in Event',
                    'NO_AVAILABLE_SEATS': 'No Available Seats',
                    'CAPACITY_TOO_SMALL': 'Capacity Too Small',
                    'BUDGET_TOO_LOW': 'Budget Too Low',
                    'EXCLUDED_BY_PREFERENCES': 'Excluded by Preferences',
                    'ALL_EVENTS_EXCLUDED_BY_PREFERENCES': 'All Events Excluded',
                    'MULTIPLE_FILTERS': 'Multiple Filters',
                    'NO_EVENTS_IN_DATE_RANGE': 'No Events in Date Range'
                };
                reasonLabel = reasonLabels[specificReason] || specificReason.replace(/_/g, ' ');
            }
            
            let html = `
                <div class="bot-error-header">
                    <h3>Unable to Find Available Seats</h3>
                    ${reasonLabel ? `<div class="bot-error-reason-badge">${reasonLabel}</div>` : ''}
                </div>
                <div class="bot-error-body">
                    <p class="bot-error-message">${errorData.message || 'We couldn\'t find any available seats/tables matching your preferences.'}</p>
                    
                    ${details.searched_dates ? `
                        <div class="bot-error-detail">
                            <strong>Searched Dates:</strong> 
                            ${new Date(details.searched_dates.start).toLocaleDateString()} - ${new Date(details.searched_dates.end).toLocaleDateString()}
                        </div>
                    ` : ''}
                    
                    ${details.searched_city ? `
                        <div class="bot-error-detail">
                            <strong>City:</strong> ${details.searched_city}
                        </div>
                    ` : ''}
                    
                    ${details.budget_range ? `
                        <div class="bot-error-detail">
                            <strong>Budget:</strong> $${details.budget_range.max.toLocaleString()}
                        </div>
                    ` : ''}
                    
                    ${details.party_size ? `
                        <div class="bot-error-detail">
                            <strong>Party Size:</strong> ${details.party_size} people
                        </div>
                    ` : ''}
                    
                    ${eventDiagnostics.length > 0 ? `
                        <div class="bot-error-diagnostics">
                            <strong>Event Details:</strong>
                            <div class="bot-error-diagnostics-list">
                                ${eventDiagnostics.slice(0, 3).map(diag => `
                                    <div class="bot-error-diagnostic-item">
                                        <div class="bot-error-diagnostic-event">${diag.event_name || 'Unknown Event'}</div>
                                        ${diag.reason ? `<div class="bot-error-diagnostic-reason">Reason: ${diag.reason.replace(/_/g, ' ')}</div>` : ''}
                                        ${diag.details && Object.keys(diag.details).length > 0 ? `
                                            <div class="bot-error-diagnostic-details">
                                                ${diag.details.capacity_too_small ? `
                                                    <span>Max capacity: ${diag.details.capacity_too_small.max_capacity_found} people</span>
                                                ` : ''}
                                                ${diag.details.budget_too_low ? `
                                                    <span>Min price: $${Math.ceil(diag.details.budget_too_low.min_seat_price || 0).toLocaleString()}</span>
                                                ` : ''}
                                                ${diag.details.no_available_seats ? `
                                                    <span>Available: ${diag.details.no_available_seats.available}/${diag.details.no_available_seats.total} seats</span>
                                                ` : ''}
                                            </div>
                                        ` : ''}
                                    </div>
                                `).join('')}
                                ${eventDiagnostics.length > 3 ? `<div class="bot-error-diagnostic-more">+${eventDiagnostics.length - 3} more events</div>` : ''}
                            </div>
                        </div>
                    ` : ''}
                    
                    ${attempts.length > 0 ? `
                        <div class="bot-error-attempts">
                            <strong>Search Attempts:</strong>
                            <div class="bot-error-attempts-list">
                                ${attempts.map(attempt => `
                                    <div class="bot-error-attempt-item">
                                        <div class="bot-error-attempt-strategy">${attempt.strategy.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</div>
                                        <div class="bot-error-attempt-details">
                                            <span>Events tried: ${attempt.events_tried}</span>
                                            ${attempt.locations_tried && attempt.locations_tried.length > 0 ? `
                                                <span>Locations: ${attempt.locations_tried.slice(0, 3).join(', ')}${attempt.locations_tried.length > 3 ? '...' : ''}</span>
                                            ` : ''}
                                            ${attempt.events_with_seats > 0 ? `
                                                <span class="bot-error-success">Found ${attempt.events_with_seats} events with seats</span>
                                            ` : `
                                                <span class="bot-error-failure">No seats found</span>
                                            `}
                                        </div>
                                        ${attempt.reason ? `<div class="bot-error-attempt-reason">${attempt.reason}</div>` : ''}
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    ` : ''}
                    
                    ${suggestions.length > 0 ? `
                        <div class="bot-error-suggestions">
                            <strong>Suggestions:</strong>
                            <ul class="bot-error-suggestions-list">
                                ${suggestions.map(suggestion => `<li>${suggestion}</li>`).join('')}
                            </ul>
                        </div>
                    ` : ''}
                </div>
            `;
            
            card.innerHTML = html;
            return card;
        }

