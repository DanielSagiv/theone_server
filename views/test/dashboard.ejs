            document.getElementById('el_description').value = location.description || '';
            document.getElementById('el_address_line1').value = location.address?.line1 || '';
            document.getElementById('el_address_line2').value = location.address?.line2 || '';
            document.getElementById('el_city').value = location.address?.city || '';
            document.getElementById('el_state').value = location.address?.state || '';
            document.getElementById('el_postalCode').value = location.address?.postalCode || '';
            document.getElementById('el_country').value = location.address?.country || '';
            document.getElementById('el_score').value = location.score || 0;
