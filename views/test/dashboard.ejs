        /**
         * BOT helper utilities
         */
        function setBotLoading(isLoading, hintOverride) {
            botLoading = !!isLoading;

            const sendBtn = document.getElementById('botSendButton');
            if (sendBtn) {
                sendBtn.disabled = !!isLoading;
                sendBtn.textContent = isLoading ? 'Sending...' : 'Send';
            }

            const hint = document.getElementById('botStatusHint');
            if (hint) {
                hint.textContent = hintOverride || (isLoading
                    ? 'Waiting for bot response...'
                    : 'Connected to bot sandbox. Responses may take a moment.');
            }

            const feed = document.getElementById('botResponseFeed');
            if (!feed) return;

            let indicator = document.getElementById('botLoadingIndicator');
            if (isLoading) {
                if (!indicator) {
                    indicator = document.createElement('div');
                    indicator.id = 'botLoadingIndicator';
                    indicator.className = 'bot-loading-indicator';
                    indicator.innerHTML = '<div class="spinner"></div><span>Generating response...</span>';
                    feed.appendChild(indicator);
                }
            } else if (indicator) {
                indicator.remove();
            }
        }

