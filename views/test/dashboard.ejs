                }
                const body = {
                    coe_id: coeId,
                    amount,
                    description,
                    charge_method: chargeMethod,
                    adhoc_payer: {
                        type: document.getElementById('adhocPayerType').value,
                        display_name: document.getElementById('adhocDisplayName').value.trim() || undefined,
                    },
                };
                const eventId = document.getElementById('adhocEventId').value.trim();
                if (eventId) body.event_id = eventId;
                if (chargeMethod === 'saved_card') {
                    body.payer_user_id = document.getElementById('adhocPayerUserId').value.trim();
                    body.token_id = document.getElementById('adhocTokenId').value.trim();
                } else {
                    body.payer_user_id = document.getElementById('adhocPayerUserId').value.trim() || undefined;
                    body.card = {
