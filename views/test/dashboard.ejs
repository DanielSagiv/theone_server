                                        <span class="label">Frequency:</span>
                                        <span class="value">${sub.frequency.charAt(0).toUpperCase() + sub.frequency.slice(1)}</span>
                                    </div>
                                    
                                    <div class="subscription-row">
                                        <span class="label">Amount:</span>
                                        <span class="value amount">$${sub.amount}</span>
                                    </div>
                                    
                                    <div class="subscription-row">
                                        <span class="label">Next Billing:</span>
                                        <span class="value">${sub.next_billing_date ? new Date(sub.next_billing_date).toLocaleDateString() : 'N/A'}</span>
                                    </div>
                                    
                                    ${sub.created_at ? `
                                    <div class="subscription-row">
                                        <span class="label">Started:</span>
                                        <span class="value">${new Date(sub.created_at).toLocaleDateString()}</span>
                                    </div>
                                    ` : ''}
                                </div>
                                
                                <div class="subscription-actions">
                                    ${sub.status === 'active' ? 
                                        `<button class="btn-cancel" onclick="cancelSubscription('${sub._id}')">Cancel Subscription</button>` :
                                        '<span class="no-actions">No actions available</span>'
                                    }
                                </div>
                            </div>
                        `;
                    });
                    
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    document.getElementById('subscriptionsContainer').innerHTML = '<p class="text-muted">Failed to load subscriptions</p>';
                }
            } catch (error) {
                console.error('Error loading subscriptions:', error);
                showAlert('Failed to load subscriptions', 'error');
            }
        }

        /**
         * Load membership pricing
         */
        async function loadPricing() {
            try {
                const result = await makeApiRequest('/subscriptions/pricing', 'GET');
                console.log('Pricing API response:', result);
                
                if (result.success && result.data) {
                    const container = document.getElementById('pricingContainer');
                    
                    // Handle double-wrapped response structure
                    const apiData = result.data.data || result.data;
                    console.log('Pricing API data:', apiData);
                    const pricing = apiData.pricing;
                    const tiers = apiData.tiers;
                    
                    let html = '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">';
                    
                    Object.keys(pricing).forEach(tierKey => {
                        const tier = tiers[tierKey];
                        const prices = pricing[tierKey];
                        
                        html += `
                        <div style="border: 2px solid #e1e8ed; border-radius: 8px; padding: 20px; background: white;">
                            <h3 style="color: #2c3e50; margin-bottom: 10px;">${tier.name}</h3>
                            <div style="margin-bottom: 15px;">
                                <div style="font-size: 24px; font-weight: bold; color: #27ae60;">$${prices.monthly}/mo</div>
                                <div style="font-size: 14px; color: #7f8c8d;">or $${prices.yearly}/year</div>
                            </div>
                            <div style="margin-bottom: 15px;">
                                <strong>Benefits:</strong>
                                <ul style="margin-top: 5px; padding-left: 20px;">
                                    ${tier.benefits.map(b => `<li style="margin: 5px 0;">${b}</li>`).join('')}
                                </ul>
                            </div>
                        </div>`;
                    });
                    
                    html += '</div>';
                    container.innerHTML = html;
                } else {
                    document.getElementById('pricingContainer').innerHTML = '<p class="text-muted">Failed to load pricing</p>';
                }
            } catch (error) {
                console.error('Error loading pricing:', error);
            }
        }

        /**
         * Load payment history for COE
         */
        async function loadPaymentHistory() {
            try {
                const coeId = document.getElementById('paymentHistoryCOEId').value.trim();
                if (!coeId) {
                    showAlert('Please enter a COE ID', 'error');
                    return;
                }
                
                const result = await makeApiRequest(`/payments/coe/${coeId}`, 'GET');
                
                if (result.success && result.data) {
                    const container = document.getElementById('paymentHistoryContainer');
                    const payments = result.data;
                    
                    if (payments.length === 0) {
                        container.innerHTML = '<p class="text-muted">No payments found for this COE</p>';
                        return;
                    }
                    
                    let html = '<div class="table-container"><table class="data-table"><thead><tr>';
                    html += '<th>ID</th><th>Type</th><th>Amount</th><th>Status</th><th>Card</th><th>Date</th>';
                    html += '</tr></thead><tbody>';
                    
                    payments.forEach(payment => {
                        const statusClass = payment.status === 'completed' ? 'badge-success' : 
                                          payment.status === 'refunded' ? 'badge-warning' : 
                                          payment.status === 'failed' ? 'badge-danger' : 'badge-info';
                        html += '<tr>';
                        html += `<td><code>${payment._id.substring(0, 8)}...</code></td>`;
                        html += `<td>${payment.payment_type}</td>`;
                        html += `<td>$${payment.amount.toFixed(2)}</td>`;
                        html += `<td><span class="${statusClass}">${payment.status.toUpperCase()}</span></td>`;
                        html += `<td>${payment.card_brand ? payment.card_brand + ' •••• ' + payment.card_last_four : 'N/A'}</td>`;
                        html += `<td>${new Date(payment.created_at).toLocaleDateString()}</td>`;
                        html += '</tr>';
                    });
                    
                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                } else {
                    document.getElementById('paymentHistoryContainer').innerHTML = '<p class="text-muted">Failed to load payment history</p>';
                }
            } catch (error) {
                console.error('Error loading payment history:', error);
                showAlert('Failed to load payment history', 'error');
            }
        }

        /**
         * Show tokenize card modal
         */
        function showTokenizeCardModal() {
            const cardNumber = prompt('Enter card number (test card: 4263970000005262):');
            if (!cardNumber) return;
            
            const expiryMonth = prompt('Enter expiry month (MM):');
            if (!expiryMonth) return;
            
            const expiryYear = prompt('Enter expiry year (YY):');
            if (!expiryYear) return;
            
            const cvv = prompt('Enter CVV:');
            if (!cvv) return;
            
            const nickname = prompt('Enter nickname (optional):') || '';
            
            tokenizeCard(cardNumber, expiryMonth, expiryYear, cvv, nickname);
        }

        /**
         * Tokenize card
         */
        async function tokenizeCard(number, expiryMonth, expiryYear, cvv, nickname) {
            try {
                const requestData = {
                    cardDetails: {
                        number,
                        expiry_month: expiryMonth,
                        expiry_year: expiryYear,
                        cvv,
                        nickname
                    },
                    setAsDefault: true
                };
                
                console.log('Tokenizing card with data:', requestData);
                const result = await makeApiRequest('/payments/tokenize', 'POST', requestData);
                console.log('Tokenization result:', result);
                
                if (result.success) {
                    showAlert('Card saved successfully!', 'success');
                    loadSavedCards();
                } else {
                    console.error('Tokenization failed:', result);
                    showAlert('Failed to save card: ' + (result.error?.message || result.data?.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error tokenizing card:', error);
                showAlert('Failed to save card: ' + error.message, 'error');
            }
        }

        /**
         * Remove saved card
         */
        async function removeSavedCard(tokenId) {
            if (!confirm('Are you sure you want to remove this payment method?')) return;
            
            try {
                const result = await makeApiRequest(`/payments/saved-cards/${tokenId}`, 'DELETE');
                
                if (result.success) {
                    showAlert('Payment method removed', 'success');
                    loadSavedCards();
                } else {
                    showAlert('Failed to remove payment method', 'error');
                }
            } catch (error) {
                console.error('Error removing card:', error);
                showAlert('Failed to remove payment method', 'error');
            }
        }

        /**
         * Set default card
         */
        async function setDefaultCard(tokenId) {
            try {
                const result = await makeApiRequest(`/payments/saved-cards/${tokenId}/default`, 'PUT');
                
                if (result.success) {
                    showAlert('Default payment method updated', 'success');
                    loadSavedCards();
                } else {
                    showAlert('Failed to update default payment method', 'error');
                }
            } catch (error) {
                console.error('Error setting default card:', error);
                showAlert('Failed to update default payment method', 'error');
            }
        }

        /**
         * Show subscribe modal
         */
        function showSubscribeModal() {
            const tier = prompt('Enter tier (basic, premium, vip, elite):');
            if (!tier) return;
            
            const frequency = prompt('Enter frequency (monthly, yearly):');
            if (!frequency) return;
            
            // Get saved cards first
            makeApiRequest('/payments/saved-cards', 'GET').then(result => {
                console.log('showSubscribeModal - API result:', result);
                
                // Handle double-wrapped response structure
                const apiData = result.data.data || result.data;
                console.log('showSubscribeModal - apiData:', apiData);
                
                if (!result.success || !apiData.saved_cards || apiData.saved_cards.length === 0) {
                    console.log('showSubscribeModal - No saved cards found:', {
                        success: result.success,
                        hasData: !!apiData,
                        hasSavedCards: !!apiData.saved_cards,
                        savedCardsLength: apiData.saved_cards ? apiData.saved_cards.length : 0
                    });
                    showAlert('Please save a payment method first!', 'error');
                    return;
                }
                
                console.log('showSubscribeModal - Found saved cards, creating subscription...');
                const tokenId = apiData.saved_cards[0].token_id;
                createSubscription(tier, frequency, tokenId);
            });
        }

        /**
         * Create subscription
         */
        async function createSubscription(tier, frequency, tokenId) {
            try {
                const result = await makeApiRequest('/subscriptions', 'POST', {
                    tier,
                    frequency,
                    payment_token_id: tokenId
                });
                
                if (result.success) {
                    showAlert(`Subscription created! First payment of $${result.data.first_payment.amount} processed.`, 'success');
                    loadSubscriptions();
                } else {
                    showAlert('Failed to create subscription: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error creating subscription:', error);
                showAlert('Failed to create subscription', 'error');
            }
        }

        /**
         * Cancel subscription
         */
        async function cancelSubscription(subscriptionId) {
            const reason = prompt('Cancellation reason (optional):') || '';
            
            if (!confirm('Are you sure you want to cancel this subscription? You will keep access until the end of the current billing period.')) {
                return;
            }
            
            try {
                const result = await makeApiRequest(`/subscriptions/${subscriptionId}/cancel`, 'POST', { reason });
                
                if (result.success) {
                    showAlert('Subscription cancelled. Access continues until: ' + new Date(result.data.access_until).toLocaleDateString(), 'success');
                    loadSubscriptions();
                } else {
                    showAlert('Failed to cancel subscription', 'error');
                }
            } catch (error) {
                console.error('Error cancelling subscription:', error);
                showAlert('Failed to cancel subscription', 'error');
            }
        }

        /**
         * Load payments section data
         */
        function loadPaymentsSection() {
            // Small delay to ensure DOM is ready
            setTimeout(() => {
                // Load data for the currently active tab
                const activeTab = document.querySelector('.tab-button.active');
                console.log('Active tab found:', activeTab);
                
                if (activeTab) {
                    const tabName = activeTab.id.replace('tab-', '');
                    console.log('Switching to tab:', tabName);
                    switchPaymentTab(tabName);
                } else {
                    // Default to saved cards tab
                    console.log('No active tab found, defaulting to saved-cards');
                    switchPaymentTab('saved-cards');
                }
            }, 100);
        }

    </script>
</body>
</html>
