        // ==================== EVENT PRICING FUNCTIONS ====================

        function showFieldError(inputEl, message) {
            const container = inputEl.closest('.form-field') || inputEl.parentElement;
            let err = container.querySelector('.field-error');
            if (!err) {
                err = document.createElement('div');
                err.className = 'field-error';
                err.style.color = '#e74c3c';
                err.style.fontSize = '12px';
                err.style.marginTop = '4px';
                container.appendChild(err);
            }
            err.textContent = message;
            inputEl.style.borderColor = '#e74c3c';
        }

        function clearFieldError(inputEl) {
            const container = inputEl.closest('.form-field') || inputEl.parentElement;
            const err = container.querySelector('.field-error');
            if (err) err.remove();
            inputEl.style.borderColor = '';
        }

        function validatePricingRow(row) {
            let valid = true;
            const baseEl = row.querySelector('.base-price');
            const eventEl = row.querySelector('.event-price');
            const reasonEl = row.querySelector('.reason');
            clearFieldError(baseEl); 
            clearFieldError(eventEl); 
            if (reasonEl) clearFieldError(reasonEl);

            const base = parseFloat(baseEl.value);
            const ev = parseFloat(eventEl.value);
            if (isNaN(base)) { 
                showFieldError(baseEl, 'Base price is required'); 
                valid = false; 
            } else if (base < 0) { 
                showFieldError(baseEl, 'Base price cannot be negative'); 
                valid = false; 
            }
            if (isNaN(ev)) { 
                showFieldError(eventEl, 'Event price is required'); 
                valid = false; 
            } else if (ev < 0) { 
                showFieldError(eventEl, 'Event price cannot be negative'); 
                valid = false; 
            }

            const changed = !isNaN(base) && !isNaN(ev) && ev !== base;
            if (changed && reasonEl && !reasonEl.value.trim()) {
                showFieldError(reasonEl, 'Reason is required when price changes');
                valid = false;
            }
            return valid;
        }

        function rowToPayload(row) {
            return {
                // Prefer stable event seat id for identification; keep code for display/logging
                seat_id: row.getAttribute('data-seat-id'),
                seat_code: row.getAttribute('data-seat-code'),
                base_price: parseFloat(row.querySelector('.base-price').value),
                event_price: parseFloat(row.querySelector('.event-price').value),
                price_change_reason: (row.querySelector('.reason').value || '').trim()
            };
        }

        async function updateSingleTablePrice(eventId, row) {
            if (!validatePricingRow(row)) { 
                showAlert('Fix errors in this row', 'error'); 
                return; 
            }
            const payload = rowToPayload(row);
            const changed = payload.event_price !== payload.base_price;
            const body = {
                event_price: payload.event_price,
                price_change_reason: changed ? payload.price_change_reason : (payload.price_change_reason || 'No change')
            };
            const res = await makeApiRequest(`/events/${eventId}/pricing/${payload.seat_id}`, 'PUT', body);
            if (!res.success) return showAlert(res.error || 'Failed to update price', 'error');
            showAlert('Seat price updated', 'success');
        }

        async function saveAllPricing(eventId) {
            const rows = [...document.querySelectorAll('#eventPricingTable tbody tr')];
            let ok = true;
            rows.forEach(r => { if (!validatePricingRow(r)) ok = false; });
            if (!ok) { showAlert('Fix validation errors', 'error'); return; }

            // Update each seat individually
            for (const row of rows) {
                const payload = rowToPayload(row);
                const changed = payload.event_price !== payload.base_price;
                const body = {
                    event_price: payload.event_price,
                    price_change_reason: changed ? payload.price_change_reason : (payload.price_change_reason || 'No change')
                };
                const res = await makeApiRequest(`/events/${eventId}/pricing/${payload.seat_id}`, 'PUT', body);
                if (!res.success) {
                    showAlert(`Failed to update seat ${payload.seat_code}: ${res.error}`, 'error');
                    return;
                }
            }
            
            showAlert('All seat pricing updated successfully', 'success');
        }

