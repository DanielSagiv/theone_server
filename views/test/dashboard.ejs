                                        Full Refund ($${remainingRefundable.toLocaleString()})
                                    </button>
                                </div>
                                <div style="margin-bottom: 15px;">
                                    <label style="display: block; margin-bottom: 5px;">Or enter partial refund amount:</label>
                                    <input type="number" id="refundAmount" placeholder="Enter amount" min="0.01" max="${remainingRefundable}" step="0.01" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                                </div>
                            </div>
                            
                            <div style="margin-bottom: 20px;">
                                <label style="display: block; margin-bottom: 8px; font-weight: bold;">Refund Reason (Required)</label>
                                <textarea id="refundReason" placeholder="Enter reason for refund..." style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; min-height: 80px; resize: vertical;"></textarea>
                            </div>
                            
                            <div style="text-align: center;">
                                <button class="btn btn-warning" onclick="processCOERefund('${coeId}')" id="processRefundBtn" disabled>
                                    Process Refund
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
