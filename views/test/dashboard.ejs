            `;
            
            // Store pagination data and search term for navigation
            card.dataset.currentPage = pagination.page;
            card.dataset.totalPages = pagination.totalPages;
            // Extract search term from message if present (e.g., "Found X clients matching 'search'")
            const searchMatch = clientListData.message?.match(/matching\s+"([^"]+)"/);
            card.dataset.currentSearch = searchMatch ? searchMatch[1] : '';
            
            return card;
        }
        
        /**
         * Handle client search (debounced for typing)
         * @param {Event} event - Keyboard event
         * @param {string} searchTerm - Search term
         */
        let clientSearchTimeout;
        function handleClientSearch(event, searchTerm) {
            console.log('[CLIENT LIST] handleClientSearch called:', { key: event?.key, searchTerm });
            // Clear previous timeout
            if (clientSearchTimeout) {
                clearTimeout(clientSearchTimeout);
            }
            
            // Store search term in the card for pagination
            const clientListCard = document.querySelector('.bot-client-list');
            if (clientListCard) {
                clientListCard.dataset.currentSearch = searchTerm.trim();
            }
            
            // Skip debounce for Enter key (handled by onkeydown)
            if (event.key === 'Enter') {
                console.log('[CLIENT LIST] Enter key detected, skipping debounce');
                return;
            }
            
            // Wait for user to stop typing (500ms delay)
            clientSearchTimeout = setTimeout(() => {
                const trimmedSearch = searchTerm.trim();
                console.log('[CLIENT LIST] Debounce timeout triggered, trimmed search:', trimmedSearch);
                if (trimmedSearch.length === 0 || trimmedSearch.length >= 2) {
                    triggerClientSearch(trimmedSearch);
                } else {
                    console.log('[CLIENT LIST] Search term too short, skipping');
                }
            }, 500);
        }
        
        /**
         * Handle client search click or immediate search (Enter key)
         * @param {string} searchTerm - Search term
         */
        function handleClientSearchClick(searchTerm) {
            console.log('[CLIENT LIST] Search click triggered with term:', searchTerm);
            // Clear any pending timeout
            if (clientSearchTimeout) {
                clearTimeout(clientSearchTimeout);
            }
            
            // Store search term in the card for pagination
            const clientListCard = document.querySelector('.bot-client-list');
            if (clientListCard) {
                clientListCard.dataset.currentSearch = searchTerm.trim();
            }
            
            // Trigger search immediately
            triggerClientSearch(searchTerm.trim());
        }
        
