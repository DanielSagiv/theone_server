        }

        .status-option.selected {
            border-color: #3498db;
            background: #e3f2fd;
        }

        .role-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .role-option {
            background: none;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .role-option:hover {
            border-color: #3498db;
            background: #f8f9fa;
        }

        .role-option.selected {
            border-color: #3498db;
            background: #e3f2fd;
        }

        /* Placeholder Content */
        .placeholder-content {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }


        .placeholder-content h3 {
            margin-bottom: 10px;
            color: #2c3e50;
        }

        /* Alerts */
        .alert {
            padding: 15px;
            margin: 15px 0;
            border-radius: 8px;
            display: none;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-info {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        /* Loading */
        .loading {
            display: none;
            text-align: center;
            padding: 40px;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Modal Styles */
        .modal {
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background-color: white;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

        .modal-header {
            padding: 20px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: #2c3e50;
        }

        .close {
            color: #aaa;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .close:hover {
            color: #000;
        }

        .modal-body {
            padding: 20px;
        }

        .profile-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .profile-field {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f8f9fa;
        }

        .profile-field label {
            font-weight: 600;
            color: #2c3e50;
            min-width: 120px;
        }

        .profile-field span {
            color: #7f8c8d;
            flex: 1;
            text-align: right;
        }

        .profile-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        .profile-section h3 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .profile-field a {
            color: #3498db;
            text-decoration: none;
            word-break: break-all;
        }

        .profile-field a:hover {
            text-decoration: underline;
        }

        .user-name {
            font-weight: 600;
            color: #2c3e50;
        }

        .user-name.clickable {
            cursor: pointer;
            color: #3498db;
            transition: all 0.3s ease;
        }

        .user-name.clickable:hover {
            color: #2980b9;
            text-decoration: underline;
        }
        
        /* Location table row styling */
        #locationsTableBody tr {
            transition: background-color 0.2s ease;
        }
        #locationsTableBody tr:hover {
            background-color: #f8f9fa;
        }

        /* Delete button styling */
        .btn-danger {
            background-color: #e74c3c;
            border-color: #e74c3c;
            color: white;
            padding: 4px 8px;
            font-size: 12px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn-danger:hover {
            background-color: #c0392b;
            border-color: #c0392b;
        }

        /* Icon button styling */
        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            margin: 0 2px;
        }

        .btn-icon:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        .btn-icon-view {
            background-color: #27ae60;
            color: white;
        }

        .btn-icon-view:hover {
            background-color: #229954;
        }

        .btn-icon-edit {
            background-color: #3498db;
            color: white;
        }

        .btn-icon-edit:hover {
            background-color: #2980b9;
        }

        .btn-icon-delete {
            background-color: #e74c3c;
            color: white;
        }

        .btn-icon-delete:hover {
            background-color: #c0392b;
        }

        /* Icon styles */
        .icon {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        .btn-sm {
            padding: 4px 8px;
            font-size: 12px;
        }

        /* Location Details Modal Styles */
        .location-modal-content {
            max-width: 1000px !important;
        }

        .location-details {
            padding: 20px;
        }

        .detail-section {
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }

        .detail-section:last-child {
            border-bottom: none;
        }

        .detail-section h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 18px;
            font-weight: 600;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
        }

        .detail-item label {
            font-weight: 600;
            color: #666;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .detail-item span {
            color: #333;
            font-size: 14px;
        }

        /* Main Media Gallery */
        .main-media-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .media-item {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.2s ease;
            background: #f8f9fa;
            border: 2px solid #e9ecef;
        }

        .media-item:hover {
            transform: scale(1.05);
            border-color: #007bff;
        }

        .media-item img,
        .media-item video {
            width: 100%;
            height: 120px;
            object-fit: cover;
            display: block;
        }

        .media-type-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }

        .media-caption {
            padding: 8px;
            font-size: 12px;
            color: #666;
            text-align: center;
            background: white;
        }

        .no-media-message {
            text-align: center;
            color: #999;
            font-style: italic;
            padding: 40px;
        }

        /* Seating Areas & Room Types */
        .seating-area,
        .room-type {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
        }

        .seating-area-header,
        .room-type-header {
            background: #f8f9fa;
            padding: 15px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e9ecef;
        }

        .seating-area-header:hover,
        .room-type-header:hover {
            background: #e9ecef;
        }

        .seating-area-title,
        .room-type-title {
            font-weight: 600;
            color: #333;
        }

        .seating-area-count,
        .room-type-count {
            color: #666;
            font-size: 14px;
        }

        .expand-icon {
            transition: transform 0.2s ease;
        }

        .seating-area.expanded .expand-icon,
        .room-type.expanded .expand-icon {
            transform: rotate(180deg);
        }

        .seating-area-content,
        .room-type-content {
            padding: 15px;
            display: none;
        }

        .seating-area.expanded .seating-area-content,
        .room-type.expanded .room-type-content {
            display: block;
        }

        .seating-items,
        .room-items {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .seat-item,
        .room-item {
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 12px;
            background: white;
        }

        .seat-code,
        .room-code {
            font-weight: 600;
            color: #007bff;
            margin-bottom: 8px;
        }

        .seat-details,
        .room-details {
            font-size: 12px;
            color: #666;
            margin-bottom: 10px;
        }

        .seat-media,
        .room-media {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .seat-media .media-item,
        .room-media .media-item {
            width: 60px;
            height: 60px;
        }

        .seat-media .media-item img,
        .room-media .media-item img,
        .seat-media .media-item video,
        .room-media .media-item video {
            height: 60px;
        }

        /* Lightbox Styles */
        .lightbox-content {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
            margin: auto;
            background: black;
            border-radius: 8px;
            overflow: hidden;
