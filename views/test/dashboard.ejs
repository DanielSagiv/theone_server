        function parseJsonContent(content) {
            if (typeof content !== 'string') return null;
            const trimmed = content.trim();
            if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) {
                return null;
            }

            try {
                return JSON.parse(trimmed);
            } catch (error) {
                return null;
            }
        }

