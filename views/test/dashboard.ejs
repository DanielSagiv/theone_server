        function createSeatItem(seat) {
            try {
            const mediaHtml = (seat.media || []).map(media => {
                if (media.type === 'image') {
                    return `<div class="media-item" onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})">
                        <img src="${media.url}" alt="${media.caption || 'Table image'}" loading="lazy">
                    </div>`;
                } else if (media.type === 'video') {
                    // Detect video format from URL
                    const videoType = media.url.toLowerCase().includes('.webm') ? 'video/webm' : 
                                    media.url.toLowerCase().includes('.mov') ? 'video/quicktime' :
                                    media.url.toLowerCase().includes('.avi') ? 'video/x-msvideo' :
                                    media.url.toLowerCase().includes('.bin') ? 'video/mp4' : // Handle .bin files as MP4
                                    'video/mp4';
                    
                    return `<div class="media-item" onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})">
                        <video preload="metadata" controls muted playsinline 
                               onerror="console.error('Seat video load error:', this.error)" 
                               onloadstart="console.log('Seat video loading started:', this.src)"
                               onclick="this.play(); event.stopPropagation();">
                            <source src="${media.url}" type="${videoType}">
                            Your browser does not support the video tag.
                        </video>
                        <div style="position: absolute; top: 5px; left: 5px; background: rgba(0,0,0,0.7); color: white; padding: 2px 5px; font-size: 10px; border-radius: 3px;">
                            <a href="${media.url}" target="_blank" style="color: white; text-decoration: none;">Test URL</a>
                        </div>
                    </div>`;
                }
                return '';
            }).join('');
            
            // Generate seat sentiments HTML
            const sentimentsHtml = (seat.sentiment || []).map((sentiment, index) => `
                <div class="sentiment-item" style="border: 1px solid #ecf0f1; border-radius: 8px; padding: 10px; margin-bottom: 8px; background: #f8f9fa;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                        <span class="sentiment-type" style="background: ${sentiment.type === 'A' ? '#3498db' : '#e74c3c'}; color: white; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: bold;">
                            Type ${sentiment.type}
                        </span>
                        <button class="btn btn-sm" onclick="deleteSeatSentiment('${seat.code}', ${index})" style="padding: 2px 6px; font-size: 11px; background: #e74c3c; color: white; border: none; border-radius: 3px;">Delete</button>
                    </div>
                    <div class="sentiment-text" style="color: #333; line-height: 1.3; font-size: 12px;">
                        ${sentiment.text || '<em>No text provided</em>'}
                    </div>
                    <div class="sentiment-meta" style="font-size: 10px; color: #666; margin-top: 5px;">
                        Added: ${new Date(sentiment.updatedAt).toLocaleDateString()}
                    </div>
                </div>
            `).join('');
            
            return `
                <div class="seat-item">
                    <div class="seat-code">Table ${seat.code}</div>
                    <div class="seat-details">
                        <div>Capacity: ${seat.capacity || '-'}</div>
                        <div>Min Spend: $${seat.minSpendUSD || 0}</div>
                        <div>Status: ${seat.status || '-'}</div>
                        ${seat.section ? `<div>Section: ${seat.section}</div>` : ''}
                    </div>
                        <div style="margin-top:8px; display:flex; gap:8px;">
                            <button class="btn btn-secondary" onclick="openAddSentimentModal('seat', '${seat.code}')">Add Sentiment</button>
                        </div>
                        ${sentimentsHtml ? `<div class="seat-sentiments" style="margin-top: 10px;"><h4 style="margin: 0 0 8px 0; font-size: 14px; color: #333;">Sentiments:</h4>${sentimentsHtml}</div>` : ''}
                    ${mediaHtml ? `<div class="seat-media">${mediaHtml}</div>` : ''}
                </div>
            `;
            } catch (error) {
                return `
                    <div class="seat-item" style="border: 1px solid #e74c3c; padding: 10px; margin: 5px; background: #fdf2f2;">
                        <div class="seat-code">Seat ${seat.code} (Error)</div>
                        <div style="color: #e74c3c; font-size: 12px;">Error: ${error.message}</div>
                </div>
            `;
            }
        }

