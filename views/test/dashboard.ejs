                            console.log('[COE List Frontend] Created event group:', {
                                eventId,
                                event_name: seatsByEvent[eventId].event_name,
                                event_date: seatsByEvent[eventId].event_date
                            });
                        }
                        seatsByEvent[eventId].seats.push(seat);
                    });
                    
                    const eventGroupsHtml = Object.values(seatsByEvent).map(eventGroup => {
                        // Build event-level runner details (display at bottom of event section if present)
                        const erMatch = (coe.events || []).find(e => {
                            const eventId = e.event_id?.toString() || e.event_id;
                            const groupEventId = eventGroup.event_id?.toString() || eventGroup.event_id;
                            return eventId === groupEventId;
                        });
                        const evRunner = erMatch?.runner_assignment?.runner || null;
                        const evRunnerStatus = erMatch?.runner_assignment?.status || null;
                        const eventRunnerDetailsHtml = evRunner
                            ? buildRunnerDetailsCard(evRunner, evRunnerStatus, 'Runner Details')
                            : '';
                        // Find matching event (to get location media and name)
                        const matchingEvent = (coe.events || []).find(e => {
                            const eventId = e.event_id?.toString() || e.event_id;
                            const groupEventId = eventGroup.event_id?.toString() || eventGroup.event_id;
                            return eventId === groupEventId;
                        });
                        
                        // Update event_name from matchingEvent if found (this ensures replaced events show correct name)
                        if (matchingEvent && matchingEvent.event_id && matchingEvent.event_id.name) {
                            eventGroup.event_name = matchingEvent.event_id.name;
                        } else if (matchingEvent && matchingEvent.name) {
                            eventGroup.event_name = matchingEvent.name;
                        }
                        
                        // Check if same-day alternatives exist (from event data or default to false)
                        const hasSameDayAlternatives = matchingEvent?.has_same_day_alternatives || false;

                        // Build location thumbnails (up to 3) and +X more
                        let locationThumbsHtml = '';
                        if (matchingEvent?.location?.media && matchingEvent.location.media.length > 0) {
                            const images = matchingEvent.location.media.filter(m => m && m.type === 'image');
                            const thumbs = images.slice(0, 3);
                            const remaining = images.length > 3 ? images.length - 3 : 0;
                            locationThumbsHtml = `
                                <div class="location-item-image-gallery" style="margin-top:8px;">
                                    ${thumbs.map(img => `
                                        <img src="${img.url}"
                                             alt="${img.caption || matchingEvent.location.name || 'Location image'}"
                                             class="location-item-thumbnail"
                                             onclick="openLightbox(${JSON.stringify(img).replace(/"/g, '&quot;')})"
                                             loading="lazy">
                                    `).join('')}
                                    ${remaining > 0 ? `
                                        <div class="location-item-more-images"
                                             onclick="openLightbox(${JSON.stringify(images[3] || images[0]).replace(/"/g, '&quot;')})"
                                             title="View all ${images.length} images">+${remaining}</div>
                                    ` : ''}
                                </div>
                                <div class="event-location-caption">${matchingEvent.location.name || ''}</div>
                            `;
                        }

                        // Generate seat items for carousel
                        const seatItems = eventGroup.seats.map((seat, seatIndex) => {
                            // Status badge with color
                            const statusClass = `coe-seat-status-${seat.status || 'selected'}`;
                            const statusLabel = (seat.status || 'selected').charAt(0).toUpperCase() + (seat.status || 'selected').slice(1);
                            
                            // Seat media thumbnails
                            const seatMedia = seat.media || [];
                            const imageMedia = seatMedia.filter(m => m && m.type === 'image');
                            
                            const seatMediaHtml = imageMedia.length > 0 ? `
                                <div class="coe-seat-media">
                                    ${imageMedia.slice(0, 4).map(media => `
                                        <img src="${media.url}" 
                                             alt="${media.caption || seat.seat_code || 'Seat image'}" 
                                             class="coe-seat-media-thumbnail"
                                             onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})"
                                             loading="lazy">
                                    `).join('')}
                                    ${imageMedia.length > 4 ? `
                                        <div class="coe-seat-media-thumbnail" style="display:flex;align-items:center;justify-content:center;background:rgba(30,41,59,0.8);color:#cbd5f5;font-size:0.7rem;">
                                            +${imageMedia.length - 4}
                                        </div>
                                    ` : ''}
                                </div>
                            ` : '<div class="coe-seat-media" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">No images available</div>';
                            
                            const totalCost = seat.event_price || seat.base_price || 0;
                            return `
                                <div class="coe-seat-carousel-slide" data-seat-index="${seatIndex}">
                                    <div class="coe-seat-item">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                            <div class="coe-seat-code">Table ${seat.seat_code || 'N/A'}</div>
                                            <span class="coe-seat-status-badge ${statusClass}">${statusLabel}</span>
                                        </div>
                                        <div class="coe-seat-costs">
                                            <div class="coe-seat-cost-item">
                                                <span class="coe-seat-cost-label">Capacity:</span>
                                                <span>${seat.capacity || 0}</span>
                                            </div>
                                            <div class="coe-seat-cost-item">
                                                <span class="coe-seat-cost-label">Base Price:</span>
                                                <span>$${seat.base_price || 0}</span>
                                            </div>
                                            <div class="coe-seat-cost-item">
                                                <span class="coe-seat-cost-label">Event Price:</span>
                                                <span>$${seat.event_price || seat.base_price || 0}</span>
                                            </div>
                                            <div class="coe-seat-cost-item">
                                                <span class="coe-seat-cost-label">Total Cost:</span>
                                                <span style="font-weight: 600; color: #60a5fa;">$${totalCost}</span>
                                            </div>
                                        </div>
                                        ${seatMediaHtml}
                                    </div>
                                </div>
                            `;
                        });
                        
                        // Build carousel HTML if multiple seats, otherwise just show single seat
                        const seatItemsHtml = eventGroup.seats.length > 1 ? `
                            <div class="coe-seat-carousel-container" data-event-group-id="${eventGroup.event_id || 'unknown'}">
                                <div class="coe-seat-carousel-wrapper">
                                    <div class="coe-seat-carousel-track">
                                        ${seatItems.join('')}
                                    </div>
                                </div>
                                <div class="coe-seat-carousel-controls">
                                    <button class="coe-seat-carousel-btn coe-seat-carousel-prev" onclick="slideSeatCarousel(this, -1)" aria-label="Previous table">
                                        ‹
                                    </button>
                                    <div class="coe-seat-carousel-indicators">
                                        ${eventGroup.seats.map((_, idx) => `
                                            <button class="coe-seat-carousel-dot ${idx === 0 ? 'active' : ''}" 
                                                    onclick="goToSeatSlide(this, ${idx})" 
                                                    aria-label="Go to table ${idx + 1}"></button>
                                        `).join('')}
                                    </div>
                                    <button class="coe-seat-carousel-btn coe-seat-carousel-next" onclick="slideSeatCarousel(this, 1)" aria-label="Next table">
                                        ›
                                    </button>
                                </div>
                            </div>
                        ` : seatItems.join('');
                        
                        const eventDate = eventGroup.event_date 
                            ? new Date(eventGroup.event_date).toLocaleDateString()
                            : 'Date TBD';
                        
                        return `
                            <div class="coe-seat-event-group">
                                <div class="coe-seat-event-header" onclick="toggleCoeSeatEvent(this)">
                                    <div>
                                        <span class="coe-seat-event-title">${eventGroup.event_name}</span>
                                        <span class="coe-seat-event-date">${eventDate}</span>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        ${(() => {
                                            const coeStatus = (coe.status || '').toLowerCase();
                                            const isDraft = coeStatus === 'draft';
                                            console.log('[COE_EVENT_ACTIONS] Status check:', {
                                                coeId: coe.id || coe._id,
                                                status: coe.status,
                                                coeStatus,
                                                isDraft,
                                                eventId: eventGroup.event_id
                                            });
                                            return isDraft ? `
                                                <button class="coe-event-action-btn" 
                                                        onclick="event.stopPropagation(); handleRemoveEvent('${coe.id || coe._id}', '${eventGroup.event_id}');" 
                                                        title="Remove Event"
                                                        style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer;">
                                                    Remove
                                                </button>
                                                ${hasSameDayAlternatives ? `
                                                    <button class="coe-event-action-btn" 
                                                            onclick="event.stopPropagation(); console.log('Replace button clicked', {coeId: '${coe.id || coe._id}', eventId: '${eventGroup.event_id}'}); if (typeof handleReplaceEvent === 'function') { handleReplaceEvent('${coe.id || coe._id}', '${eventGroup.event_id}'); } else { console.error('handleReplaceEvent is not defined'); alert('Replace function not available. Please refresh the page.'); }" 
                                                            title="Replace Event"
                                                            style="background: rgba(59, 130, 246, 0.2); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.4); padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer;">
                                                        Replace
                                                    </button>
                                                ` : ''}
                                            ` : '';
                                        })()}
                                        <span class="expand-icon">▼</span>
                                    </div>
                                </div>
                                <div class="coe-seat-event-content">
                                    ${locationThumbsHtml}
                                    ${seatItemsHtml}
                                    ${eventRunnerDetailsHtml}
                                </div>
                            </div>
                        `;
                    }).join('');
                    
                    // Runner details HTML (COE-level only)
                    const runnerHtml = coe.runner_assignment?.runner ? (() => {
                        const r = coe.runner_assignment.runner;
                        const initials = getInitials(r.name || r.email);
                        const avatarEl = r.avatarUrl
                            ? `<span class="coe-runner-avatar"><img src="${r.avatarUrl}" alt="${r.name || 'Runner'}" loading="lazy"></span>`
                            : `<span class="coe-runner-avatar">${initials}</span>`;
                        return `
                            <div class="coe-runner-section">
                                <div class="coe-runner-title">Runner Details</div>
                                <div class="coe-runner-details">
                                    <div class="coe-runner-row">
                                        ${avatarEl}
                                        <div class="coe-runner-name">${r.name}</div>
                                    </div>
                                    ${r.email ? `<div class="coe-runner-contact">Email: ${r.email}</div>` : ''}
                                    ${r.phone ? `<div class="coe-runner-contact">Phone: ${r.phone}</div>` : ''}
                                    ${coe.runner_assignment.status ? `<div class="coe-runner-contact">Status: ${coe.runner_assignment.status}</div>` : ''}
                                </div>
                            </div>
                        `;
                    })() : '';
                    
                    return `
                        <div class="coe-seats-section">
                            <button class="coe-seats-toggle" onclick="toggleCoeSeats(this)">
                                <span>View My Seats & Details (${seats.length})</span>
                                <span class="expand-icon">▼</span>
                            </button>
                            <div class="coe-seats-content">
                                ${eventGroupsHtml}
                                ${runnerHtml}
                            </div>
                        </div>
                    `;
                })();

                    return `
                        <div class="bot-coe-list-item">
                            <div class="coe-list-item-header">
                                <h5 class="coe-list-item-title">${coe.name || 'Untitled COE'}</h5>
                                <span class="coe-status-badge ${statusClass}">${coe.status || 'draft'}</span>
                            </div>
                            <div class="coe-list-item-details">
                                <span>${dateRange}</span>
                                <span>•</span>
                                <span>${coe.events_count || 0} events</span>
                                <span>•</span>
                                <span>${coe.seats_count || 0} seats</span>
                                <span>•</span>
                                <span>${coe.currency || 'USD'} ${(coe.total_price || 0).toLocaleString()}</span>
                            </div>
                            ${seatsHtml}
                            <div class="coe-list-item-menu-container">
                                <button class="coe-menu-button" data-coe-id="${coeId}" aria-label="COE menu">
                                    <div class="coe-menu-icon">
                                        <div class="coe-menu-icon-line"></div>
                                        <div class="coe-menu-icon-line"></div>
                                        <div class="coe-menu-icon-line"></div>
                                        <div style="display: flex; gap: 2px; margin-top: 1px;">
                                            <div class="coe-menu-icon-dot"></div>
                                            <div class="coe-menu-icon-dot"></div>
                                        </div>
                                    </div>
                                </button>
                                <div class="coe-context-menu" data-coe-id="${coeId}">
                                    <button class="coe-menu-item" data-action="chat-runner" data-coe-id="${coeId}">
                                        <span class="coe-menu-item-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                            </svg>
                                        </span>
                                        <span class="coe-menu-item-text">Chat with my runner</span>
                                    </button>
                                    <button class="coe-menu-item" data-action="chat-the1" data-coe-id="${coeId}">
                                        <span class="coe-menu-item-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                            </svg>
                                        </span>
                                        <span class="coe-menu-item-text">Chat with The1</span>
                                    </button>
                                    <button class="coe-menu-item" data-action="edit" data-coe-id="${coeId}">
                                        <span class="coe-menu-item-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </span>
                                        <span class="coe-menu-item-text">Edit</span>
                                    </button>
                                    <button class="coe-menu-item" data-action="pay" data-coe-id="${coeId}">
                                        <span class="coe-menu-item-icon">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                                <line x1="1" y1="10" x2="23" y2="10"></line>
                                            </svg>
                                        </span>
                                        <span class="coe-menu-item-text">Pay</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');

            container.innerHTML = `
                <div class="coe-list-header">
                    <h4>COEs (${coes.length})</h4>
                </div>
                <div class="coe-list-items">
                    ${coesHtml}
                </div>
            `;

            // Initialize carousel touch support for all seat carousels
            container.querySelectorAll('.coe-seat-carousel-container').forEach(carousel => {
                // Initialize current index to 0
                carousel.dataset.currentIndex = '0';
                initSeatCarouselTouch(carousel);
                // Initialize button states
                const track = carousel.querySelector('.coe-seat-carousel-track');
                const slides = carousel.querySelectorAll('.coe-seat-carousel-slide');
                const prevBtn = carousel.querySelector('.coe-seat-carousel-prev');
                const nextBtn = carousel.querySelector('.coe-seat-carousel-next');
                if (slides.length > 0) {
                    // Ensure track starts at position 0
                    track.style.transform = 'translateX(0%)';
                    if (prevBtn) prevBtn.disabled = true; // First slide
                    if (nextBtn) nextBtn.disabled = slides.length === 1;
                }
            });

            // Attach event listeners to menu buttons in list items
            container.querySelectorAll('.coe-list-item-menu-container').forEach(containerEl => {
                const menuButton = containerEl.querySelector('.coe-menu-button');
                const contextMenu = containerEl.querySelector('.coe-context-menu');
                
                if (menuButton && contextMenu) {
                    // Toggle menu on button click
                    menuButton.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const isActive = menuButton.classList.contains('active');
                        
                        // Close all other menus first
                        document.querySelectorAll('.coe-menu-button.active').forEach(btn => {
                            if (btn !== menuButton) {
                                btn.classList.remove('active');
                                btn.closest('.coe-card-menu-container, .coe-list-item-menu-container')
                                    ?.querySelector('.coe-context-menu')?.classList.remove('show');
                            }
                        });
                        
                        // Toggle current menu
                        menuButton.classList.toggle('active');
                        contextMenu.classList.toggle('show');
                    });
                    
                    // Handle menu item clicks
                    contextMenu.querySelectorAll('.coe-menu-item').forEach(item => {
                        item.addEventListener('click', (e) => {
                            e.stopPropagation();
                            const action = item.dataset.action;
                            const coeId = item.dataset.coeId;
                            
                            // Close menu
                            menuButton.classList.remove('active');
                            contextMenu.classList.remove('show');
                            
                            // Handle actions
                            if (action === 'chat-runner') {
                                console.log(`Chat with runner for COE ${coeId}`);
                                showAlert('Chat with runner functionality coming soon', 'info');
                            } else if (action === 'chat-the1') {
                                console.log(`Chat with The1 for COE ${coeId}`);
                                showAlert('Chat with The1 functionality coming soon', 'info');
                            } else if (action === 'edit') {
                                handleCOEAction('edit_coe', coeId);
                            } else if (action === 'pay') {
                                console.log(`Pay for COE ${coeId}`);
                                showAlert('Payment functionality coming soon', 'info');
                            }
                        });
                    });
                }
            });

            return container;
        }

        /**
         * Handle COE actions
         */
        function handleCOEAction(action, coeId) {
            const textarea = document.getElementById('botPromptInput');
            if (!textarea) return;

            let prompt = '';
            switch (action) {
                case 'view_coe':
                    prompt = `Show me details for COE ${coeId}`;
                    break;
                case 'edit_coe':
                    prompt = `Edit COE ${coeId}`;
                    break;
                case 'delete_coe':
                    prompt = `Delete COE ${coeId}`;
                    break;
                default:
                    console.log('Unknown action:', action, coeId);
                    return;
            }

            textarea.value = prompt;
            sendBotPrompt();
        }

        /**
         * Check if data is a structured response
         */
        function isStructuredResponse(data) {
            return data && typeof data === 'object' && data.type && 
                   ['coe_created', 'coe_updated', 'coe_details', 'coe_draft', 'coe_list', 'event_list', 'location_list', 'coe_preferences_form', 'coe_create_form', 'error', 'user_profile', 'client_list', 'seat_upgrade_offers'].includes(data.type);
        }

        function renderBotMessages(messages = []) {
            botConversation = Array.isArray(messages) ? messages : [];
            const feed = document.getElementById('botResponseFeed');
            if (!feed) return;

            feed.innerHTML = '';
            resetBotEmptyState(true);

            const displayMessages = botConversation.filter(msg => msg.role !== 'system' && msg.role !== 'tool');
            if (displayMessages.length === 0) {
                return;
            }

            resetBotEmptyState(false);

            displayMessages.forEach((message, index) => {
                const wrapper = document.createElement('div');
                wrapper.classList.add('bot-message-wrapper');
                wrapper.classList.add(message.role === 'user' ? 'user' : 'assistant');

                // No avatar in messages - removed to save space and show more content
                const messageEl = document.createElement('div');
                messageEl.classList.add('bot-message');
                messageEl.classList.add(message.role === 'user' ? 'user' : 'assistant');

                const roleEl = document.createElement('span');
                roleEl.className = 'bot-message-role';
                roleEl.textContent = message.role === 'assistant' ? 'Assistant' : 'You';

                const contentEl = document.createElement('div');
                contentEl.className = 'bot-message-content';

                // Check for structured data
                let structuredData = null;
                
                // First, check if message has structured_data directly
                if (message.structured_data) {
                    structuredData = message.structured_data;
                    console.log('[FRONTEND] Found structured_data on message:', {
                        type: structuredData.type,
                        hasSpecificReason: !!structuredData.specific_reason,
                        specificReason: structuredData.specific_reason,
                        hasEventDiagnostics: !!(structuredData.details?.event_diagnostics?.length),
                        eventDiagnosticsCount: structuredData.details?.event_diagnostics?.length || 0
                    });
                }
                
                // If not, check for structured data in tool results (from previous tool call)
                if (!structuredData && message.role === 'assistant' && index > 0) {
                    // Look for tool result with structured data
                    const prevToolMessage = botConversation.slice(0, index).reverse().find(msg => 
                        msg.role === 'tool' && msg.structured_data
                    );
                    if (prevToolMessage && prevToolMessage.structured_data) {
                        structuredData = prevToolMessage.structured_data;
                        console.log('[FRONTEND] Found structured_data on previous tool message:', {
                            type: structuredData.type,
                            hasSpecificReason: !!structuredData.specific_reason,
                            specificReason: structuredData.specific_reason
                        });
                    }
                }

                // Finally, check if message content contains structured response
                if (!structuredData) {
                    const parsed = parseJsonContent(message.content);
                    if (parsed && isStructuredResponse(parsed)) {
                        structuredData = parsed;
                        console.log('[FRONTEND] Found structured_data in message content:', {
                            type: structuredData.type,
                            hasSpecificReason: !!structuredData.specific_reason
                        });
                    }
                }
                
                if (!structuredData && message.role === 'assistant') {
                    console.log('[FRONTEND] No structured_data found for assistant message:', {
                        messageIndex: index,
                        hasStructuredData: !!message.structured_data,
                        messageContent: message.content?.substring(0, 100)
                    });
                }

                if (structuredData) {
                    // Render structured response
                    if (structuredData.type === 'coe_created' || structuredData.type === 'coe_updated' || structuredData.type === 'coe_details' || structuredData.type === 'coe_draft') {
                        const coeCard = renderCOECard(structuredData.coe, structuredData.actions || []);
                        contentEl.appendChild(coeCard);
                        
                        // Add message text if present
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, coeCard);
                        }
                    } else if (structuredData.type === 'coe_list') {
                        const coeList = renderCOEList(structuredData.coes || []);
                        contentEl.appendChild(coeList);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, coeList);
                        }
                    } else if (structuredData.type === 'event_list') {
                        const eventList = renderEventList(structuredData.events || []);
                        contentEl.appendChild(eventList);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, eventList);
                        }
                    } else if (structuredData.type === 'location_list') {
                        const locationList = renderLocationList(structuredData.locations || []);
                        contentEl.appendChild(locationList);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, locationList);
                        }
                    } else if (structuredData.type === 'coe_preferences_form') {
                        const preferencesForm = renderCOEPreferencesForm(structuredData);
                        contentEl.appendChild(preferencesForm);
                    } else if (structuredData.type === 'coe_create_form') {
                        const coeCreateForm = renderCOECreateForm(structuredData);
                        contentEl.appendChild(coeCreateForm);
                    } else if (structuredData.type === 'error') {
                        const errorCard = renderErrorResponse(structuredData);
                        contentEl.appendChild(errorCard);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, errorCard);
                        }
                    } else if (structuredData.type === 'user_profile') {
                        const profileCard = renderProfileCard(structuredData.profile);
                        contentEl.appendChild(profileCard);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, profileCard);
                        }
                    } else if (structuredData.type === 'client_list') {
                        const clientList = renderClientList(structuredData);
                        contentEl.appendChild(clientList);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, clientList);
                        }
                    } else if (structuredData.type === 'seat_upgrade_offers') {
                        const upgradeOffers = renderSeatUpgradeOffers(structuredData);
                        contentEl.appendChild(upgradeOffers);
                        
                        if (structuredData.message) {
                            const msgText = document.createElement('p');
                            msgText.className = 'bot-structured-message';
                            msgText.textContent = structuredData.message;
                            contentEl.insertBefore(msgText, upgradeOffers);
                        }
                    }
                    
                    // Note: Upgrade offers are now integrated into the COE seat carousel
                    // No need to render them as a separate card anymore
                    // The upgrade options will appear as additional slides in the seat carousel
                } else {
                    // Regular text content
                    const parsed = parseJsonContent(message.content);
                    if (parsed) {
                        const pre = document.createElement('pre');
                        pre.textContent = JSON.stringify(parsed, null, 2);
                        contentEl.appendChild(pre);
                    } else if (message.content) {
                        contentEl.textContent = message.content;
                    }
                }

                messageEl.appendChild(roleEl);
                messageEl.appendChild(contentEl);
                // No avatar - removed to save space and show more content
                wrapper.appendChild(messageEl);
                feed.appendChild(wrapper);
            });

            feed.scrollTop = feed.scrollHeight;
        }

