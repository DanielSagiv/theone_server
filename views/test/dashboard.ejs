         */
        async function openCreateCOE() {
            try {
                // Set create mode
                window.coeEditMode = false;
                window.currentEditingCOEId = null;
                
                // Load clients and runners for selection
                await populateCOEFilters();
                
                // Load events for selection
                await loadEventsForCOE();
                
                // Reset form
                resetCreateCOEForm();
                
                // Update modal title
                document.querySelector('#createCOEModal .modal-header h2').textContent = 'Create COE';
                document.getElementById('coec_create_btn').textContent = 'Create COE';
                
                // Show modal
                document.getElementById('createCOEModal').style.display = 'flex';
                
                // Start with step 1
                coecCurrentStep = 1;
                updateCOECStepDisplay();
                
                // Add real-time validation listeners
                addCOECValidationListeners();
            } catch (error) {
                console.error('Error opening create COE modal:', error);
                showAlert('Error opening create COE modal: ' + error.message, 'error');
            }
        }

        /**
         * Edit COE
         */
        async function editCOE(coeId) {
            try {
                
                // Fetch COE data first to check if it can be edited
                const result = await makeApiRequest(`/coes/${coeId}`);
                
                if (result.success && result.data) {
                    const coe = result.data.data || result.data;
                    
                    // Check if COE has past events
                    const now = new Date();
                    const hasPastEvents = coe.events && coe.events.some(event => {
                        const eventDate = new Date(event.start_datetime);
                        return eventDate < now;
                    });
                    
                    if (hasPastEvents) {
                        showAlert('Cannot edit COE with past events. Only COEs with future events can be edited.', 'error');
                        return;
                    }
                    
                    // Set edit mode
                    window.coeEditMode = true;
                    window.currentEditingCOEId = coeId;
                    
                    // Load clients and runners for selection
                    await populateCOEFilters();
                    
                    // Load events for selection
                    await loadEventsForCOE();
                    
                    // Populate form with COE data
                    populateCOEFormForEdit(coe);
                    
                    // Update modal title
                    document.querySelector('#createCOEModal .modal-header h2').textContent = 'Edit COE';
                    document.getElementById('coec_create_btn').textContent = 'Update COE';
                    
                    // Show modal
                    document.getElementById('createCOEModal').style.display = 'flex';
                    
                    // Start with step 1
                    coecCurrentStep = 1;
                    updateCOECStepDisplay();
                    
                    // Add real-time validation listeners
                    addCOECValidationListeners();
                    
                    showAlert('COE loaded for editing', 'success');
                } else {
                    showAlert('Failed to load COE for editing: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error editing COE:', error);
                showAlert('Error editing COE: ' + error.message, 'error');
            }
        }

        /**
         * Populate COE form for editing
         */
        function populateCOEFormForEdit(coe) {
            // Step 1: Basic information
            document.getElementById('coec_name').value = coe.name || '';
            document.getElementById('coec_description').value = coe.description || '';
            document.getElementById('coec_client_id').value = coe.client_id?._id || '';
            document.getElementById('coec_start_date').value = coe.start_date ? coe.start_date.split('T')[0] : '';
            document.getElementById('coec_end_date').value = coe.end_date ? coe.end_date.split('T')[0] : '';
            document.getElementById('coec_currency').value = coe.currency || 'USD';
            document.getElementById('coec_taxes_percent').value = coe.taxes_percent || '0';
            document.getElementById('coec_fees_amount').value = coe.fees_amount || '0';
            document.getElementById('coec_deposit_percent').value = coe.deposit_percent || '20';
            document.getElementById('coec_policies').value = coe.policies || '';
            document.getElementById('coec_notes').value = coe.notes || '';
            
            // Step 2: Events - populate immediately for visual display
            // Extract full event objects from populated structure
            coecSelectedEvents = (coe.events || []).map(event => event.event_id || event);
            populateCOEEventsGrid(); // Show events grid with all available events
            preSelectEventsForEdit(); // Mark selected events as selected
            updateCOESelectedEvents(); // Update selected events display
            
            // Step 3: Tables - populate immediately for visual display
            coecSelectedSeats = coe.selected_seats || [];
            populateCOESeatsContainer(); // Show seats container for all selected events
            preSelectSeatsForEdit(); // Mark selected seats as selected
            
            // Step 4: Runner
            if (coe.runner_assignment) {
                document.getElementById('coec_runner_type').value = coe.runner_assignment.type || 'coe';
                if (coe.runner_assignment.type === 'coe') {
                    document.getElementById('coec_coe_runner_id').value = coe.runner_assignment.runner_id?._id || '';
                }
                document.getElementById('coec_runner_notes').value = coe.runner_assignment.notes || '';
            } else {
                // Reset runner fields if no assignment
                document.getElementById('coec_runner_type').value = 'coe';
                document.getElementById('coec_coe_runner_id').value = '';
                document.getElementById('coec_runner_notes').value = '';
            }
            
            // Step 5: Pricing - calculate immediately
            calculateCOEPricing();
            
            // Step 6: Summary - populate immediately
            populateCOESummary();
        }

        /**
         * Add real-time validation listeners
         */
        function addCOECValidationListeners() {
            // Step 1 field listeners
            const step1Fields = ['coec_name', 'coec_description', 'coec_client_id', 'coec_start_date', 'coec_end_date'];
            step1Fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', () => {
                        if (coecCurrentStep === 1) {
                            setTimeout(() => updateCOECValidationStatus(), 100);
                        }
                    });
                    field.addEventListener('change', () => {
                        if (coecCurrentStep === 1) {
                            setTimeout(() => updateCOECValidationStatus(), 100);
                        }
                    });
                }
            });
            
            // Step 4 field listeners
            const runnerTypeField = document.getElementById('coec_runner_type');
            const runnerIdField = document.getElementById('coec_coe_runner_id');
            if (runnerTypeField) {
                runnerTypeField.addEventListener('change', () => {
                    if (coecCurrentStep === 4) {
                        setTimeout(() => updateCOECValidationStatus(), 100);
                    }
                });
            }
            if (runnerIdField) {
                runnerIdField.addEventListener('change', () => {
                    if (coecCurrentStep === 4) {
                        setTimeout(() => updateCOECValidationStatus(), 100);
                    }
                });
            }
        }

