            // Mark seats as selected in the UI
            coecSelectedSeats.forEach(selectedSeat => {
                const seatCard = document.querySelector(`[data-seat-id="${selectedSeat.seat_id}"][data-event-id="${selectedSeat.event_id}"]`);
