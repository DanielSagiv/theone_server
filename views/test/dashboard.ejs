        /**
         * Show alert message
         */
        function showAlert(message, type = 'success') {
            const alertsDiv = document.getElementById('alerts');
            const classMap = {
                success: 'alert-success',
                error: 'alert-error',
                warning: 'alert-warning',
                info: 'alert-info'
            };

            const alertClass = classMap[type] || classMap.success;
            alertsDiv.innerHTML = `<div class="alert ${alertClass}">${message}</div>`;
            alertsDiv.style.display = 'block';
            
            setTimeout(() => {
                alertsDiv.style.display = 'none';
            }, 5000);
        }

        // Helper: get initials from name or email
        function getInitials(text) {
            if (!text) return 'U';
            const s = String(text).trim();
            if (!s) return 'U';
            const parts = s.includes('@') ? s.replace(/@.*/, '').split(/[.\s_-]+/) : s.split(/\s+/);
            const letters = parts.filter(Boolean).slice(0, 2).map(p => p[0].toUpperCase());
            return letters.join('') || 'U';
        }

