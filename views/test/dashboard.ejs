                                <h3 style="color: #2c3e50; margin-bottom: 10px;">Pricing Breakdown</h3>
                                <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
                                    ${coe.pricing_breakdown.events.map(event => `
                                        <div style="margin-bottom: 20px; border: 1px solid #dee2e6; border-radius: 8px; padding: 15px;">
                                            <h4 style="margin: 0 0 15px 0; color: #495057;">${event.event_name}</h4>
