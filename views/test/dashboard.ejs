        .sentiment-badge.type-a {
            background: rgba(34, 197, 94, 0.1);
            border-color: rgba(34, 197, 94, 0.3);
            color: #4ade80;
        }
        
        .btn-upgrade {
            width: 100%;
            padding: 10px 16px;
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
