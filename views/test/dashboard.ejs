        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            
            .content-area {
                padding: 20px;
            }
            
            .top-banner {
                padding: 15px 20px;
            }

            .modal-content {
                width: 95%;
                margin: 10px;
            }
        }

