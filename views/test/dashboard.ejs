        // ===== Create Location Multi-step Logic =====
        let clStep = 1;
        function setClStep(step) {
            console.log('Setting step to:', step);
            clStep = step;
            document.getElementById('cl_step1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById('cl_step2').style.display = step === 2 ? 'block' : 'none';
            document.getElementById('cl_step3').style.display = step === 3 ? 'block' : 'none';
            document.getElementById('cl_step4').style.display = step === 4 ? 'block' : 'none';
            document.getElementById('cl_next_btn').style.display = step < 4 ? 'inline-block' : 'none';
            document.getElementById('cl_create_btn').style.display = step === 4 ? 'inline-block' : 'none';
            
            // Update button text based on edit mode
            const createBtn = document.getElementById('cl_create_btn');
            if (createBtn && step === 4) {
                createBtn.textContent = cl_isEditMode ? 'Update Location' : 'Create Location';
            }
            
            console.log('Create button display:', document.getElementById('cl_create_btn').style.display);
            // badges
            document.getElementById('cl_step1_badge').style.opacity = step >= 1 ? '1' : '.6';
            document.getElementById('cl_step2_badge').style.opacity = step >= 2 ? '1' : '.6';
            document.getElementById('cl_step3_badge').style.opacity = step >= 3 ? '1' : '.6';
            document.getElementById('cl_step4_badge').style.opacity = step >= 4 ? '1' : '.6';
        }

        function nextClStep() {
            console.log('nextClStep called, current step:', clStep);
            
            // Clear previous validation indicators
            clearClValidationIndicators();
            
            if (clStep === 1) {
                // basic validation
                const name = document.getElementById('cl_name').value.trim();
                if (!name) { 
                    addClFieldValidation('cl_name', 'Location name is required');
                    return; 
                }
                console.log('Moving from step 1 to step 2');
                setClStep(2);
                onClTypeChange();
            } else if (clStep === 2) {
                console.log('Moving from step 2 to step 3');
                setClStep(3);
            } else if (clStep === 3) {
                console.log('Moving from step 3 to step 4');
                // build review
                const payload = buildCreateLocationPayload();
                document.getElementById('cl_review').textContent = JSON.stringify(payload, null, 2);
                setClStep(4);
            }
        }

        /**
