        /**
         * Show specific step in edit modal
         */
        function el_showStep(step) {
            // Hide all steps
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`el_step${i}`).style.display = 'none';
            }
            
            // Show current step
            document.getElementById(`el_step${step}`).style.display = 'block';
            
            // Update buttons
            document.getElementById('el_backBtn').style.display = step > 1 ? 'inline-block' : 'none';
            document.getElementById('el_nextBtn').style.display = step < 4 ? 'inline-block' : 'none';
            document.getElementById('el_saveBtn').style.display = step === 4 ? 'inline-block' : 'none';
        }

        /**
         * Next step in edit modal
         */
        function el_nextStep() {
            if (el_currentStep < 4) {
                el_currentStep++;
                el_showStep(el_currentStep);
                
                // Update review on step 4
                if (el_currentStep === 4) {
                    el_updateReview();
                }
            }
        }

        /**
         * Previous step in edit modal
         */
        function el_previousStep() {
            if (el_currentStep > 1) {
                el_currentStep--;
                el_showStep(el_currentStep);
            }
        }

        /**
         * Update review section
         */
        function el_updateReview() {
            const payload = el_buildUpdatePayload();
            document.getElementById('el_review').textContent = JSON.stringify(payload, null, 2);
        }

        /**
         * Build update payload from form
         */
        function el_buildUpdatePayload() {
            const payload = {
                name: document.getElementById('el_name').value.trim(),
                type: document.getElementById('el_type').value,
                description: document.getElementById('el_description').value.trim(),
                score: parseFloat(document.getElementById('el_score').value) || 0,
                status: document.getElementById('el_status').value
            };
            
            // Address
            const address_line1 = document.getElementById('el_address_line1').value.trim();
            const address_line2 = document.getElementById('el_address_line2').value.trim();
            const city = document.getElementById('el_city').value.trim();
            const state = document.getElementById('el_state').value.trim();
            const postalCode = document.getElementById('el_postalCode').value.trim();
            const country = document.getElementById('el_country').value.trim();
            
            if (address_line1 || address_line2 || city || state || postalCode || country) {
                payload.address = {};
                if (address_line1) payload.address.line1 = address_line1;
                if (address_line2) payload.address.line2 = address_line2;
                if (city) payload.address.city = city;
                if (state) payload.address.state = state;
                if (postalCode) payload.address.postalCode = postalCode;
                if (country) payload.address.country = country;
            }
            
            // Attributes - handle all dynamic attributes
            const attributes = {};
            const locationType = document.getElementById('el_type').value;
            
            // Common attributes
            const capacity = document.getElementById('el_attr_capacity')?.value;
            const priceLevel = document.getElementById('el_attr_priceLevel')?.value;
            if (capacity) attributes.capacity = parseInt(capacity);
            if (priceLevel) attributes.priceLevel = parseInt(priceLevel);
            
            // Restaurant-specific attributes
            if (locationType === 'restaurant') {
                const cuisine = document.getElementById('el_attr_cuisine')?.value?.trim();
                if (cuisine) {
                    attributes.cuisine = cuisine.split(',').map(c => c.trim()).filter(c => c.length > 0);
                }
                const michelinStars = document.getElementById('el_attr_michelinStars')?.value;
                if (michelinStars) attributes.michelinStars = parseInt(michelinStars);
                const privateDiningRooms = document.getElementById('el_attr_privateDiningRooms')?.value;
                if (privateDiningRooms) attributes.privateDiningRooms = parseInt(privateDiningRooms);
            }
            
            // Club-specific attributes
            if (locationType === 'night_club' || locationType === 'day_club') {
                const bottleService = document.getElementById('el_attr_bottleService')?.value;
                if (bottleService === 'true' || bottleService === 'false') {
                    attributes.bottleService = bottleService === 'true';
                }
                const dressCode = document.getElementById('el_attr_dressCode')?.value?.trim();
                if (dressCode) attributes.dressCode = dressCode;
            }
            
            // Hotel-specific attributes
            if (locationType === 'hotel') {
                const stars = document.getElementById('el_attr_stars')?.value;
                if (stars) attributes.stars = parseInt(stars);
                const brand = document.getElementById('el_attr_brand')?.value?.trim();
                if (brand) attributes.brand = brand;
                const checkInTime = document.getElementById('el_attr_checkInTime')?.value?.trim();
                if (checkInTime) attributes.checkInTime = checkInTime;
                const checkOutTime = document.getElementById('el_attr_checkOutTime')?.value?.trim();
                if (checkOutTime) attributes.checkOutTime = checkOutTime;
            }
            
            if (Object.keys(attributes).length > 0) {
                payload.attributes = attributes;
            }
            
            // Preserve existing arrays (seats, media, units) from original location data
            // This ensures they are not lost when updating other fields
            if (currentEditLocation) {
                if (currentEditLocation.seats && Array.isArray(currentEditLocation.seats)) {
                    payload.seats = currentEditLocation.seats;
                }
                if (currentEditLocation.media && Array.isArray(currentEditLocation.media)) {
                    payload.media = currentEditLocation.media;
                }
                if (currentEditLocation.units && Array.isArray(currentEditLocation.units)) {
                    payload.units = currentEditLocation.units;
                }
            }
            
            return payload;
        }

        /**
         * Update location
         */
        async function updateLocation() {
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can update locations', 'error');
                return;
            }

            try {
                const payload = el_buildUpdatePayload();
                
                // Validate required fields
                if (!payload.name) {
                    showAlert('Name is required', 'error');
                    return;
                }
                if (!payload.type) {
                    showAlert('Type is required', 'error');
                    return;
                }

                const result = await makeApiRequest(`/locations/${currentLocationId}`, 'PUT', payload);
                
                if (result.success) {
                    showAlert('Location updated successfully!', 'success');
                    closeEditLocationModal();
                    // Refresh location details
                    viewLocationDetails(currentLocationId);
                } else {
                    showAlert('Failed to update location: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error updating location:', error);
                showAlert('Error updating location: ' + error.message, 'error');
            }
        }

