            document.getElementById('statusModal').style.display = 'none';
            selectedUserId = null;
            selectedUserName = null;
            selectedStatus = null;
        }

        /**
         * Update user status
         */
        async function updateUserStatus() {
            if (!selectedUserId || !selectedStatus) {
                showAlert('Please select a status', 'error');
                return;
            }

            try {
                const result = await makeApiRequest(`/users/${selectedUserId}/status`, 'PUT', {
                    entity_status: selectedStatus
                });

                if (result.success) {
                    showAlert('User status updated successfully!', 'success');
                    closeStatusModal();
                    loadUsers(); // Refresh the users table
                } else {
                    showAlert('Failed to update status: ' + (result.data?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error updating status:', error);
                showAlert('Error updating status: ' + error.message, 'error');
            }
        }

