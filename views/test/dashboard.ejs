        .btn-keep-current {
            width: 100%;
            padding: 10px 16px;
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 6px;
            color: #cbd5f5;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .btn-keep-current:hover {
            background: rgba(30, 41, 59, 0.8);
            border-color: rgba(148, 163, 184, 0.4);
        }
        
        .bot-upgrade-empty {
            text-align: center;
            padding: 32px;
            color: #94a3b8;
            font-size: 0.9rem;
        }
        
        @media (max-width: 768px) {
            .upgrade-offer-comparison {
                flex-direction: column;
            }
            
            .upgrade-arrow {
                transform: rotate(90deg);
            }
            
            .current-seat,
            .upgrade-seat {
                min-width: 100%;
            }
        }

        /* COE List Styles */
        .bot-coe-list {
            max-width: 100%;
        }

