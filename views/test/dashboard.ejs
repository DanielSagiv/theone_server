        async function submitCreateLocation(event) {
            event?.preventDefault?.();
            const name = document.getElementById('cl_name').value.trim();
            const type = document.getElementById('cl_type').value;
            const address_line1 = document.getElementById('cl_address_line1').value.trim();
            const address_line2 = document.getElementById('cl_address_line2').value.trim();
            const city = document.getElementById('cl_city').value.trim();
            const state = document.getElementById('cl_state').value.trim();
            const postalCode = document.getElementById('cl_postalCode').value.trim();
            const country = document.getElementById('cl_country').value.trim();
            if (!name) { showAlert('Name is required', 'error'); return; }
            try {
                // Build address object with only non-empty fields
                const address = {};
                if (address_line1) address.line1 = address_line1;
                if (address_line2) address.line2 = address_line2;
                if (city) address.city = city;
                if (state) address.state = state;
                if (postalCode) address.postalCode = postalCode;
                if (country) address.country = country;
                
                const payload = { name, type };
                if (Object.keys(address).length > 0) payload.address = address;
                const parsePercentField = (elId) => {
                    const raw = document.getElementById(elId)?.value?.trim?.() ?? '';
                    if (raw === '') return undefined;
                    const n = parseFloat(raw);
                    if (!Number.isFinite(n) || n < 0 || n > 100) return undefined;
                    return n;
                };
                const g = parsePercentField('cl_gratuityPercent');
                const a = parsePercentField('cl_adminFeePercent');
                const s = parsePercentField('cl_salesTaxPercent');
                if (g !== undefined) payload.gratuityPercent = g;
                if (a !== undefined) payload.adminFeePercent = a;
                if (s !== undefined) payload.salesTaxPercent = s;
                const result = await makeApiRequest('/locations', 'POST', payload);
                if (result.success) {
                    closeCreateLocation();
                    showAlert('Location created', 'success');
                    loadLocations();
                } else {
                    showAlert(result.data?.error?.message || 'Failed to create location', 'error');
                }
            } catch (err) {
                console.error('Create location error:', err);
                showAlert('Error creating location: ' + err.message, 'error');
            }
        }

