        // Set up document-level event delegation for seat sentiment buttons (runs once on page load)
        (function setupSeatSentimentListener() {
            if (window.seatSentimentListenerAttached) {
                console.log('Seat sentiment listener already attached');
                return;
            }
            
            console.log('Setting up document-level seat sentiment listener...');
            document.addEventListener('click', function(e) {
                // Check if clicked element or its parent is the button
                const btn = e.target.closest('.add-seat-sentiment-btn');
                if (btn) {
                    console.log('=== SEAT SENTIMENT BUTTON CLICKED (DELEGATION) ===');
                    console.log('Event target:', e.target);
                    console.log('Button found:', btn);
                    console.log('Button onclick handler:', btn.onclick);
                    console.log('Button has onclick attribute:', btn.hasAttribute('onclick'));
                    
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    
                    // Prioritize seat ID over code for unique identification
                    const seatId = btn.getAttribute('data-seat-id');
                    const seatCode = btn.getAttribute('data-seat-code');
                    const context = btn.getAttribute('data-seat-context');
                    console.log('Seat ID from data-seat-id attribute:', seatId);
                    console.log('Seat code from data-seat-code attribute:', seatCode);
                    console.log('Context from data-seat-context attribute:', context);
                    console.log('All button attributes:', Array.from(btn.attributes).map(a => `${a.name}="${a.value}"`).join(', '));
                    console.log('Button outerHTML:', btn.outerHTML.substring(0, 200));
                    
                    // Use seat ID if available, otherwise fallback to code
                    const seatIdentifier = (seatId && seatId.trim() !== '') ? seatId.trim() : (seatCode && seatCode.trim() !== '' ? seatCode.trim() : null);
                    
                    if (!seatIdentifier) {
                        console.error('❌ Seat ID and code are both empty or missing!', { seatId, seatCode, btn });
                        showAlert('Seat identifier not found in button. Please refresh the page.', 'error');
                        return false;
                    }
                    
                    console.log('✅ Calling openAddSentimentModal with:', { context, seatIdentifier, isId: !!seatId });
                    openAddSentimentModal(context, seatIdentifier, !!seatId);
                    return false;
                }
            }, true); // Use capture phase to catch early
            window.seatSentimentListenerAttached = true;
            console.log('✅ Document-level seat sentiment listener attached successfully');
        })();

