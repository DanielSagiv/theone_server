        /**
         * Store uploaded event media URLs
         */
        let ce_uploadedMedia = [];

        /**
         * Preview event media files
         */
        function previewEventMedia() {
            const fileInput = document.getElementById('ce_media_files');
            const preview = document.getElementById('ce_media_preview');
            const files = fileInput.files;
            
            preview.innerHTML = '';
            
            if (files.length === 0) {
                return;
            }
            
            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const isVideo = file.type.startsWith('video/');
                    const previewItem = document.createElement('div');
                    previewItem.style.cssText = 'position:relative;border:1px solid #ecf0f1;border-radius:8px;overflow:hidden;';
                    
                    if (isVideo) {
                        previewItem.innerHTML = `
                            <video src="${e.target.result}" style="width:100%;height:120px;object-fit:cover;"></video>
                            <div style="position:absolute;bottom:5px;left:5px;background:rgba(0,0,0,0.7);color:white;padding:2px 6px;font-size:10px;border-radius:3px;">VIDEO</div>
                        `;
                    } else {
                        previewItem.innerHTML = `<img src="${e.target.result}" style="width:100%;height:120px;object-fit:cover;" />`;
                    }
                    
                    preview.appendChild(previewItem);
                };
                reader.readAsDataURL(file);
            });
        }

        /**
         * Upload event media files to S3
         */
        async function uploadEventMediaFiles() {
            const fileInput = document.getElementById('ce_media_files');
            const files = fileInput.files;
            
            console.log('Upload event media files - files selected:', files.length);
            
            if (!files || files.length === 0) {
                console.log('No files selected for upload');
                return [];
            }
            
            const uploadedUrls = [];
            
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                console.log(`Uploading file ${i + 1}/${files.length}:`, file.name, file.type, file.size);
                
                const formData = new FormData();
                formData.append('asset', file);
                
                try {
                    console.log('Making upload request to /v1/events/media/upload');
                    
                    // Use direct fetch for FormData (makeApiRequest doesn't handle FormData properly)
                    const response = await fetch(`/v1/events/media/upload`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${currentToken}`
                        },
                        body: formData
                    });
                    
                    console.log('Upload response status:', response.status);
                    const result = await response.json();
                    console.log('Upload response result:', result);
                    
                    if (result.success && result.data) {
                        console.log('File uploaded successfully:', result.data);
                        uploadedUrls.push({
                            type: result.data.type,
                            url: result.data.url,
                            order: i
                        });
                    } else {
                        console.error('Failed to upload file:', file.name, result.error);
                        showAlert(`Failed to upload ${file.name}: ${result.error?.message || 'Unknown error'}`, 'error');
                    }
                } catch (error) {
                    console.error('Error uploading file:', file.name, error);
                    showAlert(`Error uploading ${file.name}: ${error.message}`, 'error');
                }
            }
            
            console.log('All files uploaded. URLs:', uploadedUrls);
            return uploadedUrls;
        }

        /**
         * Submit create event
         */
        async function submitCreateEvent() {
            try {
                // Upload media files first
                showAlert('Uploading event media...', 'info');
                ce_uploadedMedia = await uploadEventMediaFiles();
                console.log('Uploaded media:', ce_uploadedMedia);
                console.log('Number of media files uploaded:', ce_uploadedMedia.length);
                
                const eventData = {
                    name: document.getElementById('ce_name').value.trim(),
                    description: document.getElementById('ce_description').value.trim(),
                    type: document.getElementById('ce_type').value,
                    location_id: document.getElementById('ce_location_id').value,
                    start_datetime: new Date(document.getElementById('ce_start_datetime').value).toISOString(),
                    base_price: parseFloat(document.getElementById('ce_base_price').value),
                    currency: document.getElementById('ce_currency').value,
                    price_tier: parseInt(document.getElementById('ce_price_tier').value),
                    policies: document.getElementById('ce_policies').value.trim(),
