                    allRunners = users.filter(user => user.role === 'runner');
                    
                    // Populate client filter for COE list
                    const clientFilter = document.getElementById('coeClientFilter');
                    if (clientFilter) {
                        clientFilter.innerHTML = '<option value="">All Clients</option>' +
                            allClients.map(client => `<option value="${client._id}">${client.firstName} ${client.lastName}</option>`).join('');
                    }
                    
                    // Populate runner filter for COE list
                    const runnerFilter = document.getElementById('coeRunnerFilter');
                    if (runnerFilter) {
                        runnerFilter.innerHTML = '<option value="">All Runners</option>' +
                            allRunners.map(runner => `<option value="${runner._id}">${runner.firstName} ${runner.lastName}</option>`).join('');
                    }

                    // Populate client dropdown for COE creation modal
                    const coeClientSelect = document.getElementById('coec_client_id');
                    if (coeClientSelect) {
                        coeClientSelect.innerHTML = '<option value="">Select Client</option>' +
                            allClients.map(client => `<option value="${client._id}">${client.firstName} ${client.lastName}</option>`).join('');
                    }
                }
            } catch (error) {
                console.error('Error loading users for COE filters:', error);
            }
        }

        /**
         * Filter COEs based on selected filters
         */
        function filterCOEs() {
            const statusFilter = document.getElementById('coeStatusFilter').value;
            const clientFilter = document.getElementById('coeClientFilter').value;
            const runnerFilter = document.getElementById('coeRunnerFilter').value;
            const searchInput = document.getElementById('coeSearchInput').value.toLowerCase();

            let filteredCOEs = allCOEs.filter(coe => {
                const matchesStatus = !statusFilter || coe.status === statusFilter;
                const matchesClient = !clientFilter || coe.client_id?._id === clientFilter;
                const matchesRunner = !runnerFilter || coe.runner_assignment?.runner_id?._id === runnerFilter;
                const matchesSearch = !searchInput || 
                    coe.name.toLowerCase().includes(searchInput) ||
                    coe.description?.toLowerCase().includes(searchInput) ||
                    coe.client_id?.firstName?.toLowerCase().includes(searchInput) ||
                    coe.client_id?.lastName?.toLowerCase().includes(searchInput);

                return matchesStatus && matchesClient && matchesRunner && matchesSearch;
            });

            displayCOEsTable(filteredCOEs);
        }

        /**
         * Search COEs
         */
        function searchCOEs() {
            filterCOEs();
        }

        /**
         * Refresh COEs
         */
        function refreshCOEs() {
            loadCOEs();
        }

        /**
         * View COE details
         */
        async function viewCOE(coeId) {
            try {
                showAlert('Loading COE details...', 'info');
                
                // Use user-specific endpoint for non-admin users, admin endpoint for admins
                const endpoint = currentUser?.role === 'admin' ? `/coes/${coeId}` : `/coes/my/${coeId}`;
                const result = await makeApiRequest(endpoint);
                
                if (result.success && result.data) {
                    // The COE data is nested in result.data.data
                    const coe = result.data.data;
                    displayCOEViewModal(coe);
                } else {
                    showAlert('Failed to load COE details: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Error viewing COE:', error);
                showAlert('Error viewing COE: ' + error.message, 'error');
            }
        }

