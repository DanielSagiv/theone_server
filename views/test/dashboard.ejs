                                const offerEventId = normalizeEventId(offer.event_id);
                                const normalizedEventId = normalizeEventId(eventId);
                                const matches = offerEventId === normalizedEventId;
                                if (!matches) {
                                    console.log('[UPGRADE_DEBUG] Offer filtered out:', {
                                        offer_event_id: offer.event_id,
                                        offer_event_id_type: typeof offer.event_id,
                                        offer_event_id_isObject: typeof offer.event_id === 'object',
                                        offer_event_id_normalized: offerEventId,
                                        eventId: eventId,
                                        eventId_normalized: normalizedEventId,
                                        will_match: false,
                                        comparison: `${offerEventId} === ${normalizedEventId}`
                                    });
                                } else {
                                    console.log('[UPGRADE_DEBUG] Offer matched:', {
                                        offer_event_id: offer.event_id,
                                        offer_event_id_normalized: offerEventId,
                                        eventId: eventId,
                                        eventId_normalized: normalizedEventId,
                                        current_seat_code: offer.current_seat_code,
                                        alternatives_count: offer.alternatives?.length || 0
                                    });
                                }
                                return matches;
                            });
                            
                            console.log('[UPGRADE_DEBUG] Filtered upgrade offers:', {
                                filteredCount: upgradeOffers.length,
                                offers: upgradeOffers.map(o => ({
                                    event_id: o.event_id,
                                    current_seat_code: o.current_seat_code,
                                    alternatives_count: o.alternatives?.length || 0
                                }))
                            });
                            
                            // Build upgrade option slides
                            let upgradeSlides = [];
                            // Check if user is admin - admins see all seats, clients only see upgrades
                            const isAdmin = currentUser && currentUser.role === 'admin';
                            
                            console.log('[UPGRADE_DEBUG] Building upgrade slides:', {
                                upgradeOffersCount: upgradeOffers.length,
                                isAdmin: isAdmin,
                                eventId: eventId,
                                allUpgradeOffersCount: coeData.seat_upgrade_offers?.length || 0
                            });
                            
                            if (upgradeOffers.length > 0) {
                                upgradeOffers.forEach(offer => {
                                    const currentPrice = Number(offer.current_price) || 0;
                                    console.log('[UPGRADE_DEBUG] Processing offer:', {
                                        current_seat_code: offer.current_seat_code,
                                        current_price: currentPrice,
                                        alternatives_before_filter: (offer.alternatives || []).length,
                                        alternatives: (offer.alternatives || []).map(alt => ({
                                            seat_code: alt.seat_code,
                                            event_price: alt.event_price,
                                            price: alt.price,
                                            altPrice: Number(alt.event_price || alt.price || 0),
                                            isMoreExpensive: Number(alt.event_price || alt.price || 0) > currentPrice
                                        }))
                                    });
                                    
                                    const upgradeAlternatives = (offer.alternatives || []).filter(alt => {
                                        const altPrice = Number(alt.event_price || alt.price || 0);
                                        
                                        // For admins: show all alternatives (no price filter)
                                        // For clients: only show more expensive options
                                        if (isAdmin) {
                                            console.log('[UPGRADE_DEBUG] Admin - showing all alternatives:', {
                                                seat_code: alt.seat_code,
                                                altPrice: altPrice,
                                                currentPrice: currentPrice
                                            });
                                            return true; // Admin sees all seats
                                        } else {
                                            const isMoreExpensive = altPrice > currentPrice;
                                            if (!isMoreExpensive) {
                                                console.log('[UPGRADE_DEBUG] Alternative filtered out (not more expensive):', {
                                                    seat_code: alt.seat_code,
                                                    altPrice: altPrice,
                                                    currentPrice: currentPrice
                                                });
                                            }
                                            return isMoreExpensive; // Client only sees more expensive options
                                        }
                                    });
                                    
                                    console.log('[UPGRADE_DEBUG] Alternatives after filter:', {
                                        count: upgradeAlternatives.length,
                                        isAdmin: isAdmin,
                                        alternatives: upgradeAlternatives.map(alt => ({
                                            seat_code: alt.seat_code,
                                            event_price: alt.event_price,
                                            price: alt.price
                                        }))
                                    });
                                    
                                    // For admins: show offer even if no alternatives (might have current seat or all seats are cheaper)
                                    // For clients: skip if no upgrades available
                                    if (!isAdmin && upgradeAlternatives.length === 0) {
                                        console.log('[UPGRADE_DEBUG] Skipping offer - no upgrades for client');
                                        return; // Skip this offer for clients
                                    }
                                    
                                    // For admins: log if no alternatives (shouldn't happen if backend is working correctly)
                                    if (isAdmin && upgradeAlternatives.length === 0) {
                                        console.warn('[UPGRADE_DEBUG] Admin offer has no alternatives - this might indicate a backend issue:', {
                                            offer: offer,
                                            alternatives_before_filter: (offer.alternatives || []).length,
                                            current_seat_code: offer.current_seat_code
                                        });
                                    }
                                    
                                    upgradeAlternatives.forEach((alt, altIndex) => {
                                        // Upgrade alternative media thumbnails (same logic as selected seats)
                                        const altMedia = alt.media || [];
                                        const altImageMedia = altMedia.filter(m => m && m.type === 'image');
                                        
                                        // Debug logging for upgrade alternative media
                                        console.log('[UPGRADE_DEBUG] Alternative media check:', {
                                            seat_code: alt.seat_code,
                                            hasMedia: !!(alt.media),
                                            mediaType: typeof alt.media,
                                            isArray: Array.isArray(alt.media),
                                            mediaLength: alt.media?.length || 0,
                                            imageMediaLength: altImageMedia.length,
                                            media: alt.media
                                        });
                                        
                                        const altMediaHtml = altImageMedia.length > 0 ? `
                                            <div class="coe-seat-media">
                                                ${altImageMedia.slice(0, 4).map(media => `
                                                    <img src="${media.url}" 
                                                         alt="${media.caption || alt.seat_code || 'Upgrade seat image'}" 
                                                         class="coe-seat-media-thumbnail"
                                                         onclick="openLightbox(${JSON.stringify(media).replace(/"/g, '&quot;')})"
                                                         loading="lazy">
                                                `).join('')}
