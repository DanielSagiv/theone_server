        /**
         * Update COE creation step display
         */
        function updateCOECStepDisplay() {
            // Hide all steps
            for (let i = 1; i <= 6; i++) {
                document.getElementById(`coec_step${i}`).style.display = 'none';
                document.getElementById(`coec_step${i}_badge`).style.opacity = '0.6';
            }
            
            // Show current step
            document.getElementById(`coec_step${coecCurrentStep}`).style.display = 'block';
            document.getElementById(`coec_step${coecCurrentStep}_badge`).style.opacity = '1';
            
            // Update navigation buttons
            const prevBtn = document.getElementById('coec_prev_btn');
            const nextBtn = document.getElementById('coec_next_btn');
            const createBtn = document.getElementById('coec_create_btn');
            
            prevBtn.style.display = coecCurrentStep > 1 ? 'block' : 'none';
            nextBtn.style.display = coecCurrentStep < 6 ? 'block' : 'none';
            createBtn.style.display = coecCurrentStep === 6 ? 'block' : 'none';
            
            // Update validation status
            updateCOECValidationStatus();
        }

        /**
         * Update validation status and visual indicators
         */
        function updateCOECValidationStatus() {
            // Clear all validation indicators
            clearCOECValidationIndicators();
            
            // Add validation indicators based on current step
            switch (coecCurrentStep) {
                case 1:
                    validateCOECStep1Fields();
                    break;
                case 2:
                    validateCOECStep2Fields();
                    break;
                case 3:
                    validateCOECStep3Fields();
                    break;
                case 4:
                    validateCOECStep4Fields();
                    break;
            }
        }

        /**
         * Clear all validation indicators
         */
        function clearCOECValidationIndicators() {
            // Clear field validation styles
            const fields = ['coec_name', 'coec_description', 'coec_client_id', 'coec_start_date', 'coec_end_date'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.style.borderColor = '';
                    field.style.backgroundColor = '';
                }
            });
            
            // Clear validation messages
            const validationMsgs = document.querySelectorAll('.coec-validation-msg');
            validationMsgs.forEach(msg => msg.remove());
        }

        /**
         * Validate Step 1 fields and show indicators
         */
        function validateCOECStep1Fields() {
            const name = document.getElementById('coec_name').value.trim();
            const description = document.getElementById('coec_description').value.trim();
            const clientId = document.getElementById('coec_client_id').value;
            const startDate = document.getElementById('coec_start_date').value;
            const endDate = document.getElementById('coec_end_date').value;
            
            if (!name) addFieldValidation('coec_name', 'Name is required');
            if (!description) addFieldValidation('coec_description', 'Description is required');
            if (!clientId) addFieldValidation('coec_client_id', 'Client selection is required');
            if (!startDate) addFieldValidation('coec_start_date', 'Start date is required');
            if (!endDate) addFieldValidation('coec_end_date', 'End date is required');
            
            if (startDate && endDate && new Date(startDate) >= new Date(endDate)) {
                addFieldValidation('coec_end_date', 'End date must be after start date');
            }
        }

        /**
         * Validate Step 2 fields and show indicators
         */
        function validateCOECStep2Fields() {
            if (coecSelectedEvents.length === 0) {
                // Check if there are any events available in the date range
                if (!allEventsForCOE || allEventsForCOE.length === 0) {
                    // No events in date range - show date adjustment message
                    const coeStartDate = document.getElementById('coec_start_date').value;
                    const coeEndDate = document.getElementById('coec_end_date').value;
                    
                    if (coeStartDate && coeEndDate) {
                        const startDate = new Date(coeStartDate).toLocaleDateString();
                        const endDate = new Date(coeEndDate).toLocaleDateString();
                        addSectionValidation('coec_step2', `No events available between ${startDate} and ${endDate}. Please go back to Step 1 and adjust your COE date range to include available events.`);
                    } else {
                        addSectionValidation('coec_step2', 'No events available. Please go back to Step 1 and adjust your COE date range.');
                    }
                } else {
                    // Events are available but none selected - show selection message
                    addSectionValidation('coec_step2', 'Please select at least one event to continue');
                }
            }
        }

        /**
         * Validate Step 3 fields and show indicators
         */
        function validateCOECStep3Fields() {
            if (coecSelectedSeats.length === 0) {
                addSectionValidation('coec_step3', 'Please select at least one table for the events');
                return;
            }
            
            // Check if each selected event has at least one table selected
            const eventsWithoutTables = coecSelectedEvents.filter(event => 
                !coecSelectedSeats.some(seat => seat.event_id === event._id)
            );
            
            if (eventsWithoutTables.length > 0) {
                const eventNames = eventsWithoutTables.map(e => e.name).join(', ');
                addSectionValidation('coec_step3', `Please select tables for: ${eventNames}`);
            }
        }

        /**
         * Validate Step 4 fields and show indicators
         */
        function validateCOECStep4Fields() {
            const runnerType = document.getElementById('coec_runner_type').value;
            if (runnerType === 'coe') {
                const coeRunnerId = document.getElementById('coec_coe_runner_id').value;
                if (!coeRunnerId) {
                    addFieldValidation('coec_coe_runner_id', 'Please select a runner for the COE');
                }
            }
        }

        /**
         * Add field validation indicator
         */
        function addFieldValidation(fieldId, message) {
            const field = document.getElementById(fieldId);
            if (field) {
                field.style.borderColor = '#e74c3c';
                field.style.backgroundColor = '#fdf2f2';
                
                // Add validation message
                const existingMsg = field.parentNode.querySelector('.coec-validation-msg');
                if (!existingMsg) {
                    const msgDiv = document.createElement('div');
                    msgDiv.className = 'coec-validation-msg';
                    msgDiv.style.color = '#e74c3c';
                    msgDiv.style.fontSize = '12px';
                    msgDiv.style.marginTop = '4px';
                    msgDiv.textContent = message;
                    field.parentNode.appendChild(msgDiv);
                }
            }
        }

        /**
         * Add section validation indicator
         */
        function addSectionValidation(sectionId, message) {
            const section = document.getElementById(sectionId);
            if (section) {
                const existingMsg = section.querySelector('.coec-validation-msg');
                if (!existingMsg) {
                    const msgDiv = document.createElement('div');
                    msgDiv.className = 'coec-validation-msg';
                    msgDiv.style.color = '#e74c3c';
                    msgDiv.style.fontSize = '14px';
                    msgDiv.style.fontWeight = 'bold';
                    msgDiv.style.textAlign = 'center';
                    msgDiv.style.padding = '10px';
                    msgDiv.style.backgroundColor = '#fdf2f2';
                    msgDiv.style.border = '1px solid #e74c3c';
                    msgDiv.style.borderRadius = '4px';
                    msgDiv.style.margin = '10px 0';
                    msgDiv.textContent = message;
                    section.insertBefore(msgDiv, section.firstChild);
                }
            }
        }

        /**
         * Handle next step button click (wrapper for async function)
         */
        function handleNextStep() {
            console.log('handleNextStep called');
            coecNextStep().catch(error => {
                console.error('Error in handleNextStep:', error);
                showAlert('Error moving to next step: ' + error.message, 'error');
            });
        }

        /**
         * Go to next step in COE creation
         */
        async function coecNextStep() {
            try {
                
                if (validateCOECCurrentStep()) {
                    coecCurrentStep++;
                    
                    // Load data for specific steps BEFORE updating display
                    if (coecCurrentStep === 2) {
                        // Reload events with date filtering when moving to Step 2
                        await loadEventsForCOE();
                        populateCOEEventsGrid();
                    } else if (coecCurrentStep === 3) {
                        populateCOESeatsContainer();
                    } else if (coecCurrentStep === 4) {
                        populateCOERunnerAssignment();
                    } else if (coecCurrentStep === 5) {
                        calculateCOEPricing();
                    } else if (coecCurrentStep === 6) {
                        populateCOESummary();
                    }
                    
                    // Handle pre-selection in edit mode
                    if (window.coeEditMode && window.currentEditingCOEId) {
                        if (coecCurrentStep === 2) {
                            // Pre-select events in edit mode
                            preSelectEventsForEdit();
                        } else if (coecCurrentStep === 3) {
                            // Pre-select seats in edit mode
                            preSelectSeatsForEdit();
                        }
                    }
                    
                    // Update display after loading data
                    updateCOECStepDisplay();
                }
            } catch (error) {
                console.error('Error in coecNextStep:', error);
                showAlert('Error moving to next step: ' + error.message, 'error');
            }
        }

        /**
         * Go to previous step in COE creation
         */
        function coecPreviousStep() {
            if (coecCurrentStep > 1) {
                coecCurrentStep--;
                updateCOECStepDisplay();
            }
        }

        /**
         * Validate current step in COE creation
         */
        function validateCOECCurrentStep() {
            
            switch (coecCurrentStep) {
                case 1:
                    const name = document.getElementById('coec_name').value.trim();
                    const description = document.getElementById('coec_description').value.trim();
                    const clientId = document.getElementById('coec_client_id').value;
                    const startDate = document.getElementById('coec_start_date').value;
                    const endDate = document.getElementById('coec_end_date').value;
                    
                    console.log('Step 1 validation values:', { name, description, clientId, startDate, endDate });
                    
                    if (!name) {
                        showAlert('Please enter a COE name', 'error');
                        return false;
                    }
                    if (!description) {
                        showAlert('Please enter a description', 'error');
                        return false;
                    }
                    if (!clientId) {
                        showAlert('Please select a client', 'error');
                        return false;
                    }
                    if (!startDate) {
                        showAlert('Please select a start date', 'error');
                        return false;
                    }
                    if (!endDate) {
                        showAlert('Please select an end date', 'error');
                        return false;
                    }
                    if (new Date(startDate) >= new Date(endDate)) {
                        showAlert('End date must be after start date', 'error');
                        return false;
                    }
                    break;
                    
                case 2:
                    if (coecSelectedEvents.length === 0) {
                        showAlert('Please select at least one event', 'error');
                        return false;
                    }
                    break;
                    
                case 3:
                    if (coecSelectedSeats.length === 0) {
                        showAlert('Please select at least one table for the events', 'error');
                        return false;
                    }
                    // Check if each selected event has at least one table selected
                    const eventsWithoutTables = coecSelectedEvents.filter(event => 
                        !coecSelectedSeats.some(seat => seat.event_id === event._id)
                    );
                    if (eventsWithoutTables.length > 0) {
                        const eventNames = eventsWithoutTables.map(e => e.name).join(', ');
                        showAlert(`Please select tables for: ${eventNames}`, 'error');
                        return false;
                    }
                    break;
                    
                case 4:
                    const runnerType = document.getElementById('coec_runner_type').value;
                    if (runnerType === 'coe') {
                        const coeRunnerId = document.getElementById('coec_coe_runner_id').value;
                        if (!coeRunnerId) {
                            showAlert('Please select a runner for the COE', 'error');
                            return false;
                        }
                    }
                    break;
            }
            return true;
        }

        /**
         * Load events for COE selection
         */
        async function loadEventsForCOE() {
            try {
                // Get COE date range for filtering
                const coeStartDate = document.getElementById('coec_start_date').value;
                const coeEndDate = document.getElementById('coec_end_date').value;
                
                // Build API URL with date filtering and only active events
                const params = new URLSearchParams();
                if (coeStartDate && coeEndDate) {
                    params.set('coe_start_date', coeStartDate);
                    params.set('coe_end_date', coeEndDate);
                }
                params.set('status', 'active');
                
                // Fetch all pages (server defaults to limit=20)
                let page = 1;
                const limit = 100; // reasonable page size
                let pages = 1;
                const combined = [];
                
                do {
                    params.set('page', String(page));
                    params.set('limit', String(limit));
                    const apiUrl = `/events?${params.toString()}`;
                    const result = await makeApiRequest(apiUrl);
                    if (!result.success || !result.data) break;
                    const batch = Array.isArray(result.data) ? result.data : (result.data.data || []);
                    combined.push(...batch);
                    const pagination = result.pagination || result.data?.pagination || {};
                    pages = parseInt(pagination.pages || '1');
                    page += 1;
                } while (page <= pages);

                if (combined.length > 0) {
                    allEventsForCOE = combined;
                    
                    // Populate location filter
                    const locationFilter = document.getElementById('coec_event_location_filter');
                    const uniqueLocations = [...new Set(allEventsForCOE.map(event => event.location_id?._id).filter(Boolean))];
                    const locationMap = {};
                    allEventsForCOE.forEach(event => {
                        if (event.location_id) {
                            locationMap[event.location_id._id] = event.location_id.name;
                        }
                    });
                    
                    locationFilter.innerHTML = '<option value="">All Locations</option>' +
                        uniqueLocations.map(locId => `<option value="${locId}">${locationMap[locId]}</option>`).join('');
                }
            } catch (error) {
                console.error('Error loading events for COE:', error);
                showAlert('Error loading events: ' + error.message, 'error');
            }
        }

        /**
         * Filter events for COE selection
         */
        function filterCOEEvents() {
            const locationFilter = document.getElementById('coec_event_location_filter').value;
            const statusFilter = document.getElementById('coec_event_status_filter').value;
            const searchInput = document.getElementById('coec_event_search').value.toLowerCase();

            let filteredEvents = allEventsForCOE.filter(event => {
                const matchesLocation = !locationFilter || event.location_id?._id === locationFilter;
                const matchesStatus = !statusFilter || event.status === statusFilter;
                const matchesSearch = !searchInput || 
                    event.name.toLowerCase().includes(searchInput) ||
                    event.description?.toLowerCase().includes(searchInput) ||
                    event.location_id?.name?.toLowerCase().includes(searchInput);

                return matchesLocation && matchesStatus && matchesSearch;
            });

            populateCOEEventsGrid(filteredEvents);
        }

        /**
         * Populate events grid for COE selection
         */
        function populateCOEEventsGrid(events = allEventsForCOE) {
            const eventsGrid = document.getElementById('coec_events_grid');
            
            // Get COE date range for display
            const coeStartDate = document.getElementById('coec_start_date').value;
            const coeEndDate = document.getElementById('coec_end_date').value;
            
            if (events.length === 0) {
                let emptyMessage = 'No events found';
                let startDate = '';
                let endDate = '';
                
                if (coeStartDate && coeEndDate) {
                    startDate = new Date(coeStartDate).toLocaleDateString();
                    endDate = new Date(coeEndDate).toLocaleDateString();
                    emptyMessage = `No events available between ${startDate} and ${endDate}. Please adjust your COE dates to see available events.`;
                }
                
                eventsGrid.innerHTML = `
                    <div style="text-align: center; padding: 40px 20px; color: #7f8c8d;">
                        <div style="font-size: 16px; margin-bottom: 10px;">${emptyMessage}</div>
                        ${coeStartDate && coeEndDate ? `
                            <div style="font-size: 14px; margin-top: 15px;">
                                <strong>Current COE Date Range:</strong> ${startDate} - ${endDate}
                            </div>
                            <div style="font-size: 12px; margin-top: 10px; color: #95a5a6;">
                                Tip: Try adjusting your COE start or end date to include more events
                            </div>
                        ` : ''}
                    </div>
                `;
                return;
            }
            
            eventsGrid.innerHTML = events.map(event => {
                const startDate = new Date(event.start_datetime).toLocaleDateString();
                const startTime = new Date(event.start_datetime).toLocaleTimeString();
                const locationName = event.location_id?.name || 'Unknown Location';
                const isSelected = coecSelectedEvents.some(selected => selected._id === event._id);
                
                // Get first media item for thumbnail
                const firstMedia = event.media && event.media.length > 0 ? event.media[0] : null;
                const mediaHtml = firstMedia ? `
                    <div style="margin-bottom:10px;position:relative;">
                        ${firstMedia.type === 'image' ? 
                            `<img src="${firstMedia.url}" alt="${firstMedia.caption || event.name}" 
                                 style="width:100%;height:120px;object-fit:cover;border-radius:6px;cursor:pointer;"
                                 onclick="event.stopPropagation(); openMediaModal('${firstMedia.url}', 'image')">` :
                            `<div style="width:100%;height:120px;background:#f8f9fa;border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;"
                                 onclick="event.stopPropagation(); openMediaModal('${firstMedia.url}', 'video')">
                                <div style="width:40px;height:40px;background:rgba(0,0,0,0.7);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <div style="width:0;height:0;border-left:12px solid white;border-top:8px solid transparent;border-bottom:8px solid transparent;margin-left:3px;"></div>
                                </div>
                            </div>`
                        }
                        ${event.media && event.media.length > 1 ? 
                            `<div style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.7);color:white;padding:2px 6px;border-radius:10px;font-size:0.7em;">+${event.media.length - 1}</div>` : ''
                        }
                    </div>
                ` : '';
                
                return `
                    <div class="event-card ${isSelected ? 'selected' : ''}" onclick="toggleCOEEventSelection('${event._id}')" style="
                        border: 2px solid ${isSelected ? '#3498db' : '#ecf0f1'};
                        border-radius: 8px;
                        padding: 15px;
                        cursor: pointer;
                        background: ${isSelected ? '#f8f9fa' : 'white'};
                        transition: all 0.2s ease;
                        position: relative;
                    ">
                        ${mediaHtml}
                        <h4 style="margin:0 0 10px 0;color:#2c3e50;">${event.name}</h4>
                        <p style="margin:0 0 10px 0;color:#7f8c8d;font-size:0.9em;">${event.description || 'No description'}</p>
                        <div style="font-size:0.85em;color:#666;">
                            <div><strong>Location:</strong> ${locationName}</div>
                            <div><strong>Date:</strong> ${startDate}</div>
                            <div><strong>Time:</strong> ${startTime}</div>
                            <div><strong>Price:</strong> $${event.base_price || 0}</div>
                            <div><strong>Status:</strong> ${event.status}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        /**
         * Toggle event selection for COE
         */
        function toggleCOEEventSelection(eventId) {
            const event = allEventsForCOE.find(e => e._id === eventId);
            if (!event) return;

            const existingIndex = coecSelectedEvents.findIndex(e => e._id === eventId);
            
            if (existingIndex >= 0) {
                // Remove from selection
                coecSelectedEvents.splice(existingIndex, 1);
            } else {
                // Add to selection
                coecSelectedEvents.push(event);
            }

            // Update displays
            populateCOEEventsGrid();
            updateCOESelectedEvents();
            
            // Update validation status
            if (coecCurrentStep === 2) {
                setTimeout(() => updateCOECValidationStatus(), 100);
            }
        }

        /**
         * Update selected events display
         */
        function updateCOESelectedEvents() {
            const selectedEventsContainer = document.getElementById('coec_selected_events');
            
            if (coecSelectedEvents.length === 0) {
                selectedEventsContainer.innerHTML = '<p style="color:#7f8c8d;text-align:center;margin:20px 0;">No events selected</p>';
                return;
            }

            selectedEventsContainer.innerHTML = coecSelectedEvents.map((event, index) => {
                const startDate = new Date(event.start_datetime).toLocaleDateString();
                const locationName = event.location_id?.name || 'Unknown Location';
                
                return `
                    <div style="
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 10px;
                        border: 1px solid #ecf0f1;
                        border-radius: 6px;
                        margin-bottom: 10px;
                        background: #f8f9fa;
                    ">
                        <div>
                            <strong>${index + 1}. ${event.name}</strong><br>
                            <small style="color:#666;">${locationName} - ${startDate}</small>
                        </div>
                        <button onclick="removeCOEEvent('${event._id}')" style="
                            background: #e74c3c;
                            color: white;
                            border: none;
                            border-radius: 4px;
                            padding: 5px 10px;
                            cursor: pointer;
                            font-size: 0.8em;
                        ">Remove</button>
                    </div>
                `;
            }).join('');
