         */
        function handleEditProfile(userId) {
            // Only allow editing own profile (all users: clients, runners, admins)
            // Handle both _id and id formats for currentUser
            const currentUserId = currentUser?._id?.toString() || currentUser?.id?.toString();
            const isOwnProfile = userId && currentUserId && userId === currentUserId;
            
            if (!isOwnProfile) {
                showAlert('You can only edit your own profile.', 'error');
                return;
            }
            
            // Call existing editProfile function
            if (typeof editProfile === 'function') {
                editProfile();
            } else {
                // Fallback: show profile modal
                if (document.getElementById('profileModal')) {
                    // Populate modal with profile data
                    const profileModal = document.getElementById('profileModal');
                    profileModal.style.display = 'block';
                } else {
                    showAlert('Edit profile functionality will be available soon.', 'info');
                }
            }
        }
        
        /**
         * Render seat upgrade offers card
         * @param {Object} offersData - Upgrade offers data
         * @returns {HTMLElement} Upgrade offers card element
         */
        function renderSeatUpgradeOffers(offersData) {
            const container = document.createElement('div');
            container.className = 'bot-structured-card bot-upgrade-offers';
            
            const offers = offersData.offers || [];
            const budgetSummary = offersData.budget_summary || null;
            
            if (offers.length === 0) {
                container.innerHTML = '<div class="bot-upgrade-empty">No upgrade offers available.</div>';
                return container;
            }
            
            let html = `
                <div class="upgrade-offers-header">
                    <h3>Premium Seating Upgrades Available</h3>
                    <p>${offersData.message || 'We found some premium seating options that might interest you!'}</p>
                </div>
            `;
            
            // Add budget utilization bar if budget info available
            if (budgetSummary && budgetSummary.total_budget) {
                const utilization = budgetSummary.utilization_percentage || 0;
                html += `
                    <div class="budget-utilization-section">
                        <div class="budget-utilization-bar">
                            <div class="budget-fill" style="width: ${Math.min(utilization, 100)}%"></div>
                        </div>
                        <div class="budget-utilization-text">
                            $${(budgetSummary.coe_total || 0).toLocaleString()} / $${budgetSummary.total_budget.toLocaleString()} 
                            <span class="utilization-pct">(${utilization}% utilized)</span>
                            ${budgetSummary.remaining > 0 ? `<span class="remaining">$${budgetSummary.remaining.toLocaleString()} remaining</span>` : ''}
                        </div>
                    </div>
                `;
            }
            
            offers.forEach((offer, offerIndex) => {
                // Check if user is admin - admins see all seats, clients only see upgrades
                const isAdmin = currentUser && currentUser.role === 'admin';
                
                // Filter alternatives based on user role
                const currentPrice = Number(offer.current_price) || 0;
                const upgradeAlternatives = (offer.alternatives || []).filter(alt => {
                    const altPrice = Number(alt.event_price || alt.price || 0);
                    
                    // For admins: show all alternatives (no price filter)
                    // For clients: only show more expensive options (strictly greater)
                    if (isAdmin) {
                        console.log('[UPGRADE FILTER] Admin - showing all alternatives:', {
                            currentSeat: offer.current_seat_code,
                            currentPrice: currentPrice,
                            altSeat: alt.seat_code,
                            altPrice: altPrice
                        });
                        return true; // Admin sees all seats
                    } else {
                        const isUpgrade = altPrice > currentPrice;
                        console.log('[UPGRADE FILTER] Client - filtering by price:', {
                            currentSeat: offer.current_seat_code,
                            currentPrice: currentPrice,
                            altSeat: alt.seat_code,
                            altPrice: altPrice,
                            isUpgrade: isUpgrade
                        });
                        return isUpgrade; // Client only sees more expensive seats
                    }
                });
                
                // For clients: skip if no upgrades found
                // For admins: show even if empty (might have current seat marked)
                if (!isAdmin && upgradeAlternatives.length === 0) {
                    return; // Skip this offer if no actual upgrades (client only)
                }
                
                // Generate upgrade seat items for carousel
                const upgradeSeatItems = upgradeAlternatives.map((alt, altIndex) => `
                    <div class="coe-seat-carousel-slide" data-upgrade-index="${altIndex}">
                        <div class="upgrade-seat ${alt.fits_budget ? 'within-budget' : 'premium-upgrade'}">
                            <div class="seat-label">Upgrade Option</div>
                            <span class="upgrade-tag ${alt.fits_budget ? 'tag-within-budget' : 'tag-premium'}">${alt.tag || (alt.fits_budget ? 'Within Budget' : 'Premium Upgrade')}</span>
                            <div class="seat-code">${alt.seat_code || 'N/A'}</div>
                            <div class="seat-price">$${(alt.event_price || alt.price || 0).toLocaleString()}</div>
                            <div class="price-delta ${(alt.price_delta || 0) > 0 ? 'positive' : ''}">
                                ${(alt.price_delta || 0) > 0 ? '+' : ''}$${(alt.price_delta || 0).toLocaleString()}
                                ${alt.price_delta_percentage ? `(${alt.price_delta_percentage}%)` : ''}
                            </div>
                            
                            ${alt.upgrade_reasons && alt.upgrade_reasons.length > 0 ? `
                                <div class="upgrade-reasons">
                                    ${alt.upgrade_reasons.map(reason => `
                                        <span class="upgrade-reason-badge">${reason}</span>
                                    `).join('')}
                                </div>
                            ` : ''}
                            
                            ${alt.sentiment && alt.sentiment.length > 0 ? `
                                <div class="upgrade-sentiment">
                                    ${alt.sentiment.map(sent => `
                                        <span class="sentiment-badge type-${sent.type ? sent.type.toLowerCase() : 'b'}">
                                            ${sent.text || `Type ${sent.type || 'B'}`}
                                        </span>
                                    `).join('')}
                                </div>
                            ` : ''}
                            
                            <button 
                                class="btn-upgrade" 
                                onclick="handleAcceptUpgrade('${offersData.coe_id}', '${offer.current_seat_id}', '${alt.seat_id}', '${offer.event_id}')"
                            >
                                Upgrade
                            </button>
                        </div>
                    </div>
                `);
                
                // Build carousel HTML for upgrade options - ALWAYS use carousel structure
                const upgradeCarouselHtml = `
                    <div class="coe-seat-carousel-container" data-upgrade-offer-index="${offerIndex}">
                        <div class="coe-seat-carousel-wrapper">
                            <div class="coe-seat-carousel-track">
                                ${upgradeSeatItems.join('')}
                            </div>
                        </div>
                        ${upgradeSeatItems.length > 1 ? `
                        <div class="coe-seat-carousel-controls">
                            <button class="coe-seat-carousel-btn coe-seat-carousel-prev" onclick="slideSeatCarousel(this, -1)" aria-label="Previous upgrade">
                                ‹
                            </button>
                            <div class="coe-seat-carousel-indicators">
                                ${upgradeAlternatives.map((_, idx) => `
                                    <button class="coe-seat-carousel-dot ${idx === 0 ? 'active' : ''}" 
                                            onclick="goToSeatSlide(this, ${idx})" 
                                            aria-label="Go to upgrade ${idx + 1}"></button>
                                `).join('')}
                            </div>
                            <button class="coe-seat-carousel-btn coe-seat-carousel-next" onclick="slideSeatCarousel(this, 1)" aria-label="Next upgrade">
                                ›
                            </button>
                        </div>
                        ` : ''}
                    </div>
                `;
                
                html += `
                    <div class="upgrade-offer-card">
                        <div class="upgrade-offer-event">
                            <strong>${offer.event_name || 'Event'}</strong>
                        </div>
                        
                        <div class="upgrade-offer-comparison">
                            <div class="current-seat">
                                <div class="seat-label">Current Seat</div>
                                <div class="seat-code">${offer.current_seat_code || 'N/A'}</div>
                                <div class="seat-price">$${(offer.current_price || 0).toLocaleString()}</div>
                            </div>
                            
                            <div class="upgrade-arrow">→</div>
                            
                            ${upgradeCarouselHtml}
                        </div>
                        
                        <button 
                            class="btn-keep-current" 
                            onclick="handleRejectUpgrade('${offersData.coe_id}', '${offer.current_seat_id}', this)"
                        >
                            Keep Current Seat
                        </button>
                    </div>
                `;
            });
            
            container.innerHTML = html;
            
            // Initialize carousel touch support for all upgrade carousels
            container.querySelectorAll('.coe-seat-carousel-container').forEach(carousel => {
                // Initialize current index to 0
                carousel.dataset.currentIndex = '0';
                const track = carousel.querySelector('.coe-seat-carousel-track');
                const slides = carousel.querySelectorAll('.coe-seat-carousel-slide');
                const wrapper = carousel.querySelector('.coe-seat-carousel-wrapper');
                
                // Ensure first slide is visible by setting initial transform
                if (track && slides.length > 0) {
                    track.style.transform = 'translateX(0%)';
                    track.style.display = 'flex';
                    track.style.visibility = 'visible';
                    track.style.opacity = '1';
                }
                
                if (wrapper) {
                    wrapper.style.visibility = 'visible';
                    wrapper.style.opacity = '1';
                }
                
                initSeatCarouselTouch(carousel);
                
                // Initialize button states
                const prevBtn = carousel.querySelector('.coe-seat-carousel-prev');
                const nextBtn = carousel.querySelector('.coe-seat-carousel-next');
                if (slides.length > 0) {
                    if (prevBtn) prevBtn.disabled = true; // First slide
                    if (nextBtn) nextBtn.disabled = slides.length === 1;
                }
            });
            
            return container;
        }
        
        /**
         * Handle accepting a seat upgrade
         * @param {string} coeId - COE ID
         * @param {string} currentSeatId - Current seat ID
         * @param {string} upgradeSeatId - Upgrade seat ID
         * @param {string} eventId - Event ID
         */
        async function handleAcceptUpgrade(coeId, currentSeatId, upgradeSeatId, eventId) {
            try {
                showAlert('Processing upgrade...', 'info');
                console.log('Upgrade requested:', { coeId, currentSeatId, upgradeSeatId, eventId });
                
                const result = await makeApiRequest(`/coes/${coeId}/seat-upgrades/accept`, 'POST', {
                    current_seat_id: currentSeatId,
                    alternative_seat_id: upgradeSeatId,
                    event_id: eventId
                });
                
                if (result.success) {
                    showAlert('Seat upgraded successfully! Your COE has been updated.', 'success');
                    
                    // Hide the upgrade offer card that was just accepted
                    const upgradeCards = document.querySelectorAll('.upgrade-offer-card');
                    upgradeCards.forEach(card => {
                        const btn = card.querySelector(`[onclick*="${currentSeatId}"][onclick*="${upgradeSeatId}"]`);
                        if (btn) {
                            card.style.opacity = '0.5';
                            card.innerHTML = '<div class="upgrade-accepted">Upgrade accepted! Your seat has been changed.</div>';
                        }
                    });
                } else {
                    showAlert(result.message || 'Failed to upgrade seat', 'error');
                }
            } catch (error) {
                console.error('Error accepting upgrade:', error);
                showAlert('Failed to accept upgrade: ' + (error.message || 'Unknown error'), 'error');
            }
        }
        
        /**
         * Handle rejecting a seat upgrade
         * @param {string} coeId - COE ID
         * @param {string} seatId - Seat ID
         */
        async function handleRejectUpgrade(coeId, seatId, buttonElement) {
            try {
                // For now, just hide the offer (could mark as rejected via API later)
                const offerCard = buttonElement?.closest('.upgrade-offer-card');
                if (offerCard) {
                    offerCard.style.opacity = '0.5';
                    offerCard.style.pointerEvents = 'none';
                }
                showAlert('Upgrade offer declined - keeping current seat', 'info');
            } catch (error) {
                console.error('Error rejecting upgrade:', error);
            }
        }

        /**
         * Handle removing an event from a draft COE
         * @param {string} coeId - COE ID
         * @param {string} eventId - Event ID to remove
         */
        // Make function globally accessible
        window.handleRemoveEvent = async function handleRemoveEvent(coeId, eventId) {
            try {
                // Show confirmation modal
                const confirmed = await showConfirmModal(
                    'Remove Event',
                    'Are you sure you want to remove this event? All associated seats will be removed.',
                    'Remove',
                    'Cancel'
                );

                if (!confirmed) {
                    return;
                }

                showAlert('Removing event...', 'info');

                const result = await makeApiRequest(`/coes/${coeId}/events`, 'DELETE', {
                    event_ids: [eventId]
                });

                if (result.success) {
                    showAlert('Event removed successfully! Refreshing...', 'success');
                    // Refresh bot messages to show updated COE
                    setTimeout(() => {
                        loadBotHistory();
                    }, 1000);
                } else {
                    showAlert(result.error || 'Failed to remove event', 'error');
                }
            } catch (error) {
                console.error('Error removing event:', error);
                showAlert('Failed to remove event: ' + (error.message || 'Unknown error'), 'error');
            }
        }

        /**
         * Handle replacing an event in a draft COE
         * @param {string} coeId - COE ID
         * @param {string} eventId - Event ID to replace
         */
        // Make function globally accessible
        window.handleReplaceEvent = async function handleReplaceEvent(coeId, eventId, cityFilter = null) {
            try {
                console.log('[handleReplaceEvent] Starting replace event:', { coeId, eventId, cityFilter });
                showAlert('Loading alternative events...', 'info');

                // Build API URL with optional city filter
                let apiUrl = `/coes/${coeId}/events/${eventId}/alternatives`;
                if (cityFilter) {
                    apiUrl += `?city=${encodeURIComponent(cityFilter)}`;
                }
                
                // Fetch alternative events
                console.log('[handleReplaceEvent] Fetching alternatives from:', apiUrl);
                const alternativesResult = await makeApiRequest(apiUrl, 'GET');
                
                console.log('[handleReplaceEvent] Alternatives result:', {
                    success: alternativesResult.success,
                    hasData: !!alternativesResult.data,
                    dataLength: alternativesResult.data?.length || 0,
                    error: alternativesResult.error,
                    fullResult: alternativesResult
                });

                if (!alternativesResult.success) {
                    const errorMsg = alternativesResult.error || 'Failed to fetch alternative events';
                    console.error('[handleReplaceEvent] Failed to fetch alternatives:', errorMsg);
                    showAlert(errorMsg, 'error');
                    return;
                }

                // Extract the actual events array from the response
                // makeApiRequest returns { success, data: <api response> }
                // API returns { success: true, data: alternatives }
                // So we need alternativesResult.data.data
                let eventsArray = alternativesResult.data;
                
                // If data is the API response object, extract the actual data
                if (eventsArray && typeof eventsArray === 'object' && eventsArray.data) {
                    eventsArray = eventsArray.data;
                }
                
                // Ensure it's an array
                if (!Array.isArray(eventsArray)) {
                    console.error('[handleReplaceEvent] Data is not an array:', {
                        originalData: alternativesResult.data,
                        extractedData: eventsArray,
                        dataType: typeof eventsArray,
                        isArray: Array.isArray(eventsArray),
                        keys: eventsArray ? Object.keys(eventsArray) : null
                    });
                    showAlert('Invalid response format from server. Expected an array of events.', 'error');
                    return;
                }

                if (!eventsArray || eventsArray.length === 0) {
                    console.warn('[handleReplaceEvent] No alternative events found');
                    showAlert('No alternative events found for replacement', 'error');
                    return;
                }

                console.log('[handleReplaceEvent] Showing event selection modal with', eventsArray.length, 'events');
                
                // If no events found and we have a city filter, retry without city filter
                if (eventsArray.length === 0 && cityFilter) {
                    console.log('[handleReplaceEvent] No events found with city filter, retrying without city filter');
                    const retryResult = await makeApiRequest(`/coes/${coeId}/events/${eventId}/alternatives`, 'GET');
                    if (retryResult.success && retryResult.data) {
                        let retryEvents = retryResult.data.data || retryResult.data;
                        if (Array.isArray(retryEvents) && retryEvents.length > 0) {
                            eventsArray = retryEvents;
                            console.log('[handleReplaceEvent] Found', eventsArray.length, 'events without city filter');
                        }
                    }
                }
                
                // Show event selection modal with city filter option
                const selectedEvent = await showEventSelectionModal(
                    'Replace Event',
                    'Select an alternative event to replace the current one:',
                    eventsArray,
                    coeId,
                    eventId,
                    cityFilter
                );

                console.log('[handleReplaceEvent] Selected event:', selectedEvent);

                if (!selectedEvent) {
                    console.log('[handleReplaceEvent] No event selected, user cancelled');
                    return;
                }

                showAlert('Replacing event...', 'info');

                console.log('[handleReplaceEvent] Replacing event:', {
                    coeId,
                    oldEventId: eventId,
                    newEventId: selectedEvent._id
                });

                // Replace the event (without preserving seats for now - user can select manually)
                const result = await makeApiRequest(`/coes/${coeId}/events/${eventId}`, 'PUT', {
                    new_event_id: selectedEvent._id,
                    preserve_seats: false
                });

                console.log('[handleReplaceEvent] Replace result:', {
                    success: result.success,
                    error: result.error,
                    data: result.data
                });

                if (result.success) {
                    showAlert('Event replaced successfully! Refreshing...', 'success');
                    // Refresh bot messages to show updated COE
                    setTimeout(() => {
                        loadBotHistory();
                    }, 1000);
                } else {
                    const errorMsg = result.error || 'Failed to replace event';
                    console.error('[handleReplaceEvent] Replace failed:', errorMsg);
                    showAlert(errorMsg, 'error');
                }
            } catch (error) {
                console.error('[handleReplaceEvent] Exception:', error);
                showAlert('Failed to replace event: ' + (error.message || 'Unknown error'), 'error');
            }
        }

        /**
         * Show confirmation modal
         * @param {string} title - Modal title
         * @param {string} message - Confirmation message
         * @param {string} confirmText - Confirm button text
         * @param {string} cancelText - Cancel button text
         * @returns {Promise<boolean>} True if confirmed, false if cancelled
         */
        function showConfirmModal(title, message, confirmText = 'Confirm', cancelText = 'Cancel') {
            return new Promise((resolve) => {
                const modal = document.createElement('div');
                modal.className = 'coe-modal-overlay';
                modal.style.cssText = 'position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 10000; display: flex; align-items: center; justify-content: center;';
                
                modal.innerHTML = `
                    <div class="coe-modal" style="background: #1e293b; border-radius: 8px; padding: 2rem; max-width: 500px; width: 90%; border: 1px solid rgba(255,255,255,0.1);">
                        <h3 style="color: #fff; margin: 0 0 1rem 0; font-size: 1.2rem;">${title}</h3>
                        <p style="color: #cbd5f5; margin: 0 0 1.5rem 0; line-height: 1.6;">${message}</p>
                        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                            <button class="coe-modal-cancel" style="background: rgba(100, 116, 139, 0.3); color: #cbd5f5; border: 1px solid rgba(100, 116, 139, 0.5); padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer;">
                                ${cancelText}
                            </button>
                            <button class="coe-modal-confirm" style="background: rgba(239, 68, 68, 0.3); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.5); padding: 0.5rem 1.5rem; border-radius: 4px; cursor: pointer;">
                                ${confirmText}
                            </button>
                        </div>
                    </div>
                `;

                const confirmBtn = modal.querySelector('.coe-modal-confirm');
                const cancelBtn = modal.querySelector('.coe-modal-cancel');

                confirmBtn.onclick = () => {
                    document.body.removeChild(modal);
                    resolve(true);
                };

                cancelBtn.onclick = () => {
                    document.body.removeChild(modal);
                    resolve(false);
                };

                modal.onclick = (e) => {
                    if (e.target === modal) {
                        document.body.removeChild(modal);
                        resolve(false);
                    }
                };

                document.body.appendChild(modal);
            });
        }

        /**
         * Show event selection modal
         * @param {string} title - Modal title
         * @param {string} message - Modal message
         * @param {Array} events - Array of alternative events
         * @param {string} coeId - COE ID for reloading with city filter
         * @param {string} eventId - Event ID for reloading with city filter
         * @param {string} currentCityFilter - Current city filter (if any)
         * @returns {Promise<Object|null>} Selected event or null if cancelled
         */
        function showEventSelectionModal(title, message, events, coeId = null, eventId = null, currentCityFilter = null) {
            return new Promise((resolve) => {
                // Ensure events is an array
                if (!Array.isArray(events)) {
                    console.error('[showEventSelectionModal] Events is not an array:', {
                        events,
                        type: typeof events,
                        isArray: Array.isArray(events)
                    });
                    alert('Error: Invalid events data format');
                    resolve(null);
                    return;
                }
                
                console.log('[showEventSelectionModal] Creating modal with', events.length, 'events');
                console.log('[showEventSelectionModal] Events data:', events);
                
                const modal = document.createElement('div');
                modal.className = 'coe-modal-overlay';
                modal.style.cssText = 'position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 10000; display: flex; align-items: center; justify-content: center; overflow-y: auto; padding: 2rem;';

                // City filter dropdown (only if coeId and eventId are provided for reloading)
                let cityFilterHtml = '';
