        function closeLightbox() {
            document.getElementById('mediaLightbox').style.display = 'none';
        }

        /**
         * Delete location with confirmation
         */
        async function deleteLocation(locationId, locationName) {
            // Check if user is admin
            if (currentUser?.role !== 'admin') {
                showAlert('Only administrators can delete locations', 'error');
                return;
            }

            // Show confirmation dialog
            const confirmed = confirm(`Are you sure you want to delete the location "${locationName}"?\n\nThis action cannot be undone.`);
            if (!confirmed) {
                return;
            }

            try {
                const result = await makeApiRequest(`/locations/${locationId}`, 'DELETE');
                if (result.success) {
                    showAlert('Location deleted successfully', 'success');
                    loadLocations(); // Refresh the locations table
                } else {
                    showAlert('Failed to delete location: ' + (result.error?.message || 'Unknown error'), 'error');
                }
            } catch (error) {
                console.error('Delete location error:', error);
                showAlert('Error deleting location: ' + error.message, 'error');
            }
        }

