        /**
         * Logout user
         */
        async function logout() {
            if (currentToken) {
                try {
                    await makeApiRequest('/auth/logout', 'POST');
                } catch (error) {
                    console.error('Logout error:', error);
                }
            }
            
            // Clear session data
            currentToken = null;
            currentUser = null;
            
            // Redirect to login
