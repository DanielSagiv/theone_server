# Scrap Events Import — remote Stage/Prod API bases (local scrape → remote commit)
# SCRAP_IMPORT_STAGE_API_BASE=https://stage.the1.vip/v1
# SCRAP_IMPORT_PROD_API_BASE=https://app.the1.vip/v1

# SCRAP_EVENTS_IMPORT_WIZARD=true  # re-enable 4-step Create Event modal + draft imports (default: auto-create active)
# Local Mac: PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Local Linux: PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
