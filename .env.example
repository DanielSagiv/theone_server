# Environment Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb+srv://sagiv:madonna@cluster0.et5fx.mongodb.net/kairo?retryWrites=true&w=majority
# One-off scripts (e.g. scripts/copy-stage-locations-events-to-prod.js) — full URI including DB name:
# STAGE_MONGODB_URI=mongodb+srv://USER:PASS@cluster/DB_STAGE?retryWrites=true&w=majority
# PROD_MONGODB_URI=mongodb+srv://USER:PASS@cluster/DB_PROD?retryWrites=true&w=majority
# Prod S3 for scripts/backfill-prod-list-thumbs-safe.js (or use S3_BUCKET / S3_AKI / S3_SEC):
# PROD_S3_BUCKET=
# PROD_S3_AKI=
# PROD_S3_SEC=
# PROD_AWS_REGION=us-west-2

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Password Hashing
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_TIMEOUT=86400000

# AWS Configuration
AWS_REGION=us-west-2
S3_BUCKET=your-s3-bucket-name
# AWS SES (required for transactional email, including payment receipts)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FROM_EMAIL=noreply@the1.vip

# Optional: full URL for the welcome email "Go to Dashboard" CTA. If unset, falls back to FRONTEND_URL + /test/dashboard, then https://the1.vip
# WELCOME_DASHBOARD_URL=https://app.example.com/dashboard

# Web app origin (no trailing slash). Used for COE invitation links and welcome email fallback.
# FRONTEND_URL=https://app.example.com

# Public API origin for links in emails (no trailing slash). Used in payment receipt emails:
# PDF: {API_PUBLIC_URL}/v1/payments/:paymentId/invoice.pdf
# BACKEND_URL=  # optional fallback if API_PUBLIC_URL is unset
# API_PUBLIC_URL=https://api.example.com

# Post-charge receipt email via SES after successful charge. Adhoc/on-spot: PDF invoice emailed to adhoc_payer.
# BCC copy of every invoice/receipt email goes to accounting (default accounting@the1.vip).
# SEND_PAYMENT_RECEIPT_EMAIL=false
# ACCOUNTING_EMAIL=accounting@the1.vip

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Website2 password protection (optional). Set to 'true' to require password before viewing website2.
# When unset or not 'true', website2 is publicly accessible. Re-enable by setting: ENABLE_WEBSITE2_PASSWORD_PROTECTION=true
# ENABLE_WEBSITE2_PASSWORD_PROTECTION=true

# COE seat/table pricing: tax rate applied to subtotal (default 0.3 = 30%). Used for totals, holds, and revision/repropose.
# COE_TAX_RATE=0.3

# Admin joint / shared-table flow from mobile (Search Events). Default off.
# ENABLE_JOINT_EVENT_ADMIN=true

# Client signup approval. Default (unset or true): pendingApproval + admin notification.
# Set to false to auto-approve clients at signup (skip Manage new clients Approve).
# Client self-signup always creates users as pendingApproval (admin must approve).
# VERIFY_USER is legacy and no longer auto-approves self-signup.
# VERIFY_USER=true
# VERIFY_USER=false

# GOAT Payment Gateway (sandbox vs production)
# Prefer GOAT_BASE_URL for a single host; or set GOAT_SANDBOX_BASE_URL / GOAT_PRODUCTION_BASE_URL by environment.
# GOAT_BASE_URL=https://api.sandbox.goatpaymentsgateway.com
# GOAT_SANDBOX_BASE_URL=https://api.sandbox.goatpaymentsgateway.com
# GOAT_PRODUCTION_BASE_URL=https://api.goatpaymentsgateway.com
# GOAT_SOURCE_KEY=
# GOAT_PIN=
# Secret returned when creating a webhook in GOAT dashboard/API (not the PIN):
# GOAT_WEBHOOK_SIGNATURE=

# Optional: App Store / Play Store URLs for admin-created client welcome email (CTAs omitted when unset).
# MOBILE_APP_IOS_URL=https://apps.apple.com/app/idXXXXXXXX
# MOBILE_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.example

# OpenAI (bot + Tools section-image AI + scrap event flyer clean). OPENAI_API_KEY required for live AI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Image edit model for Tools → Section image AI and scrap event flyer clean (use a model your project can access)
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# Scrap import: AI-clean event flyers on commit (default on when OPENAI_API_KEY is set). Set 0 to skip AI and only re-host.
# SCRAP_EVENT_FLYER_AI=1

# LIV scrap events import — THE1 location IDs (stage defaults match prod sync)
# LIV_EVENTS_LISTING_URL=https://www.livnightclub.com/las-vegas/events/
# LIV_NIGHT_LOCATION_ID=69d947ac8ae9a8c036318759
# LIV_BEACH_LOCATION_ID=69d9143e8ae9a8c036317fb7

